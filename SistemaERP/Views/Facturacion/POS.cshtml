        // Cambio de precio  solicitar clave si 0 costo
        async function handlePriceChange(input, index) {
            let newPrice = parseFloat(input.value) || 0;
            let pvf      = parseFloat($(input).data('pvf')) || 0;
            let oldPrice = cart[index].precioUnit;

            if (pvf > 0 && newPrice <= pvf) {
                // Preguntar clave maestra
                 const { value: clave, isConfirmed } = await Swal.fire({
                    title: '<i class="bi bi-shield-lock-fill text-warning me-2"></i> Autorizaci\u00F3n Requerida',
                    html: `
                        <div class="text-start">
                            <p class="text-muted mb-1">El precio <strong>${MONEDA_SIMBOLO}${newPrice.toFixed(4)}</strong> es menor o igual al costo (PVF: <strong>${MONEDA_SIMBOLO}${pvf.toFixed(4)}</strong>).</p>
                            <p class="text-muted mb-3">Ingrese la <strong>Clave Maestra</strong> para autorizar este precio:</p>
                            <input id="swalClaveMaestra" type="password" class="form-control form-control-lg text-center"
                                   placeholder="Clave maestra" autocomplete="off">
                        </div>
                    `,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Autorizar',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#4f46e5',
                    preConfirm: () => {
                        const val = document.getElementById('swalClaveMaestra').value;
                        if (!val) { Swal.showValidationMessage('Ingrese la clave maestra'); return false; }
                        return val;
                    }
                });

                if (!isConfirmed || !clave) {
                    // Restaurar precio anterior
                    input.value = oldPrice.toFixed(4);
                    $(input).removeClass('bajo-costo');
                    return;
                }

                // Validar clave contra el servidor
                Swal.fire({ title: 'Validando...', didOpen: () => Swal.showLoading(), allowOutsideClick: false });
                const res = await $.ajax({
                    url: '@Url.Action("ValidarPasswordPrecio", "Facturacion")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ clave: clave })
                });
                Swal.close();

                if (res.success) {
                    cart[index].precioUnit = newPrice;
                    cart[index].precioEditadoManual = true;
                    toastr.success('Precio autorizado correctamente');
                    renderCart();
                } else {
                    Swal.fire('Acceso Denegado', res.message, 'error');
                    input.value = oldPrice.toFixed(4);
                    $(input).removeClass('bajo-costo');
                }
            } else {
                // Precio normal \uFFFD aplicar directo
                cart[index].precioUnit = newPrice;
                cart[index].precioEditadoManual = true;
                renderCart();
            }
        }

        // \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD Totales \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD
        function updateTotals() {
            let subtotal = 0; 
            let descuento = 0;
            let sub0 = 0;
            let sub15 = 0;
            let subSinImpuesto = 0;
            let iva = 0;

            cart.forEach(x => {
                let originalPrice = x.esCaja ? x.pvpBase : (x.contiene > 1 ? x.pvpBase / x.contiene : x.pvpBase);
                let lineOriginalTotal = originalPrice * x.cantidad;
                let lineTotal = x.precioUnit * x.cantidad;
                
                // Descuento en base imponible (sin IVA) para cuadrar correctamente
                let lineOriginalSubtotal = lineOriginalTotal / (1 + x.ivaRate);
                let lineSubtotal = lineTotal / (1 + x.ivaRate);
                let lineIva = lineTotal - lineSubtotal;
                
                descuento += (lineOriginalSubtotal - lineSubtotal);

                if (x.ivaRate > 0) {
                    sub15 += lineSubtotal;
                    iva += lineIva;
                } else {
                    sub0 += lineSubtotal;
                }
                subSinImpuesto += lineSubtotal;
            });

            // En el esquema de facturación ecuatoriana (SRI):
            // Subtotal = Suma de bases imponibles (Sub 0% + Sub 15%)
            let totalFactura = subSinImpuesto + iva;

            $('#lblSubtotalStandard, #lblSubtotalColumnar').text(subSinImpuesto.toFixed(2));
            $('#lblDescuentoStandard, #lblDescuentoColumnar').text(descuento.toFixed(2));
            $('#lblSub0Standard, #lblSub0Columnar').text(sub0.toFixed(2));
            $('#lblSub15Standard, #lblSub15Columnar').text(sub15.toFixed(2));
            $('#lblSubSinImpuestoStandard, #lblSubSinImpuestoColumnar').text(subSinImpuesto.toFixed(2));
            $('#lblIvaStandard, #lblIvaColumnar').text(iva.toFixed(2));
            $('#lblTotalStandard, #lblTotalColumnar').text(totalFactura.toFixed(2));
        }

        function updateQty(i, v) {
            let item = cart[i];
            if (!item) return;
            let qty = parseInt(v) || 1;
            
            let contiene = item.contiene || 1;
            let chosenBodId = item.idBodega;
            let p = productosList.find(x => x.id === item.idProducto);
            let stockDisponible = 0;
            if (p && p.stocks) {
                let stockRecord = p.stocks.find(s => s.bodegaId === chosenBodId);
                if (stockRecord) stockDisponible = stockRecord.stock;
            }
            
            let unitsInCartOthers = cart
                .filter((x, idx) => x.idProducto === item.idProducto && x.idBodega == chosenBodId && idx !== i)
                .reduce((sum, item) => sum + (item.esCaja ? item.cantidad * contiene : item.cantidad), 0);
                
            let requestedUnits = item.esCaja ? qty * contiene : qty;
            let totalNeededUnits = unitsInCartOthers + requestedUnits;
            
            if (totalNeededUnits > stockDisponible) {
                Swal.fire({
                    title: 'Stock Insuficiente',
                    html: `No hay suficiente existencia del producto <strong>${item.nombreProducto}</strong> en la bodega <strong>${item.nombreBodega}</strong>.<br><br>` +
                          `Stock disponible: <strong>${contiene > 1 ? formatCantidad(stockDisponible, contiene, false) : stockDisponible}</strong><br>` +
                          `Solicitado (Carrito + Actualizaci\u00F3n): <strong>${contiene > 1 ? formatCantidad(totalNeededUnits, contiene, false) : totalNeededUnits}</strong>`,
                    icon: 'warning',
                    confirmButtonText: 'Entendido',
                    confirmButtonColor: '#4f46e5'
                });
                renderCart();
                return;
            }
            
            cart[i].cantidad = qty;
            let name = cart[i].nombreProducto;
            toastr.success(`Cantidad de <strong>${name}</strong> actualizada a <strong>${qty}</strong>`);
            renderCart();
        }
        function removeItem(i)   { cart.splice(i, 1); renderCart(); }
        function clearCart()     { cart = []; renderCart(); }

        // \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD Finalizar Venta \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD
        let addedPayments = [];
        let paymentTotal = 0;
        let paymentRemaining = 0;

