@model SistemaERP.Models.Entities.Gasto

@{
    ViewData["Title"] = "Registrar Gasto";
}

<div class="row mb-4 animate__animated animate__fadeIn">
    <div class="col">
        <h2 class="fw-bold mb-1 text-primary"><i class="bi bi-wallet2 me-2"></i>Registrar Gasto</h2>
        <p class="text-muted">Añadir una nueva transacción de gasto al sistema.</p>
    </div>
</div>

<div class="row g-4 animate__animated animate__fadeInUp">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="premium-card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                
                <div class="mb-3">
                    <label asp-for="Fecha" class="form-label fw-bold small">Fecha</label>
                    <input asp-for="Fecha" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    <span asp-validation-for="Fecha" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CuentaContableId" class="form-label fw-bold small">Cuenta Contable (Gasto)</label>
                    <select asp-for="CuentaContableId" class="form-select" asp-items="ViewBag.CuentasGasto" required>
                        <option value="">Seleccione la cuenta de gasto...</option>
                    </select>
                    <span asp-validation-for="CuentaContableId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Monto" class="form-label fw-bold small">Monto (C$)</label>
                    <input asp-for="Monto" type="number" step="0.01" class="form-control font-monospace" placeholder="0.00" required />
                    <span asp-validation-for="Monto" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Descripcion" class="form-label fw-bold small">Descripción / Observación</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Ej. Pago de internet fibra óptica del mes" required></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-premium shadow-sm">Registrar Gasto</button>
                </div>
            </form>
        </div>
    </div>
</div>
