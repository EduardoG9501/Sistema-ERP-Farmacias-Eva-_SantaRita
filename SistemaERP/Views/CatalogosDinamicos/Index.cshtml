@model IEnumerable<Tuple<int, string>>
@{
    ViewData["Title"] = $"Catálogo de {ViewBag.LabelVisual}";
}

<div class="row mb-4 animate__animated animate__fadeIn">
    <div class="col">
        <h2 class="fw-bold mb-1">Catálogo de @ViewBag.LabelVisual</h2>
        <p class="text-muted">Administración y listado de elementos del catálogo dinámico.</p>
    </div>
    <div class="col-auto d-flex gap-2">
        <a href="@Url.Action("DescargarPlantilla", "ImportacionMasiva", new { catalogo = "dinamico", tabla = ViewBag.Tabla })" class="btn btn-outline-primary shadow-sm" title="Descargar Plantilla Excel">
            <i class="bi bi-download me-1"></i> Plantilla
        </a>
        <button type="button" class="btn btn-outline-success shadow-sm" onclick="abrirModalImportacion('dinamico', '@ViewBag.Tabla')" title="Cargar Datos desde Excel">
            <i class="bi bi-file-earmark-excel me-1"></i> Cargar Excel
        </button>
        <a asp-action="Create" asp-route-tabla="@ViewBag.Tabla" class="btn btn-premium shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Agregar Elemento
        </a>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger border-0 shadow-sm mb-4 animate__animated animate__shakeX" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
    </div>
}

<div class="premium-card animate__animated animate__fadeInUp">
    @Html.AntiForgeryToken()
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="border-0 text-xs text-uppercase py-3" style="width: 80px;">ID</th>
                    <th class="border-0 text-xs text-uppercase py-3">Nombre</th>
                    <th class="border-0 text-xs text-uppercase py-3 text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr id="row-@item.Item1">
                            <td class="text-muted fw-medium">#@item.Item1</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-blue-soft rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px;">
                                        <i class="bi bi-tag text-primary"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@item.Item2</span>
                                </div>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-tabla="@ViewBag.Tabla" asp-route-id="@item.Item1" class="btn btn-sm btn-light border-0 text-primary me-1" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-light border-0 text-danger" title="Eliminar" onclick="confirmDelete(@item.Item1, '@item.Item2')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                            No se encontraron registros en este catálogo.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted fw-medium">
        <i class="bi bi-arrow-left me-1"></i> Volver al Dashboard
    </a>
</div>

@await Html.PartialAsync("_ImportacionMasivaModal")

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: "Eliminarás el elemento '" + name + "'. Esta acción no se puede deshacer.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3b82f6',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    var form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '@Url.Action("Delete", "CatalogosDinamicos")';
                    
                    var tableInput = document.createElement('input');
                    tableInput.type = 'hidden';
                    tableInput.name = 'tabla';
                    tableInput.value = '@ViewBag.Tabla';
                    form.appendChild(tableInput);

                    var idInput = document.createElement('input');
                    idInput.type = 'hidden';
                    idInput.name = 'id';
                    idInput.value = id;
                    form.appendChild(idInput);

                    var tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = $('input[name="__RequestVerificationToken"]').val() || '';
                    form.appendChild(tokenInput);

                    document.body.appendChild(form);
                    form.submit();
                }
            })
        }
    </script>
}
