<!-- SCRIPT AUTÓNOMO DE BÚSQUEDA - Independiente del script POS -->
<script>
(function() {
    'use strict';
    // --- Datos de productos desde el servidor (copia local para este script) ---
    var _posProductos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        (productos ?? new()).Select(p => new {
            id               = p.Id,
            nombre           = (p.Nombre ?? ""),
            codigoBarra      = (p.CodigoBarra ?? ""),
            pvp              = p.PVP ?? 0m,
            pvf              = p.PVF ?? 0m,
            contiene         = p.Contiene ?? 1,
            iva              = p.IVA ?? 0m,
            disponible       = p.Disponible ?? 0m,
            descuento        = p.Descuento ?? 0m,
            descuentoDesde   = p.Descuento_Desde.HasValue ? p.Descuento_Desde.Value.ToString("yyyy-MM-dd") : (string?)null,
            descuentoHasta   = p.Descuento_Hasta.HasValue ? p.Descuento_Hasta.Value.ToString("yyyy-MM-dd") : (string?)null,
            idProveedor      = p.Id_Proveedor ?? 0,
            vencimiento      = p.Vencimiento.HasValue ? p.Vencimiento.Value.ToString("dd/MM/yyyy") : "-",
            vencimientoIso   = p.Vencimiento.HasValue ? p.Vencimiento.Value.ToString("yyyy-MM-dd") : (string?)null
        })
    ));

    var _bodegasList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        (bodegas ?? new()).Select(b => new {
            id         = b.Id,
            nombre     = (b.Nombre ?? ""),
            esPrincipal = b.EsPrincipal
        })
    ));

    // --- Función de render simple (sin jQuery, solo DOM puro) ---
    function _renderResults(matches) {
        var tbody = document.querySelector('#tblModalResults tbody');
        if (!tbody) return;
        if (!matches || matches.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">Sin resultados. Intenta con otro t&#233;rmino.</td></tr>';
            return;
        }
        var defBodega = _bodegasList.find(function(b){ return b.esPrincipal; }) || _bodegasList[0] || { id: 0, nombre: 'Principal' };
        var html = '';
        matches.forEach(function(p) {
            var opts = _bodegasList.map(function(b){
                return '<option value="' + b.id + '"' + (b.esPrincipal ? ' selected' : '') + '>' + b.nombre + '</option>';
            }).join('');
            var unitSel = '';
            if (p.contiene > 1) {
                unitSel = '<select id="selBodega2_' + p.id + '" class="form-select form-select-sm" style="font-size:0.72rem;max-width:90px;">'
                        + '<option value="U">Unidad</option>'
                        + '<option value="C">Caja (' + p.contiene + ')</option>'
                        + '</select>';
            } else {
                unitSel = '<span class="badge" style="background:#ede9fe;color:#4f46e5;font-size:0.72rem;">UNID</span>';
            }
            var stockClass = p.disponible > 10 ? 'bg-success text-white' : 'bg-danger text-white';
            html += '<tr>'
                  + '<td style="font-size:0.82rem;color:#64748b;">' + (p.codigoBarra || 'N/A') + '</td>'
                  + '<td style="font-size:0.85rem;font-weight:600;">' + p.nombre + '</td>'
                  + '<td class="text-center"><span class="badge ' + stockClass + '">' + p.disponible + '</span></td>'
                  + '<td class="text-end" style="font-size:0.85rem;">' + (p.pvp || 0).toFixed(2) + '</td>'
                  + '<td class="text-end" style="font-size:0.85rem;">' + (p.contiene > 1 ? (p.pvp / p.contiene).toFixed(2) : '- ') + '</td>'
                  + '<td><select id="selBodega_' + p.id + '" class="form-select form-select-sm" style="font-size:0.72rem;">' + opts + '</select></td>'
                  + '<td class="text-center">'
                  + '<button type="button" class="btn btn-sm btn-primary rounded-circle p-0" style="width:30px;height:30px;"'
                  + ' onclick="_posAddProduct(' + p.id + ')">'
                  + '<i class="bi bi-plus-lg"></i></button></td>'
                  + '</tr>';
        });
        tbody.innerHTML = html;
    }

    // --- Agregar producto al carrito desde este script ---
    window._posAddProduct = function(id) {
        var lista = _posProductos;
        var p = lista.find(function(x){ return x.id == id; });
        if (!p) {
            if (typeof productosList !== 'undefined') {
                p = productosList.find(function(x){ return x.id == id; });
            }
        }
        if (!p) { console.error('_posAddProduct: producto no encontrado id=' + id); return; }

        var selBod   = document.getElementById('selBodega_' + id);
        var bodegaId = selBod ? parseInt(selBod.value) : 0;

        var defBod = _bodegasList.find(function(b){ return b.id === bodegaId; })
                  || _bodegasList.find(function(b){ return b.esPrincipal; })
                  || _bodegasList[0] || { id: 0, nombre: 'Principal' };
        bodegaId = bodegaId || defBod.id;

        if (typeof addToCart === 'function') {
            addToCart(
                p.id,
                p.nombre,
                p.pvp,
                p.pvf,
                p.contiene || 1,
                p.iva || 0,
                1,
                false,
                bodegaId,
                defBod.nombre || 'Principal',
                p.descuento || 0,
                p.descuentoDesde || null,
                p.descuentoHasta || null,
                p.idProveedor || 0
            );
            var inp = document.getElementById('txtModalSearch');
            if (inp) { inp.value = ''; inp.focus(); }
            var tbody = document.querySelector('#tblModalResults tbody');
            if (tbody) tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">Producto agregado. Continua buscando...</td></tr>';
        } else {
            alert('Error: la funcion addToCart no esta disponible. Recarga la pagina.');
        }
    };


    // --- Función de búsqueda (llamada desde oninput) ---
    window.posSearchInput = function(value) {
        var query = (value || '').toLowerCase().trim();
        var lista = (typeof productosList !== 'undefined' && productosList.length) ? productosList : _posProductos;

        if (query) {
            // Verificar si existe una coincidencia exacta por código de barra para agregar directo
            var p = lista.find(function(x) {
                return (x.codigoBarra || '').trim().toLowerCase() === query;
            });
            if (p) {
                var inp = document.getElementById('txtModalSearch');
                if (inp) inp.value = '';
                window._posAddProduct(p.id);
                return;
            }
        }

        var counter = document.getElementById('posProductCount');
        if (counter) counter.textContent = '📦 ' + lista.length + ' productos | Buscando: "' + query + '"';

        if (!query) {
            var tbody = document.querySelector('#tblModalResults tbody');
            if (tbody) tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">Empiece a escribir para buscar productos...</td></tr>';
            return;
        }

        var words = query.split(/\s+/);
        var matches = lista.filter(function(p) {
            var name = (p.nombre || '').toLowerCase();
            var code = (p.codigoBarra || '').toLowerCase();
            return words.every(function(w) { return name.includes(w) || code.includes(w); });
        });

        // Si el script principal tiene renderModalResults, usarlo; sino usar el local
        if (typeof renderModalResults === 'function') {
            renderModalResults(matches.slice(0, 50));
        } else {
            _renderResults(matches.slice(0, 50));
        }
    };

    // --- Enter / scanner ---
    window.posSearchKeydown = function(e) {
        if (e.key === 'Enter' || e.which === 13) {
            e.preventDefault();
            var inp = document.getElementById('txtModalSearch');
            var val = (inp ? inp.value : '').trim().toLowerCase();
            if (!val) return;

            var lista = (typeof productosList !== 'undefined' && productosList.length) ? productosList : _posProductos;
            var p = lista.find(function(x){ return (x.codigoBarra||'').trim().toLowerCase() === val; });
            if (p) { window._posAddProduct(p.id); return; }

            var firstBtn = document.querySelector('#tblModalResults tbody tr:first-child button');
            if (firstBtn) firstBtn.click();
        }
    };

    // --- Inicializar modal al mostrarse ---
    document.addEventListener('DOMContentLoaded', function() {
        var modalEl = document.getElementById('modalBuscarProductos');
        if (!modalEl) return;
        modalEl.addEventListener('shown.bs.modal', function() {
            var inp = document.getElementById('txtModalSearch');
            if (inp) { inp.value = ''; inp.focus(); }
            var tbody = document.querySelector('#tblModalResults tbody');
            if (tbody) tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">Empiece a escribir para buscar productos...</td></tr>';
            var lista = (typeof productosList !== 'undefined' && productosList.length) ? productosList : _posProductos;
            var counter = document.getElementById('posProductCount');
            if (counter) counter.textContent = '📦 ' + lista.length + ' productos cargados';
        });
    });

})();
</script>

