                dark: {
                    '--primary-color': '#a78bfa',
                    '--primary-hover': '#c4b5fd',
                    '--sidebar-bg': '#0b021d',
                    '--sidebar-text': '#ddd6fe',
                    '--sidebar-active': '#ffffff',
                    '--sidebar-hover-bg': '#1e1b4b',
                    '--sidebar-border': 'rgba(255, 255, 255, 0.05)',
                    '--bg-main': '#0f052d',
                    '--card-bg': '#0b021d',
                    '--text-main': '#fbfaff',
                    '--text-muted': '#c4b5fd',
                    '--border-color': '#2e1065',
                    '--header-bg': '#0b021d',
                    '--header-text': '#fbfaff'
                }
            }
        };

        let currentThemeMode = 'light';
        let currentPreset = 'default';
        let isCustomMode = false;
        let currentCustomStyles = {};

        function setThemeMode(mode) {
            currentThemeMode = mode;
            document.documentElement.setAttribute('data-theme', mode);
            
            // Sync buttons visual state
            const btnLight = document.getElementById('btn-mode-light');
            const btnDark = document.getElementById('btn-mode-dark');
            if (btnLight && btnDark) {
                if (mode === 'light') {
                    btnLight.classList.remove('btn-outline-secondary');
                    btnLight.classList.add('btn-primary', 'border-primary', 'text-white');
                    btnDark.classList.remove('btn-primary', 'border-primary', 'text-white');
                    btnDark.classList.add('btn-outline-secondary');
                } else {
                    btnDark.classList.remove('btn-outline-secondary');
                    btnDark.classList.add('btn-primary', 'border-primary', 'text-white');
                    btnLight.classList.remove('btn-primary', 'border-primary', 'text-white');
                    btnLight.classList.add('btn-outline-secondary');
                }
            }
            
            // Reapply layout colors
            if (isCustomMode) {
                onCustomColorInput();
            } else {
                applyPresetPalette(currentPreset);
            }
        }

        function applyPresetPalette(paletteName) {
            currentPreset = paletteName;
            isCustomMode = false;
            
            const palette = presetPalettes[paletteName];
            if (palette) {
                const styles = palette[currentThemeMode];
                const html = document.documentElement;
                
                // Clear inline style rules to apply presets cleanly
                html.removeAttribute('style');
                
                // Apply variables dynamically
                for (const [key, val] of Object.entries(styles)) {
                    html.style.setProperty(key, val);
                }
                
                // Sync color pickers
                document.getElementById('picker-primary').value = rgbToHex(getComputedStyle(html).getPropertyValue('--primary-color').trim()) || styles['--primary-color'];
                document.getElementById('picker-sidebar').value = rgbToHex(getComputedStyle(html).getPropertyValue('--sidebar-bg').trim()) || styles['--sidebar-bg'];
                document.getElementById('picker-bg').value = rgbToHex(getComputedStyle(html).getPropertyValue('--bg-main').trim()) || styles['--bg-main'];
                
                updateHexLabels();
            }
        }

        function rgbToHex(rgb) {
            if (!rgb) return null;
            if (rgb.startsWith('#')) return rgb;
            const match = rgb.match(/^rgb\s*\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*\)$/i);
            if (!match) return rgb;
            return "#" + 
                ("0" + parseInt(match[1], 10).toString(16)).slice(-2) +
                ("0" + parseInt(match[2], 10).toString(16)).slice(-2) +
                ("0" + parseInt(match[3], 10).toString(16)).slice(-2);
        }

        function updateHexLabels() {
            document.getElementById('val-primary').innerText = document.getElementById('picker-primary').value;
            document.getElementById('val-sidebar').innerText = document.getElementById('picker-sidebar').value;
            document.getElementById('val-bg').innerText = document.getElementById('picker-bg').value;
        }

        function adjustColorBrightness(hex, percent) {
            let R = parseInt(hex.substring(1,3), 16);
            let G = parseInt(hex.substring(3,5), 16);
            let B = parseInt(hex.substring(5,7), 16);

            R = parseInt(R * (100 + percent) / 100);
            G = parseInt(G * (100 + percent) / 100);
            B = parseInt(B * (100 + percent) / 100);

            R = (R < 255) ? R : 255;  
            G = (G < 255) ? G : 255;  
            B = (B < 255) ? B : 255;  

            R = (R > 0) ? R : 0;
            G = (G > 0) ? G : 0;
            B = (B > 0) ? B : 0;

            const rHex = R.toString(16).padStart(2, '0');
            const gHex = G.toString(16).padStart(2, '0');
            const bHex = B.toString(16).padStart(2, '0');

            return `#${rHex}${gHex}${bHex}`;
        }

        function getContrastColor(hexColor) {
            let color = hexColor.replace('#', '');
            if (color.length === 3) {
                color = color[0] + color[0] + color[1] + color[1] + color[2] + color[2];
            }
            const r = parseInt(color.substr(0, 2), 16);
            const g = parseInt(color.substr(2, 2), 16);
            const b = parseInt(color.substr(4, 2), 16);
            
            const yiq = ((r * 299) + (g * 587) + (b * 114)) / 1000;
            return (yiq >= 128) ? '#0f172a' : '#ffffff';
        }

        function onCustomColorInput() {
            isCustomMode = true;
            
            const primary = document.getElementById('picker-primary').value;
            const sidebar = document.getElementById('picker-sidebar').value;
            const bg = document.getElementById('picker-bg').value;
            
            updateHexLabels();
            
            const primaryHover = adjustColorBrightness(primary, -12);
            const bgMain = bg;
            
            const sidebarBg = sidebar;
            const sidebarTextContrast = getContrastColor(sidebarBg);
            
            const sidebarActive = sidebarTextContrast;
            const sidebarHoverBg = adjustColorBrightness(sidebarBg, sidebarTextContrast === '#ffffff' ? 10 : -10);
            const sidebarBorder = adjustColorBrightness(sidebarBg, sidebarTextContrast === '#ffffff' ? 6 : -6);
            const sidebarText = sidebarTextContrast === '#ffffff' ? '#9ca3af' : '#4b5563';
            
            const textMain = getContrastColor(bgMain);
            const textMuted = textMain === '#ffffff' ? '#9ca3af' : '#64748b';
            const cardBg = currentThemeMode === 'dark' ? adjustColorBrightness(bgMain, 6) : '#ffffff';
            const borderColor = currentThemeMode === 'dark' ? adjustColorBrightness(bgMain, 12) : '#e2e8f0';
            
            const headerBg = cardBg;
            const headerText = textMain;
            
            const html = document.documentElement;
            
            currentCustomStyles = {
                '--primary-color': primary,
                '--primary-hover': primaryHover,
                '--sidebar-bg': sidebarBg,
                '--sidebar-text': sidebarText,
                '--sidebar-active': sidebarActive,
                '--sidebar-hover-bg': sidebarHoverBg,
                '--sidebar-border': sidebarBorder,
                '--bg-main': bgMain,
                '--card-bg': cardBg,
                '--text-main': textMain,
                '--text-muted': textMuted,
                '--border-color': borderColor,
                '--header-bg': headerBg,
                '--header-text': headerText
            };
            
            for (const [key, val] of Object.entries(currentCustomStyles)) {
                html.style.setProperty(key, val);
            }
        }

        function saveThemePreferences() {
            const preferences = {
                themeMode: currentThemeMode,
                isCustom: isCustomMode,
                paletteName: currentPreset,
                styles: isCustomMode ? currentCustomStyles : presetPalettes[currentPreset][currentThemeMode]
            };
            
            localStorage.setItem(themeStorageKey, JSON.stringify(preferences));
            
            Swal.fire({
                icon: 'success',
                title: '¡Preferencias Guardadas!',
                text: 'Tus colores personalizados se han guardado con éxito para este usuario.',
                timer: 2000,
                showConfirmButton: false
            });
        }

        function resetThemeDefaults() {
            localStorage.removeItem(themeStorageKey);
            localStorage.removeItem('theme');
            
            currentThemeMode = 'light';
            currentPreset = 'default';
            isCustomMode = false;
            
            const html = document.documentElement;
            html.removeAttribute('style');
            
            setThemeMode('light');
            applyPresetPalette('default');
            
            Swal.fire({
                icon: 'info',
                title: 'Tema Reestablecido',
                text: 'Se han cargado los colores predeterminados de fábrica.',
                timer: 2000,
                showConfirmButton: false
            });
        }

        // Initialize Theme from LocalStorage
        $(document).ready(function() {
            try {
                const prefStr = localStorage.getItem(themeStorageKey);
                if (prefStr) {
                    const pref = JSON.parse(prefStr);
                    currentThemeMode = pref.themeMode || 'light';
                    isCustomMode = pref.isCustom || false;
                    currentPreset = pref.paletteName || 'default';
                    
                    setThemeMode(currentThemeMode);
                    
                    if (isCustomMode) {
                        document.getElementById('picker-primary').value = pref.styles['--primary-color'];
                        document.getElementById('picker-sidebar').value = pref.styles['--sidebar-bg'];
                        document.getElementById('picker-bg').value = pref.styles['--bg-main'];
                        onCustomColorInput();
                    } else {
                        applyPresetPalette(currentPreset);
                    }
                } else {
                    const savedTheme = localStorage.getItem('theme') || 'light';
                    setThemeMode(savedTheme);
                    applyPresetPalette('default');
                }
            } catch (e) {
                console.error("Error setting custom theme colors:", e);
                setThemeMode('light');
                applyPresetPalette('default');
            }
        });
    </script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            (function() {
                const SESSION_TIMEOUT_MS = 6 * 60 * 60 * 1000; // 6 horas
                const WARNING_TIME_MS = 5 * 60 * 1000; // 5 minutos de aviso
                const PING_INTERVAL_MS = 15 * 60 * 1000; // 15 minutos para ping
                const STORAGE_KEY = 'erp_session_last_activity';
                const ACTIVE_KEY = 'erp_session_active';

                // Registrar que hay una sesión de usuario activa en este navegador
                localStorage.setItem(ACTIVE_KEY, 'true');
                
                // Inicializar última actividad si no existe
                if (!localStorage.getItem(STORAGE_KEY)) {
                    localStorage.setItem(STORAGE_KEY, Date.now().toString());
                }

                // Actualizar marca de tiempo de la última actividad del usuario
                function updateActivity() {
                    localStorage.setItem(STORAGE_KEY, Date.now().toString());
                }

                // Escuchar eventos usuales de interacción
                const events = ['mousemove', 'mousedown', 'keypress', 'scroll', 'click', 'touchstart'];
                events.forEach(evt => {
                    document.addEventListener(evt, updateActivity, { passive: true });
                });

                // Enviar ping silencioso periódicamente si ha habido actividad para renovar el cookie deslizante en el servidor
                let lastPingTime = Date.now();
                setInterval(function() {
                    const lastActivity = parseInt(localStorage.getItem(STORAGE_KEY) || Date.now().toString());
                    const now = Date.now();

                    // Si se ha interactuado en los últimos 15 minutos, y han pasado 15 minutos desde el último ping
                    if (now - lastActivity < PING_INTERVAL_MS && now - lastPingTime >= PING_INTERVAL_MS) {
                        lastPingTime = now;
                        $.get('/Account/Ping').done(function(data) {
                            if (data && data.authenticated === false) {
                                localStorage.removeItem(ACTIVE_KEY);
                                window.location.href = '/Account/Login?sessionExpired=true';
                            }
                        }).fail(function() {
                            // En caso de caída de servidor o desconexión no forzamos cierre para evitar falsos positivos
                        });
                    }
                }, 30000); // Evaluar cada 30 segundos

                // Monitoreo de inactividad
                let warningAlertShowing = false;
                let countdownInterval = null;

                setInterval(function() {
                    const lastActivity = parseInt(localStorage.getItem(STORAGE_KEY) || Date.now().toString());
                    const now = Date.now();
                    const idleTime = now - lastActivity;

                    if (idleTime >= (SESSION_TIMEOUT_MS - WARNING_TIME_MS)) {
                        if (idleTime >= SESSION_TIMEOUT_MS) {
                            // Tiempo expirado por completo
                            if (warningAlertShowing) {
                                Swal.close();
                            }
                            localStorage.removeItem(ACTIVE_KEY);
                            window.location.href = '/Account/Logout?expired=true';
                            return;
                        }

                        // Mostrar aviso SweetAlert
                        if (!warningAlertShowing) {
                            warningAlertShowing = true;
                            
                            let remainingMs = SESSION_TIMEOUT_MS - idleTime;
                            let secondsLeft = Math.ceil(remainingMs / 1000);

                            Swal.fire({
                                title: 'Tu sesión está por expirar',
                                html: 'Tu sesión se cerrará automáticamente por inactividad en <strong id="session-countdown">' + secondsLeft + '</strong> segundos.<br><br>¿Deseas mantener la sesión activa?',
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonText: 'Sí, continuar',
                                cancelButtonText: 'Cerrar sesión',
                                confirmButtonColor: '#4f46e5',
                                cancelButtonColor: '#dc3545',
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                didOpen: () => {
                                    countdownInterval = setInterval(() => {
                                        const currentActivity = parseInt(localStorage.getItem(STORAGE_KEY) || Date.now().toString());
                                        const currentNow = Date.now();
                                        const currentIdle = currentNow - currentActivity;

                                        // Si el usuario interactuó en otra pestaña, cerramos esta alerta de inmediato
                                        if (currentIdle < (SESSION_TIMEOUT_MS - WARNING_TIME_MS)) {
                                            clearInterval(countdownInterval);
                                            warningAlertShowing = false;
                                            Swal.close();
                                            return;
                                        }

                                        const remaining = SESSION_TIMEOUT_MS - currentIdle;
                                        if (remaining <= 0) {
                                            clearInterval(countdownInterval);
                                            warningAlertShowing = false;
                                            Swal.close();
                                            localStorage.removeItem(ACTIVE_KEY);
                                            window.location.href = '/Account/Logout?expired=true';
                                            return;
                                        }

                                        const sec = Math.ceil(remaining / 1000);
                                        const container = Swal.getHtmlContainer();
                                        if (container) {
                                            const el = container.querySelector('#session-countdown');
                                            if (el) el.textContent = sec;
                                        }
                                    }, 1000);
                                },
                                willClose: () => {
                                    clearInterval(countdownInterval);
                                }
                            }).then((result) => {
                                warningAlertShowing = false;
                                if (result.isConfirmed) {
                                    // Renovar actividad y forzar ping al servidor
                                    updateActivity();
                                    $.get('/Account/Ping');
                                } else if (result.dismiss === Swal.DismissReason.cancel) {
                                    localStorage.removeItem(ACTIVE_KEY);
                                    window.location.href = '/Account/Logout?expired=true';
                                }
                            });
                        }
                    } else {
                        // Si ya no está inactivo (por ejemplo, porque interactuó en otra pestaña), cerrar la alerta si estuviera abierta
                        if (warningAlertShowing) {
                            Swal.close();
                            warningAlertShowing = false;
                        }
                    }
                }, 5000); // Monitorear cada 5 segundos
            })();
        </script>
    }
</body>
</html>
