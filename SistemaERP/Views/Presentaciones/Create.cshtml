@model SistemaERP.Models.Entities.Presentacion

@{
    ViewData["Title"] = (Model?.Id > 0) ? "Editar Presentación" : "Nueva Presentación";
}

<div class="row mb-4 animate__animated animate__fadeIn">
    <div class="col">
        <h2 class="fw-bold mb-1">@(Model?.Id > 0 ? "Editar Presentación" : "Registrar Nueva Presentación")</h2>
        <p class="text-muted">Defina la unidad o formato de venta para los productos.</p>
    </div>
</div>

<div class="row animate__animated animate__fadeInUp">
    <div class="col-md-6">
        <div class="premium-card">
            <form asp-action="@(Model?.Id > 0 ? "Edit" : "Create")">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                @if (Model?.Id > 0)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div class="mb-4">
                    <label asp-for="Nombre" class="form-label fw-semibold">Nombre de la Presentación</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-box"></i></span>
                        <input asp-for="Nombre" class="form-control border-start-0 ps-0" placeholder="Ej. Caja 20 u., Frasco 500ml, Unidad, etc." required />
                    </div>
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 pt-2">
                    <button type="submit" class="btn btn-premium flex-grow-1 shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Guardar Cambios
                    </button>
                    <a asp-action="Index" class="btn btn-light border flex-grow-1">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
