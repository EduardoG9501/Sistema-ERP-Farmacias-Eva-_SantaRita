                                <input type="number" id="txtTransferenciaMonto" class="form-control form-control-lg text-end fw-bold text-dark border-primary" style="background-color: #ffffcc; font-size: 1.4rem;" value="0.00" step="0.01" min="0">
                            </div>
                            <button type="button" class="btn btn-primary w-100 py-2 fw-bold" onclick="addPaymentMethod('TRANSFERENCIA')">
                                <i class="bi bi-plus-circle me-2"></i>Agregar Forma Pago
                            </button>
                        </div>
                        
                    </div>
                    
                    <!-- Right Column (Added payments grid & Summary) -->
                    <div class="col-lg-7 d-flex flex-column justify-content-between">
                        <div class="border rounded-3 p-3 bg-light d-flex flex-column h-100 mb-3 shadow-sm" style="min-height: 320px;">
                            <div class="fw-bold text-dark mb-3 d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-list-check me-2 text-primary"></i>Detalle de Forma de Pago:</span>
                                <div class="btn-group btn-group-sm">
                                    <span class="px-2 py-1 small bg-white border border-end-0 rounded-start text-muted fw-bold" id="lblPayGridCount">Total Items: 0</span>
                                    <button type="button" class="btn btn-outline-danger btn-sm py-1" onclick="clearSelectedPayments()" title="Limpiar todos los pagos">
                                        <i class="bi bi-trash"></i> Limpiar Todo
                                    </button>
                                </div>
                            </div>
                            
                            <!-- Grid / List Table Area -->
                            <div class="flex-grow-1 overflow-auto rounded border border-secondary border-opacity-25 bg-white mb-3" style="max-height: 250px;">
                                <table class="table table-sm table-hover align-middle mb-0" id="tblPaymentGrid" style="font-size: 0.85rem;">
                                    <thead class="table-primary text-uppercase" style="font-size: 0.75rem; position: sticky; top: 0; z-index: 10;">
                                        <tr>
                                            <th class="ps-3 py-2" style="width: 35%;">Forma Pago</th>
                                            <th class="py-2" style="width: 25%;">Monto</th>
                                            <th class="py-2" style="width: 30%;">Detalle / Ref / Banco / D&#237;as</th>
                                            <th class="text-center py-2" style="width: 10%;">X</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td colspan="4" class="text-center py-4 text-muted">
                                                <i class="bi bi-info-circle me-1"></i>No ha agregado ninguna forma de pago todav&#237;a.
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            
                            <!-- Cobro Summary panel -->
                            <div class="row g-2 p-3 bg-white border rounded-3 mt-auto">
                                <div class="col-6 d-flex flex-column">
                                    <span class="text-muted small fw-bold uppercase">TOTAL A COBRAR:</span>
                                    <span class="fs-4 fw-bold text-primary" id="lblPayTotalFactura">@ViewBag.MonedaSimbolo 0.00</span>
                                </div>
                                <div class="col-6 d-flex flex-column align-items-end text-end">
                                    <span class="text-muted small fw-bold uppercase">PAGADO (ENTREGA):</span>
                                    <span class="fs-4 fw-bold text-success" id="lblPayTotalPagado">@ViewBag.MonedaSimbolo 0.00</span>
                                </div>
                                <div class="col-12 mt-2 pt-2 border-top">
                                    <div class="alert mb-0 text-center fw-bold p-2" id="payStatusAlert" style="font-size: 0.9rem;">
                                        Falta ingresar el pago
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Modal Footer -->
            <div class="modal-footer border-0 p-3 bg-light" style="border-bottom-left-radius: 16px; border-bottom-right-radius: 16px;">
                <button type="button" class="btn btn-secondary px-4 fw-bold shadow-sm" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>CANCELAR
                </button>
                <button type="button" class="btn btn-success px-4 fw-bold shadow-sm" id="btnPayConfirm" disabled onclick="confirmarGuardarVenta()">
                    <i class="bi bi-check-circle me-1"></i>GUARDAR VENTA
                </button>
            </div>
            
        </div>
    </div>
</div>

@* Footer Atajos *@
<div class="shortcut-footer">
    <div class="item"><span class="shortcut-key">F1</span> Buscar</div>
    <div class="item"><span class="shortcut-key">F2</span> Composici&#243;n</div>
