@model IEnumerable<SistemaERP.Models.Entities.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="row mb-4 animate__animated animate__fadeIn">
    <div class="col">
        <h2 class="fw-bold mb-1">Clientes</h2>
        <p class="text-muted">Gestión de cartera de clientes y datos de facturación.</p>
    </div>
    <div class="col-auto d-flex gap-2">
        <a href="@Url.Action("DescargarPlantilla", "ImportacionMasiva", new { catalogo = "clientes" })" class="btn btn-outline-primary shadow-sm" title="Descargar Plantilla Excel">
            <i class="bi bi-download me-1"></i> Plantilla
        </a>
        <button type="button" class="btn btn-outline-success shadow-sm" onclick="abrirModalImportacion('clientes')" title="Cargar Datos desde Excel">
            <i class="bi bi-file-earmark-excel me-1"></i> Cargar Excel
        </button>
        <a asp-action="Create" class="btn btn-premium shadow-sm">
            <i class="bi bi-person-plus me-1"></i> Nuevo Cliente
        </a>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger border-0 shadow-sm mb-4 animate__animated animate__shakeX" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
    </div>
}

<div class="premium-card animate__animated animate__fadeInUp">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="border-0 text-xs text-uppercase py-3">Identificación</th>
                    <th class="border-0 text-xs text-uppercase py-3">Cliente</th>
                    <th class="border-0 text-xs text-uppercase py-3">Contacto</th>
                    <th class="border-0 text-xs text-uppercase py-3">Ciudad / Dirección</th>
                    @if (ViewBag.CustomFields != null)
                    {
                        @foreach (var campo in (ViewBag.CustomFields as List<SistemaERP.Areas.Admin.Models.CampoPersonalizado>).Where(c => c.VisibleEnLista))
                        {
                            <th class="border-0 text-xs text-uppercase py-3">@campo.Etiqueta</th>
                        }
                    }
                    <th class="border-0 text-xs text-uppercase py-3 text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr id="row-@item.Id">
                            <td class="fw-medium text-primary">
                                @(string.IsNullOrEmpty(item.RUC) ? item.Cedula : item.RUC)
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-green-soft rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                        <i class="bi bi-person fs-5"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@item.Nombres_Apellidos</span>
                                </div>
                            </td>
                            <td>
                                <div class="text-sm"><i class="bi bi-telephone me-1 opacity-50"></i> @item.Telefono</div>
                                <div class="text-xs text-muted"><i class="bi bi-envelope me-1 opacity-50"></i> @item.Correo</div>
                            </td>
                            <td>
                                <div class="text-sm sw-bold">@item.Ciudad</div>
                                <div class="text-xs text-muted text-truncate" style="max-width: 200px;">@item.Direccion</div>
                            </td>
                            @if (ViewBag.CustomFields != null)
                            {
                                var service = ViewBag.CamposService as SistemaERP.Areas.Admin.Services.ICamposPersonalizadosService;
                                var dict = service.ParseDatosAdicionales(item.DatosAdicionales);
                                @foreach (var campo in (ViewBag.CustomFields as List<SistemaERP.Areas.Admin.Models.CampoPersonalizado>).Where(c => c.VisibleEnLista))
                                {
                                    dict.TryGetValue(campo.NombreCampo, out var val);
                                    <td class="text-sm fw-medium">@(val?.ToString() ?? "N/A")</td>
                                }
                            }
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border-0 text-primary me-1" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-light border-0 text-danger" title="Eliminar" onclick="confirmDelete(@item.Id, '@item.Nombres_Apellidos')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2 opacity-25"></i>
                            No se encontraron clientes registrados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted fw-medium">
        <i class="bi bi-arrow-left me-1"></i> Volver al Dashboard
    </a>
</div>

@await Html.PartialAsync("_ImportacionMasivaModal")

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: "Eliminarás al cliente '" + name + "'.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3b82f6',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Clientes")',
                        type: 'POST',
                        data: { id: id },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: '¡Eliminado!',
                                    text: response.message,
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                                $("#row-" + id).fadeOut(500);
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'No se pudo procesar la solicitud.', 'error');
                        }
                    });
                }
            })
        }
    </script>
}
