                    }
                },
                error: function(err) {
                    Swal.close();
                    console.error('Error al recuperar detalles de producto:', err);
                    Swal.fire('Error de Conexi\u00F3n', 'No se pudo establecer comunicaci\u00F3n con el servidor.', 'error');
                }
            });
