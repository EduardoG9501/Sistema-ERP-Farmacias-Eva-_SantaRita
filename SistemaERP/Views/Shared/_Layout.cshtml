    <script>
        // Sidebar Toggling with LocalStorage Persistence
        $("#menu-toggle").click(function(e) {
            e.preventDefault();
            $("#wrapper").toggleClass("toggled");
            
            if ($(window).width() < 768) {
                if ($("#wrapper").hasClass("toggled")) {
                    $("body").addClass("sidebar-open");
                } else {
                    $("body").removeClass("sidebar-open");
                }
            }

            if ($("#wrapper").hasClass("toggled")) {
                localStorage.setItem("sidebar-state", "toggled");
            } else {
                localStorage.setItem("sidebar-state", "expanded");
            }
        });

        // Sidebar Category Expanding/Collapsing with slideToggle
        $(document).ready(function() {
            // Reset toggled class on mobile load so sidebar starts hidden
            if ($(window).width() < 768) {
                $("#wrapper").removeClass("toggled");
            }

            // Close sidebar on mobile when clicking outside of it
            $(document).click(function(event) {
                if ($(window).width() < 768) {
                    var $target = $(event.target);
                    if (!$target.closest('#sidebar-wrapper').length && 
                        !$target.closest('#menu-toggle').length && 
                        $('#wrapper').hasClass('toggled')) {
                        $('#wrapper').removeClass('toggled');
                        $("body").removeClass("sidebar-open");
                    }
                }
            });

            $('.category-header').click(function() {
                var targetSelector = $(this).attr('data-target');
                var target = $(targetSelector);
                var header = $(this);
                
                header.toggleClass('expanded');
                target.slideToggle(200);
            });
        });

        // Global SweetAlert Notifications
        $(document).ready(function() {
            var successMsg = '@TempData["Success"]';
            var errorMsg = '@TempData["Error"]';

            if (successMsg) {
                Swal.fire({
                    icon: 'success',
                    title: '¡Éxito!',
                    text: successMsg,
                    timer: 3000,
                    showConfirmButton: false
                });
            }

            if (errorMsg) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: errorMsg
                });
            }
        });
    </script>
