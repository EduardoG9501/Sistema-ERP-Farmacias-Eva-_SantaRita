@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container mt-5 animate__animated animate__fadeIn">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="premium-card p-5 shadow-lg border-0 rounded-4">
                <i class="bi bi-shield-lock-fill text-danger display-1 mb-4"></i>
                <h1 class="fw-bold text-dark">Acceso Restringido</h1>
                <p class="text-muted fs-5 mb-4">Lo sentimos, no tienes los permisos suficientes para acceder a esta sección. Por favor, contacta con un administrador si crees que esto es un error.</p>
                
                <div class="d-grid gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-premium btn-lg rounded-pill shadow-sm">
                        <i class="bi bi-house-door me-2"></i> Volver al Inicio
                    </a>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary btn-sm border-0 mt-2">
                        Iniciar sesión con otra cuenta
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
