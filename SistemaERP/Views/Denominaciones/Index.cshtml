@model IEnumerable<SistemaERP.Models.Entities.Denominacion>

@{
    ViewData["Title"] = "Denominaciones";
}

<div class="row mb-4 animate__animated animate__fadeIn">
    <div class="col">
        <h2 class="fw-bold mb-1">Configuración de Denominaciones</h2>
        <p class="text-muted">Gestiona los billetes y monedas que se utilizan en la caja.</p>
    </div>
    <div class="col-auto">
        <a asp-action="Create" class="btn btn-premium shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nueva Denominación
        </a>
    </div>
</div>

<div class="premium-card animate__animated animate__fadeInUp">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="border-0 py-3">Nombre</th>
                    <th class="border-0 py-3 text-end">Valor</th>
                    <th class="border-0 py-3 text-center">Tipo</th>
                    <th class="border-0 py-3 text-center">Estado</th>
                    <th class="border-0 py-3 text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.Nombre</td>
                        <td class="text-end text-success fw-bold">@ViewBag.MonedaSimbolo@item.Valor.ToString("N2")</td>
                        <td class="text-center">
                            @if(item.Tipo == "Billete") {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill"><i class="bi bi-cash me-1"></i> Billete</span>
                            } else {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill"><i class="bi bi-coin me-1"></i> Moneda</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.Activo)
                            {
                                <span class="badge bg-primary rounded-pill px-3">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill px-3">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger ms-1">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
