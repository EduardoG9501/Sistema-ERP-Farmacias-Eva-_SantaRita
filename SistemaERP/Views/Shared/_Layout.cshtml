@inject SistemaERP.Models.ScmContext _context
@inject SistemaERP.Areas.Admin.Models.AdminContext AdminDb
@using System.Text.Json
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema ERP Premium</title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaERP.styles.css" asp-append-version="true" />
    
    <!-- Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    
    <style>
        /* Core Layout Styles to prevent menu from flowing to top */
        #wrapper {
            display: flex;
            width: 100%;
        }

        #sidebar-wrapper {
            height: 100vh;
            width: var(--sidebar-width, 260px);
            background: var(--sidebar-bg, #0f172a);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            overflow-y: auto;
            border-right: 1px solid var(--sidebar-border, rgba(255, 255, 255, 0.08));
        }

        #wrapper.toggled #sidebar-wrapper {
            margin-left: calc(-1 * var(--sidebar-width, 260px));
        }

        #page-content-wrapper {
            width: 100%;
            margin-left: var(--sidebar-width, 260px);
            min-height: 100vh;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        #wrapper.toggled #page-content-wrapper {
            margin-left: 0;
        }

        /* Mobile responsive layout overrides */
        @@media (max-width: 768px) {
            #sidebar-wrapper {
                margin-left: calc(-1 * var(--sidebar-width, 260px)) !important;
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                width: var(--sidebar-width, 260px) !important;
                height: 100vh !important;
                z-index: 1050 !important;
                box-shadow: none !important;
                background: var(--sidebar-bg, #0f172a) !important;
            }

            #page-content-wrapper {
                margin-left: 0 !important;
                width: 100% !important;
            }

            #wrapper.toggled #sidebar-wrapper {
                margin-left: 0 !important;
                box-shadow: 4px 0 24px rgba(0, 0, 0, 0.15) !important;
            }
        }

        /* Custom Premium Collapsible Categories Sidebar */
        .category-header {
            padding: 0.7rem 0.9rem;
            color: var(--sidebar-text);
            user-select: none;
            transition: all 0.2s ease-in-out;
            cursor: pointer;
            border-radius: 8px;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
        }
        .category-header:hover {
            background-color: var(--sidebar-hover-bg);
            color: var(--primary-color);
        }
        .category-header.expanded {
            color: var(--primary-color);
            background-color: rgba(99, 102, 241, 0.06);
            font-weight: 600;
        }
        .category-chevron {
            font-size: 0.7rem;
            transition: transform 0.2s ease-in-out;
        }
        .category-header.expanded .category-chevron {
            transform: rotate(90deg);
        }
        .category-body {
            display: none;
        }
        .sidebar-category {
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 4px;
        }
        .category-body .list-group-item {
            font-size: 0.775rem;
            padding: 0.5rem 0.75rem;
            border-radius: 6px;
            margin: 1px 0;
            margin-left: 0.5rem;
        }
        .bg-indigo-soft {
            background-color: rgba(99, 102, 241, 0.08) !important;
        }
    </style>
</head>
<body>
    <input type="hidden" id="hfMonedaSimbolo" value="@ViewBag.MonedaSimbolo" />
    <div id="wrapper">
        <script>
            // Set timezone offset cookie to sync server-side date/time with browser timezone
            (function() {
                try {
                    var offset = new Date().getTimezoneOffset();
                    document.cookie = "UserTimeZoneOffset=" + offset + "; path=/; max-age=31536000; SameSite=Lax";
                } catch(e) { console.error("Error setting timezone cookie", e); }
            })();
            const MONEDA_SIMBOLO = '@ViewBag.MonedaSimbolo';
            // Apply toggled/shrunk sidebar state immediately to prevent visual flash on page load
            if (localStorage.getItem('sidebar-state') === 'toggled') {
                document.getElementById('wrapper').classList.add('toggled');
            }
            
            // Premium Anti-Flash Early Theme Loader (User-specific)
            (function() {
                try {
                    const activeUser = '@(User.Identity?.Name ?? "guest")';
                    const themeStorageKey = `erp-theme-pref-${activeUser}`;
                    const prefStr = localStorage.getItem(themeStorageKey);
                    if (prefStr) {
                        const pref = JSON.parse(prefStr);
                        const html = document.documentElement;
                        html.setAttribute('data-theme', pref.themeMode || 'light');
                        if (pref.styles) {
                            for (const [key, val] of Object.entries(pref.styles)) {
                                html.style.setProperty(key, val);
                            }
                        }
                    } else {
                        // Fallback to legacy theme if general toggle is present
                        const savedTheme = localStorage.getItem('theme') || 'light';
                        document.documentElement.setAttribute('data-theme', savedTheme);
                    }
                } catch (e) {
                    console.error("Early theme loader error:", e);
                }
            })();
        </script>
        
        <!-- Sidebar -->
        <div id="sidebar-wrapper">
            @{
                var sysParams = _context.ParametrosSistema.FirstOrDefault(p => p.Id == 1);
            }
            <div class="sidebar-heading text-center py-3">
                @if (sysParams != null && !string.IsNullOrEmpty(sysParams.LogoPath) && sysParams.MostrarLogoEnDocumentos)
                {
                    <img src="@(sysParams.LogoPath.Split('?')[0])" alt="Logo" style="max-height: 40px; max-width: 160px; object-fit: contain;" class="d-block mx-auto mb-1" />
                    <span class="fw-bold tracking-tight" style="font-size: 0.75rem;">@(sysParams.AliasEmpresa ?? sysParams.NombreEmpresa ?? "SCM")</span>
                }
                else
                {
                    <i class="bi bi-hospital me-2 text-primary fs-3"></i><span class="fw-bold tracking-tight">@(sysParams?.NombreEmpresa ?? "SCM")</span>
                }
            </div>
            <div class="list-group list-group-flush px-3">
                @{
                    var isadmin = false;
                    var allowedPrivileges = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

                    if (User.Identity?.IsAuthenticated == true)
                    {
                        var username = User.Identity.Name;
                        var dbUser = _context.Usuarios.FirstOrDefault(u => u.Login.Trim() == (username ?? "").Trim());
                        if (dbUser != null)
                        {
                            isadmin = string.Equals(dbUser.Tipo_Usuario?.Trim(), "ADMINISTRADOR", StringComparison.OrdinalIgnoreCase);
                            if (!isadmin)
                            {
                                var dbPrivileges = _context.UsuarioPrivilegiosWeb
                                    .Where(up => up.Id_Usuario == dbUser.Id && up.Privilegio.Estado)
                                    .Select(up => new {
                                        Controller = up.Privilegio.Modulo.ControllerName,
                                        Action = up.Privilegio.ActionName
                                    })
                                    .ToList();
                                    
                                foreach (var p in dbPrivileges)
                                {
                                    allowedPrivileges.Add($"{p.Controller}/{p.Action}");
                                }
                            }
                        }
                    }

                    // Dynamic folder categories allowed visibility checks
                    bool showVentas = isadmin || 
                        allowedPrivileges.Contains("Facturacion/POS") || 
                        allowedPrivileges.Contains("Facturacion/Index") || 
                        allowedPrivileges.Contains("Cobros/Index");

                    bool showInventario = isadmin || 
                        allowedPrivileges.Contains("Facturacion/Kardex") || 
                        allowedPrivileges.Contains("Productos/Index") || 
                        allowedPrivileges.Contains("Ajustes/Index") || 
                        allowedPrivileges.Contains("Traslados/Index");

                    bool showCompras = isadmin || 
                        allowedPrivileges.Contains("Compras/Index") || 
                        allowedPrivileges.Contains("Proveedores/Index") ||
                        allowedPrivileges.Contains("CuentasPorPagar/Index");

                    bool showBancos = isadmin || 
                        allowedPrivileges.Contains("Clientes/Index");

                    bool showContabilidad = isadmin || 
                        allowedPrivileges.Contains("CuentasContables/Index") || 
                        allowedPrivileges.Contains("Gastos/Index") || 
                        allowedPrivileges.Contains("ConfiguracionReporte/Index") || 
                        allowedPrivileges.Contains("Reportes/EstadoResultados");

                    bool showConfig = isadmin || 
                        allowedPrivileges.Contains("Usuarios/Index") || 
                        allowedPrivileges.Contains("AjustesSRI/Index") || 
                        allowedPrivileges.Contains("Descuentos/Index") ||
                        allowedPrivileges.Contains("ParametrosSistema/Index");

                    bool showCatalogos = isadmin || 
                        allowedPrivileges.Contains("Bodegas/Index") || 
                        allowedPrivileges.Contains("Presentaciones/Index") || 
                        allowedPrivileges.Contains("CatGastos/Index") || 
                        allowedPrivileges.Contains("Bancos/Index") || 
                        allowedPrivileges.Contains("Denominaciones/Index");

                    var dynamicTables = new List<Tuple<string, string>>();
                    if (User.Identity?.IsAuthenticated == true)
                    {
                        var empresaIdClaim = User.FindFirst("EmpresaId")?.Value;
                        if (int.TryParse(empresaIdClaim, out int currentEmpresaId))
                        {
                            var currentEmpresa = AdminDb.Empresas.Find(currentEmpresaId);
                            int? currentRubroId = currentEmpresa?.RubroId;

                            var customLookupFields = AdminDb.CamposPersonalizados
                                .Where(c => c.Activo && c.TipoDato == "Lista" && 
                                            (c.EmpresaId == null || c.EmpresaId == currentEmpresaId) &&
                                            (c.RubroId == null || c.RubroId == currentRubroId))
                                .ToList();

                            foreach (var campo in customLookupFields)
                            {
                                if (!string.IsNullOrEmpty(campo.OpcionesLista) && campo.OpcionesLista.Trim().StartsWith("{"))
                                {
                                    try
                                    {
                                        using (var doc = JsonDocument.Parse(campo.OpcionesLista))
                                        {
                                            if (doc.RootElement.TryGetProperty("EsTabla", out var esTablaProp) && esTablaProp.GetBoolean())
                                            {
                                                var tableName = doc.RootElement.GetProperty("TablaNombre").GetString();
                                                if (!string.IsNullOrEmpty(tableName))
                                                {
                                                    dynamicTables.Add(Tuple.Create(campo.Etiqueta, tableName));
                                                }
                                            }
                                        }
                                    }
                                    catch { }
                                }
                            }
                        }
                    }

                    if (dynamicTables.Any())
                    {
                        showCatalogos = true;
                    }

                    // Active state detection to auto-expand folders on page load
                    string currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
                    string currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";

                    bool isVentasActive = currentController == "Facturacion" && currentAction != "Kardex" || currentController == "Cobros";
                    bool isInventarioActive = currentController == "Productos" || currentController == "Ajustes" || currentController == "Traslados" || (currentController == "Facturacion" && currentAction == "Kardex");
                    bool isComprasActive = currentController == "Compras" || currentController == "Proveedores" || currentController == "CuentasPorPagar";
                    bool isBancosActive = currentController == "Clientes";
                    bool isContabilidadActive = currentController == "CuentasContables" || currentController == "Gastos" || currentController == "ConfiguracionReporte" || (currentController == "Reportes" && currentAction == "EstadoResultados");
                    bool isConfigActive = currentController == "Usuarios" || currentController == "AjustesSRI" || currentController == "Descuentos" || currentController == "ParametrosSistema";
                    bool isCatalogosActive = currentController == "Bodegas" || currentController == "Presentaciones" || currentController == "CatGastos" || currentController == "Bancos" || currentController == "Denominaciones" || currentController == "CatalogosDinamicos";
                    
                    // Resolver subdominio central para el catálogo público
                    string? subdominio = null;
                    if (sysParams != null && sysParams.CatalogoPublicoActivo && !string.IsNullOrEmpty(sysParams.RUC))
                    {
                        var empresa = AdminDb.Empresas.FirstOrDefault(e => e.RUC == sysParams.RUC);
                        subdominio = empresa?.Subdominio;
                    }
                }

                <!-- Standalone Standby Dashboards -->
                <a asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action @(currentController == "Home" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                @if (isadmin || allowedPrivileges.Contains("Reportes/Index"))
                {
                    <a asp-controller="Reportes" asp-action="Index" class="list-group-item list-group-item-action @(currentController == "Reportes" ? "active" : "")">
                        <i class="bi bi-bar-chart-line"></i> Reportes
                    </a>
                }

                @if (sysParams != null && sysParams.CatalogoPublicoActivo && !string.IsNullOrEmpty(subdominio))
                {
                    <a href="/catalogo/@subdominio" target="_blank" class="list-group-item list-group-item-action">
                        <i class="bi bi-globe text-primary"></i> Mi Catálogo Web
                    </a>
                }

                <!-- Categoría 1: Ventas & Cobros -->
                @if (showVentas)
                {
                    <div class="sidebar-category">
                        <div class="category-header @(isVentasActive ? "expanded" : "")" data-target="#sub_menu_ventas">
                            <i class="bi bi-cart-check fs-5 me-3 text-primary"></i>
                            <span class="fw-semibold text-uppercase tracking-wider">Ventas & Cobros</span>
                            <i class="bi bi-chevron-right ms-auto text-muted category-chevron"></i>
                        </div>
                        <div class="category-body px-2 py-1 border-start ms-3" id="sub_menu_ventas" style="display: @(isVentasActive ? "block" : "none"); border-width: 2px !important; border-color: rgba(99, 102, 241, 0.2) !important;">
                            @if (isadmin || allowedPrivileges.Contains("Facturacion/POS"))
                            {
                                <a asp-controller="Facturacion" asp-action="POS" class="list-group-item list-group-item-action @(currentController == "Facturacion" && currentAction == "POS" ? "active" : "") bg-indigo-soft">
                                    <i class="bi bi-cpu"></i> POS (Punto Venta)
                                </a>
                            }
                            @if (isadmin || allowedPrivileges.Contains("Facturacion/Index"))
                            {
                                <a asp-controller="Facturacion" asp-action="Index" class="list-group-item list-group-item-action @(currentController == "Facturacion" && currentAction == "Index" ? "active" : "")">
                                    <i class="bi bi-list-ul"></i> Historial Ventas
                                </a>
                            }
                            @if (isadmin || allowedPrivileges.Contains("Facturacion/CierreCaja"))
                            {
                                <a asp-controller="Facturacion" asp-action="CierreCaja" class="list-group-item list-group-item-action @(currentController == "Facturacion" && currentAction == "CierreCaja" ? "active" : "")">
                                    <i class="bi bi-cash-coin text-warning"></i> Cierre de Caja
                                </a>
                            }
                            @if (isadmin || allowedPrivileges.Contains("Cobros/Index"))
                            {
                                <a asp-controller="Cobros" asp-action="Index" class="list-group-item list-group-item-action @(currentController == "Cobros" ? "active" : "")">
                                    <i class="bi bi-wallet2 text-success"></i> CxC (Clientes)
                                </a>
                            }
                        </div>
                    </div>
                }

                <!-- Categoría 2: Inventarios & Almacenes -->
                @if (showInventario)
                {
                    <div class="sidebar-category">
                        <div class="category-header @(isInventarioActive ? "expanded" : "")" data-target="#sub_menu_inventario">
                            <i class="bi bi-box-seam fs-5 me-3 text-warning"></i>
                            <span class="fw-semibold text-uppercase tracking-wider">Inventario</span>
                            <i class="bi bi-chevron-right ms-auto text-muted category-chevron"></i>
                        </div>
                        <div class="category-body px-2 py-1 border-start ms-3" id="sub_menu_inventario" style="display: @(isInventarioActive ? "block" : "none"); border-width: 2px !important; border-color: rgba(99, 102, 241, 0.2) !important;">
                            @if (isadmin || allowedPrivileges.Contains("Facturacion/Kardex"))
                            {
                                <a asp-controller="Facturacion" asp-action="Kardex" class="list-group-item list-group-item-action @(currentController == "Facturacion" && currentAction == "Kardex" ? "active" : "")">
                                    <i class="bi bi-journals"></i> Kardex Inventario
                                </a>
                            }
                            @if (isadmin || allowedPrivileges.Contains("Productos/Index"))
                            {
                                <a asp-controller="Productos" asp-action="Index" class="list-group-item list-group-item-action @(currentController == "Productos" ? "active" : "")">
                                    <i class="bi bi-box-seam"></i> Productos
                                </a>
                            }
                            @if (isadmin || allowedPrivileges.Contains("Ajustes/Index"))
                            {
                                <a asp-controller="Ajustes" asp-action="Index" class="list-group-item list-group-item-action @(currentController == "Ajustes" ? "active" : "")">
                                    <i class="bi bi-arrow-left-right"></i> Ajustes Stock
                                </a>
                            }
                            @if (isadmin || allowedPrivileges.Contains("Traslados/Index"))
                            {
                                <a asp-controller="Traslados" asp-action="Index" class="list-group-item list-group-item-action @(currentController == "Traslados" ? "active" : "")">
                                    <i class="bi bi-arrow-left-right text-warning"></i> Traslados Bodega
                                </a>
                            }
                        </div>
                    </div>
                }

                <!-- Categoría 3: Compras & Proveedores -->
                @if (showCompras)
                {
                    <div class="sidebar-category">
                        <div class="category-header @(isComprasActive ? "expanded" : "")" data-target="#sub_menu_compras">
                            <i class="bi bi-shop fs-5 me-3 text-info"></i>
                            <span class="fw-semibold text-uppercase tracking-wider">Compras</span>
                            <i class="bi bi-chevron-right ms-auto text-muted category-chevron"></i>
                        </div>
                        <div class="category-body px-2 py-1 border-start ms-3" id="sub_menu_compras" style="display: @(isComprasActive ? "block" : "none"); border-width: 2px !important; border-color: rgba(99, 102, 241, 0.2) !important;">
                            @if (isadmin || allowedPrivileges.Contains("Compras/Index"))
                            {
                                <a asp-controller="Compras" asp-action="Index" class="list-group-item list-group-item-action @(currentController == "Compras" ? "active" : "")">
                                    <i class="bi bi-cart-plus"></i> Compras
                                </a>
                            }
                            @if (isadmin || allowedPrivileges.Contains("Proveedores/Index"))
                            {
                                <a asp-controller="Proveedores" asp-action="Index" class="list-group-item list-group-item-action @(currentController == "Proveedores" ? "active" : "")">
                                    <i class="bi bi-truck"></i> Proveedores
                                </a>
                            }
                            @if (isadmin || allowedPrivileges.Contains("CuentasPorPagar/Index"))
                            {
                                <a asp-controller="CuentasPorPagar" asp-action="Index" class="list-group-item list-group-item-action @(currentController == "CuentasPorPagar" ? "active" : "")">
                                    <i class="bi bi-wallet2 text-success"></i> CxP (Proveedores)
                                </a>
                            }
                        </div>
                    </div>
                }

                <!-- Categoría 4: Clientes -->
                @if (showBancos)
                {
                    <div class="sidebar-category">
                        <div class="category-header @(isBancosActive ? "expanded" : "")" data-target="#sub_menu_bancos">
                            <i class="bi bi-people fs-5 me-3 text-danger"></i>
                            <span class="fw-semibold text-uppercase tracking-wider">Clientes</span>
                            <i class="bi bi-chevron-right ms-auto text-muted category-chevron"></i>
                        </div>
                        <div class="category-body px-2 py-1 border-start ms-3" id="sub_menu_bancos" style="display: @(isBancosActive ? "block" : "none"); border-width: 2px !important; border-color: rgba(99, 102, 241, 0.2) !important;">
                            @if (isadmin || allowedPrivileges.Contains("Clientes/Index"))
                            {
                                <a asp-controller="Clientes" asp-action="Index" class="list-group-item list-group-item-action @(currentController == "Clientes" ? "active" : "")">
                                    <i class="bi bi-people"></i> Clientes
                                </a>
                            }
                        </div>
                    </div>
                }

                <!-- Categoría: Contabilidad -->
                @if (showContabilidad)
                {
                    <div class="sidebar-category">
                        <div class="category-header @(isContabilidadActive ? "expanded" : "")" data-target="#sub_menu_contabilidad">
                            <i class="bi bi-journal-bookmark-fill fs-5 me-3 text-info"></i>
                            <span class="fw-semibold text-uppercase tracking-wider">Contabilidad</span>
                            <i class="bi bi-chevron-right ms-auto text-muted category-chevron"></i>
                        </div>
                        <div class="category-body px-2 py-1 border-start ms-3" id="sub_menu_contabilidad" style="display: @(isContabilidadActive ? "block" : "none"); border-width: 2px !important; border-color: rgba(99, 102, 241, 0.2) !important;">
                            @if (isadmin || allowedPrivileges.Contains("Reportes/EstadoResultados"))
                            {
                                <a asp-controller="Reportes" asp-action="EstadoResultados" class="list-group-item list-group-item-action @(currentController == "Reportes" && currentAction == "EstadoResultados" ? "active" : "")">
                                    <i class="bi bi-file-earmark-bar-graph"></i> Estado Resultados
                                </a>
                            }
                            @if (isadmin || allowedPrivileges.Contains("CuentasContables/Index"))
                            {
                                <a asp-controller="CuentasContables" asp-action="Index" class="list-group-item list-group-item-action @(currentController == "CuentasContables" ? "active" : "")">
                                    <i class="bi bi-list-nested"></i> Catálogo Cuentas
                                </a>
                            }
                            @if (isadmin || allowedPrivileges.Contains("Gastos/Index"))
                            {
                                <a asp-controller="Gastos" asp-action="Index" class="list-group-item list-group-item-action @(currentController == "Gastos" ? "active" : "")">
                                    <i class="bi bi-receipt-cutoff"></i> Registro Gastos
                                </a>
                            }
                            @if (isadmin || allowedPrivileges.Contains("ConfiguracionReporte/Index"))
                            {
                                <a asp-controller="ConfiguracionReporte" asp-action="Index" class="list-group-item list-group-item-action @(currentController == "ConfiguracionReporte" ? "active" : "")">
                                    <i class="bi bi-gear-fill"></i> Config. Reporte
                                </a>
                            }
                        </div>
                    </div>
                }

                <!-- NUEVA Categoría: Catálogos Estáticos y Dinámicos -->
                @if (showCatalogos)
                {
                    <div class="sidebar-category">
                        <div class="category-header @(isCatalogosActive ? "expanded" : "")" data-target="#sub_menu_catalogos">
                            <i class="bi bi-folder2-open fs-5 me-3 text-success"></i>
                            <span class="fw-semibold text-uppercase tracking-wider">Catálogos</span>
                            <i class="bi bi-chevron-right ms-auto text-muted category-chevron"></i>
                        </div>
                        <div class="category-body px-2 py-1 border-start ms-3" id="sub_menu_catalogos" style="display: @(isCatalogosActive ? "block" : "none"); border-width: 2px !important; border-color: rgba(99, 102, 241, 0.2) !important;">
                            @if (isadmin || allowedPrivileges.Contains("Bodegas/Index"))
                            {
