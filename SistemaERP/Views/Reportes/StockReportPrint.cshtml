@model IEnumerable<SistemaERP.Controllers.ReportesController.StockReportRowViewModel>

@{
    Layout = null; // Independent clean printable page
    var p = ViewBag.Parametros as SistemaERP.Models.Entities.ParametrosSistema;
    var fProducto = ViewBag.FilterProducto as string;
    var fLaboratorio = ViewBag.FilterLaboratorio as string;
    var fStockNuevo = ViewBag.FilterStockNuevo as bool? ?? true;

    decimal totalPVF = ViewBag.TotalPVF ?? 0;
    decimal totalPVP = ViewBag.TotalPVP ?? 0;
    decimal totalPVPX = ViewBag.TotalPVPX ?? 0;
    decimal totalUtilidad = ViewBag.TotalUtilidad ?? 0;
    long totalItems = ViewBag.TotalItems ?? 0;
    var simb = (ViewBag.MonedaSimbolo as string) ?? "$";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Reporte de Stock de Inventario</title>
    <!-- Include Bootstrap CSS for layout stability -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
    
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
            background-color: #fff;
            padding: 20px;
            font-size: 0.8rem;
        }
        
        .report-header {
            border-bottom: 2px solid #10b981;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

        .report-title {
            color: #065f46;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 1.5rem;
            margin: 0;
        }

        .report-subtitle {
            color: #6b7280;
            font-size: 0.85rem;
            margin-top: 5px;
        }

        .filter-badge {
            background-color: #f3f4f6;
            border: 1px solid #e5e7eb;
            color: #374151;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 0.75rem;
            display: inline-block;
            margin-right: 5px;
            margin-bottom: 5px;
        }

        .filter-label {
            font-weight: 600;
            color: #4b5563;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.75rem;
        }

        th {
            background-color: #065f46 !important;
            color: #ffffff !important;
            text-transform: uppercase;
            font-weight: 600;
            padding: 8px 6px !important;
            border: 1px solid #dee2e6 !important;
        }

        td {
            padding: 6px 6px !important;
            border: 1px solid #dee2e6 !important;
        }

        .no-print-btn {
            background-color: #10b981;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 0.95rem;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(16, 185, 129, 0.2);
            transition: all 0.2s;
        }

        .no-print-btn:hover {
            background-color: #059669;
            transform: translateY(-1px);
        }

        @@media print {
            .no-print {
                display: none !important;
            }
            body {
                padding: 0;
                margin: 0;
            }
            th {
                background-color: #065f46 !important;
                color: #ffffff !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            tfoot td {
                background-color: #f3f4f6 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body onload="window.print()">

    <!-- Print control bar (hidden in print) -->
    <div class="no-print d-flex justify-content-between align-items-center mb-4 p-3 bg-light border rounded">
        <div>
            <span class="fw-semibold text-secondary"><i class="bi bi-info-circle me-1"></i> Vista de impresión de stock.</span>
        </div>
        <button class="no-print-btn" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Imprimir / Guardar como PDF
        </button>
    </div>

    <!-- Encabezado de Reporte -->
    <div class="report-header row align-items-center">
        <div class="col-8 d-flex align-items-center gap-3">
            @if (p?.ReporteMostrarLogo == true && !string.IsNullOrEmpty(p?.LogoPath))
            {
                <img src="@(p.LogoPath.Split('?')[0])" alt="Logo" style="max-height: 50px; max-width: 140px; object-fit: contain;" />
            }
            <div>
                <h1 class="report-title">Reporte de Stock</h1>
                <p class="report-subtitle">@(p?.ReporteEncabezado ?? "Valorización de existencias, costos y utilidades estimadas.")</p>
            </div>
        </div>
        <div class="col-4 text-end text-secondary small" style="font-size: 0.75rem;">
            <div><strong>Empresa:</strong> @(p?.NombreEmpresa ?? "SCM")</div>
            <div><strong>Fecha Emisión:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
    </div>

    <!-- Detalles de Filtros Aplicados -->
    <div class="mb-3">
        <h5 class="fw-bold mb-2 text-dark" style="font-size: 0.85rem;">Criterios de Filtro:</h5>
        <div class="d-flex flex-wrap gap-1">
            <span class="filter-badge">
                <span class="filter-label">Producto:</span> @(string.IsNullOrEmpty(fProducto) ? "Todos" : fProducto)
            </span>
            <span class="filter-badge">
                <span class="filter-label">Proveedor:</span> @(string.IsNullOrEmpty(fLaboratorio) ? "Todos" : fLaboratorio)
            </span>
            <span class="filter-badge">
                <span class="filter-label">Stock &gt; 0:</span> @(fStockNuevo ? "Sí" : "No")
            </span>
        </div>
    </div>

    <!-- Tabla Principal de Existencias -->
    <table class="table table-bordered table-striped text-center align-middle mb-0">
        <thead>
            <tr>
                <th style="width: 10%; text-align: left;">CÓDIGO</th>
                <th style="width: 25%; text-align: left;">PRODUCTO</th>
                <th style="width: 15%; text-align: left;">PROVEEDOR</th>
                <th style="width: 6%;">DISP</th>
                <th style="width: 7%;">PVF</th>
                <th style="width: 7%;">PVPX</th>
                <th style="width: 8%;">TOPVF</th>
                <th style="width: 8%;">TOPVPX</th>
                <th style="width: 8%;">UTILIDAD</th>
                <th style="width: 6%;">VENCIM.</th>
                @if (ViewBag.CustomFields != null)
                {
                    @foreach (var campo in (ViewBag.CustomFields as List<SistemaERP.Areas.Admin.Models.CampoPersonalizado>).Where(c => c.VisibleEnReporte))
                    {
                        <th style="min-width: 80px;">@campo.Etiqueta</th>
                    }
                }
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-start font-monospace text-secondary" style="font-size: 0.7rem;">@item.CodigoBarra</td>
                        <td class="text-start fw-bold">@item.Nombre</td>
                        <td class="text-start text-muted" style="font-size: 0.7rem;">@item.Proveedor</td>
                        <td class="fw-bold">@item.Disponible</td>
                        <td>@simb@item.PVF.ToString("N2")</td>
                        <td>@simb@item.PVPX.ToString("N2")</td>
                        <td>@simb@item.ToPVF.ToString("N2")</td>
                        <td class="fw-semibold text-dark">@simb@item.ToPVPX.ToString("N2")</td>
                        <td class="fw-bold text-success">@simb@item.Utilidad.ToString("N2")</td>
                        <td class="font-monospace" style="font-size: 0.65rem;">@(item.Vencimiento == "N/A" ? "" : item.Vencimiento)</td>
                        @if (ViewBag.CustomFields != null)
                        {
                            var service = ViewBag.CamposService as SistemaERP.Areas.Admin.Services.ICamposPersonalizadosService;
                            var dict = service.ParseDatosAdicionales(item.DatosAdicionales);
                            @foreach (var campo in (ViewBag.CustomFields as List<SistemaERP.Areas.Admin.Models.CampoPersonalizado>).Where(c => c.VisibleEnReporte))
                            {
                                dict.TryGetValue(campo.NombreCampo, out var val);
                                <td class="text-muted" style="font-size: 0.7rem;">@(val?.ToString() ?? "N/A")</td>
                            }
                        }
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="@(10 + (ViewBag.CustomFields != null ? (ViewBag.CustomFields as List<SistemaERP.Areas.Admin.Models.CampoPersonalizado>).Where(c => c.VisibleEnReporte).Count() : 0))" class="text-center py-4 text-muted">
                        No se encontraron productos para los filtros seleccionados.
                    </td>
                </tr>
            }
        </tbody>
        @if (Model != null && Model.Any())
        {
            <tfoot class="fw-bold" style="border-top: 2px solid #374151;">
                <tr>
                    <td colspan="3" class="text-end py-2">TOTALES:</td>
                    <td class="py-2">@totalItems</td>
                    <td colspan="2"></td>
                    <td class="py-2">@simb@totalPVF.ToString("N2")</td>
                    <td class="py-2">@simb@totalPVPX.ToString("N2")</td>
                    <td class="py-2 text-success">@simb@totalUtilidad.ToString("N2")</td>
                    <td></td>
                    @if (ViewBag.CustomFields != null)
                    {
                        @foreach (var campo in (ViewBag.CustomFields as List<SistemaERP.Areas.Admin.Models.CampoPersonalizado>).Where(c => c.VisibleEnReporte))
                        {
                            <td></td>
                        }
                    }
                </tr>
            </tfoot>
        }
    </table>

    @if (!string.IsNullOrEmpty(p?.ReportePie))
    {
        <div class="mt-4 pt-2 border-top text-center text-muted" style="font-size: 0.7rem;">
            @foreach (var line in p.ReportePie.Split('\n'))
            {
                <div>@line</div>
            }
        </div>
    }

</body>
</html>
