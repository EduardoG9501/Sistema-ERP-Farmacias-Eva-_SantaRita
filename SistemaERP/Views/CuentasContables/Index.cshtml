@model IEnumerable<SistemaERP.Models.Entities.CuentaContable>

@{
    ViewData["Title"] = "Catálogo de Cuentas Contables";
}

<div class="row mb-4 animate__animated animate__fadeIn">
    <div class="col">
        <h2 class="fw-bold mb-1 text-primary"><i class="bi bi-journal-bookmark me-2"></i>Catálogo de Cuentas</h2>
        <p class="text-muted">Gestión de cuentas contables, jerarquías y tipos de cuentas.</p>
    </div>
    <div class="col-auto d-flex gap-2">
        <a asp-controller="ConfiguracionReporte" asp-action="Index" class="btn btn-outline-primary shadow-sm">
            <i class="bi bi-gear me-1"></i> Diseñador de Reporte
        </a>
        <a asp-controller="ConfiguracionReporte" asp-action="Integracion" class="btn btn-outline-success shadow-sm">
            <i class="bi bi-arrow-left-right me-1"></i> Integración Contable
        </a>
        <a asp-action="Create" class="btn btn-premium shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Nueva Cuenta
        </a>
    </div>
</div>

<div class="premium-card animate__animated animate__fadeInUp">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-secondary">
                <tr>
                    <th class="border-0 text-xs text-uppercase py-3" style="width: 150px;">Código</th>
                    <th class="border-0 text-xs text-uppercase py-3">Nombre Cuenta</th>
                    <th class="border-0 text-xs text-uppercase py-3" style="width: 150px;">Tipo</th>
                    <th class="border-0 text-xs text-uppercase py-3" style="width: 120px;">Estado</th>
                    <th class="border-0 text-xs text-uppercase py-3 text-end" style="width: 150px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var isChild = item.IdPadre.HasValue;
                        var indentClass = isChild ? "ps-5" : "fw-bold text-dark";
                        <tr id="row-@item.Id">
                            <td class="font-monospace text-muted @(isChild ? "ps-4" : "fw-bold")">@item.Codigo</td>
                            <td class="@indentClass">
                                @if (!isChild)
                                {
                                    <i class="bi bi-folder-fill text-warning me-2"></i>
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark-text text-muted me-2"></i>
                                }
                                @item.Nombre
                            </td>
                            <td>
                                <span class="badge @(item.Tipo == "Ingreso" ? "bg-info-subtle text-info" : item.Tipo == "Costo" ? "bg-warning-subtle text-warning" : item.Tipo == "Gasto" ? "bg-danger-subtle text-danger" : "bg-secondary-subtle text-secondary") px-3 py-2 rounded-pill">
                                    @item.Tipo
                                </span>
                            </td>
                            <td>
                                @if (item.Activo)
                                {
                                    <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border-0 text-primary me-1" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-light border-0 text-danger" title="Eliminar" onclick="confirmDelete(@item.Id, '@item.Nombre')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                            No hay cuentas contables registradas.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Reportes" asp-action="Index" class="text-decoration-none text-muted fw-medium">
        <i class="bi bi-arrow-left me-1"></i> Volver al Dashboard
    </a>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: "Eliminarás la cuenta '" + name + "'. Se validará que no tenga subcuentas ni transacciones asociadas.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "CuentasContables")',
                        type: 'POST',
                        data: { id: id },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: '¡Eliminada!',
                                    text: response.message,
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                                $("#row-" + id).fadeOut(500);
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'No se pudo procesar la solicitud.', 'error');
                        }
                    });
                }
            })
        }
    </script>
}
