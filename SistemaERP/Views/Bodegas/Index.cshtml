@model IEnumerable<SistemaERP.Models.Entities.Bodega>

@{
    ViewData["Title"] = "Gestión de Bodegas";
}

<div class="row mb-4 animate__animated animate__fadeIn">
    <div class="col-md-4">
        <h2 class="fw-bold mb-1">Bodegas y Almacenes</h2>
        <p class="text-muted">Administre las ubicaciones físicas de sus inventarios.</p>
    </div>
    <div class="col-md-8 text-md-end pt-2 d-flex gap-2 justify-content-end align-items-center">
        <a href="@Url.Action("DescargarPlantilla", "ImportacionMasiva", new { catalogo = "bodegas" })" class="btn btn-outline-primary shadow-sm" title="Descargar Plantilla Excel">
            <i class="bi bi-download me-1"></i> Plantilla
        </a>
        <button type="button" class="btn btn-outline-success shadow-sm" onclick="abrirModalImportacion('bodegas')" title="Cargar Datos desde Excel">
            <i class="bi bi-file-earmark-excel me-1"></i> Cargar Excel
        </button>
        <a asp-action="Create" class="btn btn-premium shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nueva Bodega
        </a>
    </div>
</div>

<div class="premium-card animate__animated animate__fadeInUp">
    <div class="table-responsive">
        <table class="table table-hover align-middle custom-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre de Bodega</th>
                    <th>Dirección</th>
                    <th class="text-center">Principal</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted small">#@item.Id</td>
                        <td class="fw-bold">@item.Nombre</td>
                        <td>@item.Direccion</td>
                        <td class="text-center">
                            @if (item.EsPrincipal)
                            {
                                <span class="badge bg-primary-soft text-primary rounded-pill px-3">
                                    <i class="bi bi-star-fill me-1"></i> Principal
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge @(item.Estado ? "bg-success-soft text-success" : "bg-danger-soft text-danger") rounded-pill px-3">
                                @(item.Estado ? "Activa" : "Inactiva")
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group shadow-sm rounded-3 overflow-hidden">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-white btn-sm px-3" title="Editar">
                                    <i class="bi bi-pencil text-primary"></i>
                                </a>
                                <button type="button" class="btn btn-white btn-sm px-3" onclick="eliminarBodega(@item.Id)" title="Eliminar">
                                    <i class="bi bi-trash text-danger"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@await Html.PartialAsync("_ImportacionMasivaModal")

@section Scripts {
    <script>
        function eliminarBodega(id) {
            Swal.fire({
                title: '¿Está seguro?',
                text: "Esta acción no se puede deshacer.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("Delete", "Bodegas")', { id: id }, function(res) {
                        if (res.success) {
                            Swal.fire('¡Eliminado!', 'La bodega ha sido eliminada.', 'success').then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Error', 'No se pudo eliminar la bodega.', 'error');
                        }
                    });
                }
            })
        }
    </script>
}
