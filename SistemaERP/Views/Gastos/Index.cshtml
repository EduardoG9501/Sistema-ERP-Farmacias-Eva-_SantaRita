@model IEnumerable<SistemaERP.Models.Entities.Gasto>

@{
    ViewData["Title"] = "Registro de Gastos";
    var cuentasGasto = ViewBag.CuentasGasto as List<SistemaERP.Models.Entities.CuentaContable> ?? new List<SistemaERP.Models.Entities.CuentaContable>();
}

<div class="row mb-4 animate__animated animate__fadeIn">
    <div class="col">
        <h2 class="fw-bold mb-1 text-primary"><i class="bi bi-wallet2 me-2"></i>Registro de Gastos</h2>
        <p class="text-muted">Control y registro diario de gastos operativos, administrativos y financieros.</p>
    </div>
    <div class="col-auto">
        <a asp-action="Create" class="btn btn-premium shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Registrar Gasto
        </a>
    </div>
</div>

<div class="premium-card mb-4 p-3 animate__animated animate__fadeIn">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-12 col-sm-3">
            <label class="form-label fw-bold small">Fecha Inicio</label>
            <input type="date" name="desde" class="form-control form-control-sm" value="@ViewBag.Desde" />
        </div>
        <div class="col-12 col-sm-3">
            <label class="form-label fw-bold small">Fecha Fin</label>
            <input type="date" name="hasta" class="form-control form-control-sm" value="@ViewBag.Hasta" />
        </div>
        <div class="col-12 col-sm-4">
            <label class="form-label fw-bold small">Cuenta Contable</label>
            <select name="cuentaId" class="form-select form-select-sm">
                <option value="">Todas las cuentas de gasto...</option>
                @foreach (var c in cuentasGasto)
                {
                    <!option value="@c.Id" @(c.Id == ViewBag.SelectedCuentaId ? "selected" : "")>@c.Codigo - @c.Nombre</!option>
                }
            </select>
        </div>
        <div class="col-12 col-sm-2 d-grid">
            <button type="submit" class="btn btn-sm btn-primary">
                <i class="bi bi-search me-1"></i> Filtrar
            </button>
        </div>
    </form>
</div>

<div class="premium-card animate__animated animate__fadeInUp">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-secondary">
                <tr>
                    <th class="border-0 text-xs text-uppercase py-3" style="width: 120px;">Fecha</th>
                    <th class="border-0 text-xs text-uppercase py-3">Descripción</th>
                    <th class="border-0 text-xs text-uppercase py-3">Cuenta Contable</th>
                    <th class="border-0 text-xs text-uppercase py-3 text-end" style="width: 150px;">Monto</th>
                    <th class="border-0 text-xs text-uppercase py-3 text-end" style="width: 120px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr id="row-@item.Id">
                            <td class="font-monospace text-muted">@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="fw-bold text-dark">@item.Descripcion</div>
                                <div class="text-xs text-muted opacity-75">Reg: @item.UsuarioRegistro (@item.FechaRegistro.ToString("g"))</div>
                            </td>
                            <td>
                                <span class="badge bg-danger-subtle text-danger font-monospace px-2 py-1 rounded">
                                    @(item.CuentaContable?.Codigo ?? "N/A")
                                </span>
                                <span class="fw-semibold text-muted small ms-1">@(item.CuentaContable?.Nombre ?? "N/A")</span>
                            </td>
                            <td class="text-end fw-bold text-danger font-monospace">
                                C$ @item.Monto.ToString("N2")
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border-0 text-primary me-1" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-light border-0 text-danger" title="Eliminar" onclick="confirmDelete(@item.Id, '@item.Descripcion', @item.Monto)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                            No se encontraron gastos registrados en el periodo seleccionado.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Reportes" asp-action="Index" class="text-decoration-none text-muted fw-medium">
        <i class="bi bi-arrow-left me-1"></i> Volver al Dashboard
    </a>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, desc, monto) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: "Eliminarás el gasto '" + desc + "' por valor de C$ " + monto.toFixed(2) + ". Esta acción no se puede deshacer.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Gastos")',
                        type: 'POST',
                        data: { id: id },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: '¡Eliminado!',
                                    text: response.message,
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                                $("#row-" + id).fadeOut(500);
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'No se pudo procesar la solicitud.', 'error');
                        }
                    });
                }
            })
        }
    </script>
}
