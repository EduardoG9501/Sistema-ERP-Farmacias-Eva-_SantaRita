@{
    ViewData["Title"] = "Gestión de Descuentos y Promociones";
    var productosDict = ViewBag.ProductosDict as Dictionary<long, string> ?? new Dictionary<long, string>();
    var productosClasicos = ViewBag.ProductosClasicos as List<SistemaERP.Models.Entities.Producto> ?? new List<SistemaERP.Models.Entities.Producto>();
    var lineas = ViewBag.Lineas as List<SistemaERP.Models.Entities.DescuentoLineaProducto> ?? new List<SistemaERP.Models.Entities.DescuentoLineaProducto>();
    var lineasDetalles = ViewBag.LineasDetalles as List<SistemaERP.Models.Entities.DescuentoLineaProductoDet> ?? new List<SistemaERP.Models.Entities.DescuentoLineaProductoDet>();
    var combos = ViewBag.Combos as List<SistemaERP.Models.Entities.DescuentoCombo> ?? new List<SistemaERP.Models.Entities.DescuentoCombo>();
    var combosDetalles = ViewBag.CombosDetalles as List<SistemaERP.Models.Entities.DescuentoComboProducto> ?? new List<SistemaERP.Models.Entities.DescuentoComboProducto>();
    var especiales = ViewBag.Especiales as List<SistemaERP.Models.Entities.VentaPrecioEspecial> ?? new List<SistemaERP.Models.Entities.VentaPrecioEspecial>();
    
    var descProveedores = ViewBag.DescuentosProveedor as List<SistemaERP.Models.Entities.DescuentoProveedor> ?? new List<SistemaERP.Models.Entities.DescuentoProveedor>();
    var proveedoresList = ViewBag.ProveedoresList as List<SistemaERP.Models.Entities.Proveedor> ?? new List<SistemaERP.Models.Entities.Proveedor>();
    var proveedoresDict = ViewBag.ProveedoresDict as Dictionary<long, string> ?? new Dictionary<long, string>();
}

<div class="container-fluid animate__animated animate__fadeIn">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 bg-indigo-soft text-indigo p-4 rounded-4 shadow-sm">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-1"><i class="bi bi-percent me-2"></i> Módulo de Descuentos y Promociones</h2>
                        <p class="mb-0 opacity-75">Administra los diferentes esquemas de precios y promociones del sistema para aplicación en el POS.</p>
                    </div>
                    <div class="d-none d-md-block">
                        <span class="badge bg-indigo-soft border border-indigo text-indigo fs-6 px-3 py-2 rounded-pill">
                            <i class="bi bi-shield-check me-1"></i> Sistema de Reglas Activas
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs Header -->
    <div class="row mb-4">
        <div class="col-12">
            <ul class="nav nav-pills nav-fill bg-white p-2 rounded-4 shadow-sm border border-light-subtle gap-2" id="discountTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active rounded-3 py-3 fw-semibold transition-all d-flex align-items-center justify-content-center gap-2" id="clasicos-tab" data-bs-toggle="tab" data-bs-target="#clasicos" type="button" role="tab">
                        <i class="bi bi-tag-fill fs-5"></i> 1. Clásico de Productos
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-3 py-3 fw-semibold transition-all d-flex align-items-center justify-content-center gap-2" id="lineas-tab" data-bs-toggle="tab" data-bs-target="#lineas" type="button" role="tab">
                        <i class="bi bi-folder-symlink-fill fs-5"></i> 2. Por Categorías (Porcentajes)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-3 py-3 fw-semibold transition-all d-flex align-items-center justify-content-center gap-2" id="combos-tab" data-bs-toggle="tab" data-bs-target="#combos" type="button" role="tab">
                        <i class="bi bi-boxes fs-5"></i> 3. Combos (Paquetes)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-3 py-3 fw-semibold transition-all d-flex align-items-center justify-content-center gap-2" id="especiales-tab" data-bs-toggle="tab" data-bs-target="#especiales" type="button" role="tab">
                        <i class="bi bi-star-fill fs-5"></i> 4. Precios Especiales
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-3 py-3 fw-semibold transition-all d-flex align-items-center justify-content-center gap-2" id="proveedores-tab" data-bs-toggle="tab" data-bs-target="#proveedores" type="button" role="tab">
                        <i class="bi bi-truck fs-5"></i> 5. Por Proveedores
                    </button>
                </li>
            </ul>
        </div>
    </div>

    <!-- Tabs Content -->
    <div class="tab-content" id="discountTabsContent">
        
        <!-- Tab 1: Clásicos -->
        <div class="tab-pane fade show active" id="clasicos" role="tabpanel">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Descuento Directo por Producto</h4>
                        <p class="text-muted mb-0 small">Asigna porcentajes de descuento específicos por producto con rango de vigencia.</p>
                    </div>
                    <button class="btn btn-primary rounded-pill px-4 py-2" onclick="openNewClasicoModal()">
                        <i class="bi bi-plus-circle me-1"></i> Asignar Descuento a Producto
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle rounded-3 overflow-hidden border border-light-subtle">
                        <thead class="bg-light text-secondary">
                            <tr>
                                <th class="py-3 px-4">Producto</th>
                                <th class="py-3">Descuento (%)</th>
                                <th class="py-3">Vigente Desde</th>
                                <th class="py-3">Vigente Hasta</th>
                                <th class="py-3">Estado</th>
                                <th class="py-3 text-end px-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!productosClasicos.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                        No hay productos con descuentos configurados actualmente.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var p in productosClasicos)
                                {
                                    var estaVigente = p.Descuento_Desde <= DateTime.Today && p.Descuento_Hasta >= DateTime.Today;
                                    <tr>
                                        <td class="fw-medium px-4">@p.Nombre</td>
                                        <td>
                                            <span class="badge bg-danger-soft text-danger fw-bold fs-6">@p.Descuento%</span>
                                        </td>
                                        <td>@(p.Descuento_Desde?.ToString("dd/MM/yyyy") ?? "-")</td>
                                        <td>@(p.Descuento_Hasta?.ToString("dd/MM/yyyy") ?? "-")</td>
                                        <td>
                                            @if (estaVigente)
                                            {
                                                <span class="badge bg-success-soft text-success px-3 py-1.5 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Vigente</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-soft text-warning px-3 py-1.5 rounded-pill"><i class="bi bi-exclamation-triangle-fill me-1"></i> Fuera de Rango</span>
                                            }
                                        </td>
                                        <td class="text-end px-4">
                                            <button class="btn btn-sm btn-primary-soft rounded-circle me-1" onclick="editClasico(@p.Id, @p.Descuento, '@(p.Descuento_Desde?.ToString("yyyy-MM-dd"))', '@(p.Descuento_Hasta?.ToString("yyyy-MM-dd"))')" title="Editar">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger-soft rounded-circle" onclick="deleteClasico(@p.Id)" title="Eliminar">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tab 2: Categorías / Líneas -->
        <div class="tab-pane fade" id="lineas" role="tabpanel">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Descuento Global por Categoría/Línea</h4>
                        <p class="text-muted mb-0 small">Aplica un porcentaje de descuento uniforme a un grupo seleccionado de productos.</p>
                    </div>
                    <button class="btn btn-indigo rounded-pill px-4 py-2" onclick="openNewLineaModal()">
                        <i class="bi bi-plus-circle me-1"></i> Crear Descuento de Línea
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle rounded-3 overflow-hidden border border-light-subtle">
                        <thead class="bg-light text-secondary">
                            <tr>
                                <th class="py-3 px-4">Descripción</th>
                                <th class="py-3">Porcentaje (%)</th>
                                <th class="py-3">Vigencia</th>
                                <th class="py-3">Productos Asociados</th>
                                <th class="py-3">Estado</th>
                                <th class="py-3 text-end px-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!lineas.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                        No hay descuentos de línea registrados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var l in lineas)
                                {
                                    var prodIds = lineasDetalles.Where(d => d.Id_Descuento_Linea == l.Id).Select(d => d.Id_Producto).ToList();
                                    var nombres = prodIds.Select(id => productosDict.ContainsKey(id) ? productosDict[id] : $"Producto #{id}").ToList();
                                    var estaVigente = l.Estado && l.Vence_Desde <= DateTime.Today && l.Vence_Hasta >= DateTime.Today;

                                    <tr>
                                        <td class="fw-bold px-4">@l.Descripcion</td>
                                        <td>
                                            <span class="badge bg-indigo-soft text-indigo fw-bold fs-6">@l.Porcentaje%</span>
                                        </td>
                                        <td>
                                            <span class="small d-block text-muted">Desde: @l.Vence_Desde.ToString("dd/MM/yyyy")</span>
                                            <span class="small d-block text-muted">Hasta: @l.Vence_Hasta.ToString("dd/MM/yyyy")</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-soft text-secondary rounded-pill px-2.5 py-1">@prodIds.Count productos</span>
                                            <button class="btn btn-link btn-sm text-indigo p-0 ms-1 fw-semibold" onclick="verProductosDeLinea('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(l.Descripcion))', @Json.Serialize(nombres))">Ver Lista</button>
                                        </td>
                                        <td>
                                            @if (estaVigente)
                                            {
                                                <span class="badge bg-success-soft text-success px-3 py-1.5 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Vigente</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-soft text-danger px-3 py-1.5 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i> Inactivo / Vencido</span>
                                            }
                                        </td>
                                        <td class="text-end px-4">
                                            <button class="btn btn-sm btn-indigo-soft rounded-circle me-1" onclick="editLinea(@l.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(l.Descripcion))', @l.Porcentaje, '@l.Vence_Desde.ToString("yyyy-MM-dd")', '@l.Vence_Hasta.ToString("yyyy-MM-dd")', @(l.Estado ? "true" : "false"), @Json.Serialize(prodIds))" title="Editar">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger-soft rounded-circle" onclick="deleteLinea(@l.Id)" title="Eliminar">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tab 3: Combos -->
        <div class="tab-pane fade" id="combos" role="tabpanel">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Combos Promocionales (Paquetes)</h4>
                        <p class="text-muted mb-0 small">Agrupa un conjunto de productos para ofrecerlos a un precio consolidado especial.</p>
                    </div>
                    <button class="btn btn-teal rounded-pill px-4 py-2 text-white" onclick="openNewComboModal()">
                        <i class="bi bi-plus-circle me-1"></i> Crear Nuevo Combo
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle rounded-3 overflow-hidden border border-light-subtle">
                        <thead class="bg-light text-secondary">
                            <tr>
                                <th class="py-3 px-4">Descripción Combo</th>
                                <th class="py-3">Precio Combo</th>
                                <th class="py-3">Límites Cant. (Rango)</th>
                                <th class="py-3">Vigencia</th>
                                <th class="py-3">Componentes</th>
                                <th class="py-3">Estado</th>
                                <th class="py-3 text-end px-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!combos.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                        No hay combos registrados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var c in combos)
                                {
                                    var prodIds = combosDetalles.Where(d => d.Id_Descuento_Combo == c.Id).Select(d => d.Id_Producto).ToList();
                                    var nombres = prodIds.Select(id => productosDict.ContainsKey(id) ? productosDict[id] : $"Producto #{id}").ToList();
                                    var estaVigente = c.Estado && c.Vence_Desde <= DateTime.Today && c.Vence_Hasta >= DateTime.Today;

                                    <tr>
                                        <td class="fw-bold px-4 text-teal">@c.Descripcion</td>
                                        <td>
                                            <span class="badge bg-teal-soft text-teal fw-bold fs-6">@ViewBag.MonedaSimbolo@c.Precio_Combo.ToString("N2")</span>
                                        </td>
                                        <td>Min: @c.Cant_Min | Max: @c.Cant_Max</td>
                                        <td>
                                            <span class="small d-block text-muted">Desde: @c.Vence_Desde.ToString("dd/MM/yyyy")</span>
                                            <span class="small d-block text-muted">Hasta: @c.Vence_Hasta.ToString("dd/MM/yyyy")</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-soft text-secondary rounded-pill px-2.5 py-1">@prodIds.Count productos</span>
                                            <button class="btn btn-link btn-sm text-teal p-0 ms-1 fw-semibold" onclick="verProductosDeLinea('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(c.Descripcion))', @Json.Serialize(nombres))">Ver Lista</button>
                                        </td>
                                        <td>
                                            @if (estaVigente)
                                            {
                                                <span class="badge bg-success-soft text-success px-3 py-1.5 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Vigente</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-soft text-danger px-3 py-1.5 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i> Inactivo / Vencido</span>
                                            }
                                        </td>
                                        <td class="text-end px-4">
                                            <button class="btn btn-sm btn-teal-soft rounded-circle me-1" onclick="editCombo(@c.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(c.Descripcion))', @c.Precio_Combo, @c.Cant_Min, @c.Cant_Max, '@c.Vence_Desde.ToString("yyyy-MM-dd")', '@c.Vence_Hasta.ToString("yyyy-MM-dd")', @(c.Estado ? "true" : "false"), @Json.Serialize(prodIds))" title="Editar">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger-soft rounded-circle" onclick="deleteCombo(@c.Id)" title="Eliminar">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tab 4: Especiales -->
        <div class="tab-pane fade" id="especiales" role="tabpanel">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Precios Especiales de Venta</h4>
                        <p class="text-muted mb-0 small">Asigna precios especiales específicos a productos cuando se cumple una cantidad mínima.</p>
                    </div>
                    <button class="btn btn-dark rounded-pill px-4 py-2" onclick="openNewEspecialModal()">
                        <i class="bi bi-plus-circle me-1"></i> Asignar Precio Especial
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle rounded-3 overflow-hidden border border-light-subtle">
                        <thead class="bg-light text-secondary">
                            <tr>
                                <th class="py-3 px-4">Producto</th>
                                <th class="py-3">Precio Especial</th>
                                <th class="py-3">Cantidad Mínima</th>
                                <th class="py-3">Estado</th>
                                <th class="py-3 text-end px-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!especiales.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                        No hay precios especiales registrados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var e in especiales)
                                {
                                    var nombreProd = productosDict.ContainsKey(e.Id_Producto) ? productosDict[e.Id_Producto] : $"Producto #{e.Id_Producto}";
                                    <tr>
                                        <td class="fw-medium px-4">@nombreProd</td>
                                        <td>
                                            <span class="badge bg-dark text-white fw-bold fs-6">@ViewBag.MonedaSimbolo@e.Precio_Especial.ToString("N2")</span>
                                        </td>
                                        <td>@e.Cantidad.ToString("N0") unidades</td>
                                        <td>
                                            @if (e.Estado == "A" || e.Estado == "Activo" || e.Estado == "APROBADO")
                                            {
                                                <span class="badge bg-success-soft text-success px-3 py-1.5 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-soft text-warning px-3 py-1.5 rounded-pill">@e.Estado</span>
                                            }
                                        </td>
                                        <td class="text-end px-4">
                                            <button class="btn btn-sm btn-dark-soft rounded-circle me-1" onclick="editEspecial(@e.Id, @e.Id_Producto, @e.Precio_Especial, @e.Cantidad, '@e.Estado')" title="Editar">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger-soft rounded-circle" onclick="deleteEspecial(@e.Id)" title="Eliminar">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tab 5: Proveedores -->
        <div class="tab-pane fade" id="proveedores" role="tabpanel">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Descuento Global por Proveedor</h4>
                        <p class="text-muted mb-0 small">Aplica un porcentaje de descuento global a todos los productos del proveedor seleccionado.</p>
                    </div>
                    <button class="btn btn-warning text-dark rounded-pill px-4 py-2 fw-semibold" onclick="openNewProveedorModal()">
                        <i class="bi bi-plus-circle me-1"></i> Asignar Descuento a Proveedor
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle rounded-3 overflow-hidden border border-light-subtle">
                        <thead class="bg-light text-secondary">
                            <tr>
                                <th class="py-3 px-4">Proveedor</th>
                                <th class="py-3">Descripción</th>
                                <th class="py-3">Descuento (%)</th>
                                <th class="py-3">Vigencia</th>
                                <th class="py-3">Estado</th>
                                <th class="py-3 text-end px-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!descProveedores.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                        No hay descuentos por proveedor registrados actualmente.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var dp in descProveedores)
                                {
                                    var nombreProv = proveedoresDict.ContainsKey(dp.Id_Proveedor) ? proveedoresDict[dp.Id_Proveedor] : $"Proveedor #{dp.Id_Proveedor}";
                                    var estaVigente = dp.Estado && dp.Vence_Desde <= DateTime.Today && dp.Vence_Hasta >= DateTime.Today;
                                    <tr>
                                        <td class="fw-bold px-4 text-warning-dark">@nombreProv</td>
                                        <td>@dp.Descripcion</td>
                                        <td>
                                            <span class="badge bg-warning-soft text-warning fw-bold fs-6">@dp.Porcentaje%</span>
                                        </td>
                                        <td>
                                            <span class="small d-block text-muted">Desde: @dp.Vence_Desde.ToString("dd/MM/yyyy")</span>
                                            <span class="small d-block text-muted">Hasta: @dp.Vence_Hasta.ToString("dd/MM/yyyy")</span>
                                        </td>
                                        <td>
                                            @if (estaVigente)
                                            {
                                                <span class="badge bg-success-soft text-success px-3 py-1.5 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Vigente</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-soft text-danger px-3 py-1.5 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i> Inactivo / Vencido</span>
                                            }
                                        </td>
                                        <td class="text-end px-4">
                                            <button class="btn btn-sm btn-warning-soft rounded-circle me-1" onclick="editProveedor(@dp.Id, @dp.Id_Proveedor, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(dp.Descripcion))', @dp.Porcentaje, '@dp.Vence_Desde.ToString("yyyy-MM-dd")', '@dp.Vence_Hasta.ToString("yyyy-MM-dd")', @(dp.Estado ? "true" : "false"))" title="Editar">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger-soft rounded-circle" onclick="deleteProveedor(@dp.Id)" title="Eliminar">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

