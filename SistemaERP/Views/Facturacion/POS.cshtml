                `;
                container.html(tableHtml);
            }
            
            updateTotals();
            
            // Update Red Totals Box values
            let totalItems = cart.reduce((s, x) => s + x.cantidad, 0);
            let totalAmount = cart.reduce((s, x) => s + x.precioUnit * x.cantidad, 0);
            
            $('#lblTotalItemsRedBox').text(`${totalItems.toFixed(2)}`);
            $('#lblTotalAmountRedBox').text(`${MONEDA_SIMBOLO}${totalAmount.toFixed(2)}`);

            // Disable / Enable payment button
            if (hasStockIssues) {
                $('#btnPay').attr('disabled', 'disabled').css('background-color', '#94a3b8');
                $('#btnPay').html('<i class="bi bi-exclamation-octagon-fill me-1"></i> SIN STOCK');
            } else {
                $('#btnPay').removeAttr('disabled').css('background-color', '#b91c1c');
                $('#btnPay').html('<i class="bi bi-check-circle-fill me-1"></i> COBRAR (F2)');
