@{
    ViewData["Title"] = "Auditoría de Cierre de Caja";
    var moneda = ViewBag.MonedaSimbolo ?? "$";
    var usuarios = ViewBag.Usuarios as List<SistemaERP.Models.Entities.Usuario> ?? new List<SistemaERP.Models.Entities.Usuario>();
    var selectedUser = (int)ViewBag.SelectedUsuarioId;
    var fechaStr = ViewBag.Fecha as string;
    
    var cierre = ViewBag.Cierre as SistemaERP.Models.Entities.CierreCaja;
    var denomList = ViewBag.Denominaciones as List<SistemaERP.Models.Entities.Denominacion> ?? new List<SistemaERP.Models.Entities.Denominacion>();
    var transacciones = ViewBag.Transacciones as List<SistemaERP.Controllers.ReportesController.CierreDetalleTransViewModel> ?? new List<SistemaERP.Controllers.ReportesController.CierreDetalleTransViewModel>();

    // Cálculos de Totales para el Sidebar
    decimal apCajaVal = 0;
    decimal countedEfectivoVal = 0;
    decimal diferenciaVal = 0;
    decimal sistemaEfectivo = 0;
    decimal egresosVal = 0;
    decimal otrosPagosVal = 0;

    var apertura = ViewBag.Apertura as SistemaERP.Models.Entities.AperturaCaja;
    decimal efectivoVentas = transacciones.Where(t => t.TipoPago == "EFECTIVO").Sum(t => t.TotalPagar);

    if (cierre != null)
    {
        apCajaVal = cierre.Apertura?.MontoInicial ?? 0;
        countedEfectivoVal = cierre.MontoFinal;
        diferenciaVal = countedEfectivoVal - efectivoVentas; // Dynamic difference (Counted Cash - Cash Sales)
        sistemaEfectivo = apCajaVal + efectivoVentas; // Expected total including Aperture
        otrosPagosVal = transacciones.Where(t => t.TipoPago != "EFECTIVO").Sum(t => t.TotalPagar);
    }
    else
    {
        apCajaVal = apertura?.MontoInicial ?? 0;
        countedEfectivoVal = 0;
        diferenciaVal = 0;
        sistemaEfectivo = apCajaVal + efectivoVentas;
        otrosPagosVal = transacciones.Where(t => t.TipoPago != "EFECTIVO").Sum(t => t.TotalPagar);
    }

    decimal sobrante = diferenciaVal > 0 ? diferenciaVal : 0;
    decimal faltante = diferenciaVal < 0 ? -diferenciaVal : 0;
}

