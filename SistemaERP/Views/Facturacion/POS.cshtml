                optionsHtml += '<option value="1">PRODUBANCO</option><option value="2">BANCO PICHINCHA</option><option value="3">BANCO GUAYAQUIL</option><option value="4">BANCO PACIFICO</option>';
            }
            $('#ddlTarjetaBanco').html(optionsHtml);
            $('#ddlChequeBanco').html(optionsHtml);
            $('#ddlTransferenciaBanco').html(optionsHtml);
        }

        async function procesarFinalizacion() {
            if (!cart || !cart.length) {
                toastr.warning('El carrito est\u00E1 vac\u00EDo.');
                return;
            }

            // Validar si hay alertas de stock en el carrito
            let hasStockError = $('.stock-warning-row').length > 0;
            if (hasStockError) {
                Swal.fire('Atenci\u00F3n', 'Hay productos sin stock suficiente en las bodegas elegidas. Corrija las cantidades o bodegas antes de cobrar.', 'warning');
                return;
            }

            let total       = cart.reduce((s, x) => s + x.precioUnit * x.cantidad, 0);
            let clienteId   = parseInt($('#ddlCliente').val());
            let clienteNom  = ($('#ddlCliente option:selected').data('nombre') || '').toUpperCase();
            let esCF        = clienteNom.includes('CONSUMIDOR FINAL');

            // 1. Validar si se necesitan datos del CF para el SRI
            let clienteExtra = null;
            if (ACTIVAR_SRI && esCF && total >= MONTO_MIN_CF) {
                const { value: datos, isConfirmed } = await Swal.fire({
                    title: '<i class="bi bi-person-fill-exclamation text-warning me-2"></i> Datos del Comprador Requeridos',
                    html: `
                        <div class="text-start">
                            <div class="alert alert-warning border-0 mb-3" style="font-size:0.85rem">
                                <i class="bi bi-info-circle me-1"></i>
                                El monto <strong>${MONEDA_SIMBOLO}${total.toFixed(2)}</strong> supera el l\u00EDmite de <strong>${MONEDA_SIMBOLO}${MONTO_MIN_CF}</strong>.
                                El SRI requiere los datos del comprador.
                            </div>
                            <div class="mb-2">
                                <label class="form-label fw-bold small">Nombre / Raz\u00F3n Social *</label>
                                <input id="cfNombre" type="text" class="form-control" placeholder="Nombre completo del comprador">
                            </div>
                            <div class="mb-2">
                                <label class="form-label fw-bold small">C\u00E9dula / RUC *</label>
                                <input id="cfCedula" type="text" class="form-control" placeholder="0000000000 (10 o 13 d\u00EDgitos)" maxlength="13">
                            </div>
                            <div class="mb-2">
                                <label class="form-label fw-bold small">Direcci\u00F3n</label>
                                <input id="cfDireccion" type="text" class="form-control" placeholder="Direcci\u00F3n del comprador">
                            </div>
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonText: 'Confirmar y Continuar',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#4f46e5',
                    allowOutsideClick: false,
                    preConfirm: () => {
                        const nombre   = document.getElementById('cfNombre').value.trim();
                        const cedula   = document.getElementById('cfCedula').value.trim();
                        const dir      = document.getElementById('cfDireccion').value.trim();
                        if (!nombre) { Swal.showValidationMessage('El nombre es obligatorio'); return false; }
                        if (!cedula || (cedula.length !== 10 && cedula.length !== 13)) {
                            Swal.showValidationMessage('La c\u00E9dula/RUC debe tener 10 o 13 d\u00EDgitos'); return false;
                        }
                        return { nombre, cedula, direccion: dir || 'S/N' };
                    }
                });

                if (!isConfirmed) return;
                clienteExtra = datos;
            }

            // Abrir el modal de multi-pago
            openPaymentModal(total, clienteId, clienteNom, clienteExtra);
        }

        window._paymentClienteExtra = null;
        window._paymentClienteId = 0;

        function openPaymentModal(total, clienteId, clienteNom, clienteExtra) {
            window._paymentClienteId = clienteId;
            window._paymentClienteExtra = clienteExtra;
            paymentTotal = total;
            addedPayments = [];

            $('#lblPayCliente').val(clienteNom);
            $('#lblPayTotalFactura').text(`${MONEDA_SIMBOLO}${total.toFixed(2)}`);
            $('#lblContadoTotal').text(`${MONEDA_SIMBOLO}${total.toFixed(2)}`);

            populateBankDropdowns();
            
            // Set default payment type as CONTADO
            $('#ddlPayTipoPago').val('CONTADO');
            
            // Set date for check picker
            let todayStr = new Date().toISOString().substring(0, 10);
            $('#txtChequeFecha').val(todayStr);

            changePaymentType();
            clearChequePreview();
            renderPaymentGrid();
            
            // Show modal using hybrid Bootstrap controller
            showBootstrapModal('modalPagarVenta');
        }

        function changePaymentType() {
            let type = $('#ddlPayTipoPago').val();
            $('.payment-panel').addClass('d-none');
            
            let paidSum = addedPayments.reduce((s, x) => s + x.monto, 0);
            paymentRemaining = Math.max(0, paymentTotal - paidSum);

            if (type === 'CONTADO') {
                $('#panelContado').removeClass('d-none');
                $('#txtContadoMonto').val(paymentRemaining.toFixed(2)).select().focus();
                calculateContadoChange();
            } else if (type === 'TARJETA DE CREDITO') {
                $('#panelTarjeta').removeClass('d-none');
                $('#txtTarjetaMonto').val(paymentRemaining.toFixed(2)).select().focus();
                $('#txtTarjetaRef').val('');
                $('#txtTarjetaAdquirente').val('');
                $('#txtTarjetaInteres').val('0.00');
            } else if (type === 'CHEQUE') {
                $('#panelCheque').removeClass('d-none');
                $('#txtChequeMonto').val(paymentRemaining.toFixed(2)).select().focus();
                $('#txtChequeNum').val('');
                clearChequePreview();
            } else if (type === 'CREDITO') {
                $('#panelCredito').removeClass('d-none');
                $('#txtCreditoMonto').val(paymentRemaining.toFixed(2)).select().focus();
                $('#txtCreditoDias').val('30');
                calculateCreditoDueDate();
            } else if (type === 'TRANSFERENCIA') {
                $('#panelTransferencia').removeClass('d-none');
                $('#txtTransferenciaMonto').val(paymentRemaining.toFixed(2)).select().focus();
                $('#txtTransferenciaRef').val('');
            }
            
            updatePaymentCalculations();
        }

        function calculateContadoChange() {
            let cashVal = parseFloat($('#txtContadoMonto').val()) || 0;
            let paidSum = addedPayments.reduce((s, x) => s + x.monto, 0);
            let remaining = Math.max(0, paymentTotal - paidSum);
            let change = Math.max(0, cashVal - remaining);
            
            $('#lblContadoEntrega').text(`${MONEDA_SIMBOLO}${cashVal.toFixed(2)}`);
            $('#lblContadoCambio').text(`${MONEDA_SIMBOLO}${change.toFixed(2)}`);
        }

        function calculateCreditoDueDate() {
            let days = parseInt($('#txtCreditoDias').val()) || 30;
            if (days < 1) { days = 1; $('#txtCreditoDias').val(1); }
            let d = new Date();
            d.setDate(d.getDate() + days);
            let dd = String(d.getDate()).padStart(2, '0');
            let mm = String(d.getMonth() + 1).padStart(2, '0');
            let yyyy = d.getFullYear();
            $('#lblCreditoFechaPago').text(`${dd}/${mm}/${yyyy}`);
        }

        window._chequeImageBase64 = "";

        function previewChequeImage(event) {
            let input = event.target;
            if (input.files && input.files[0]) {
                let r = new FileReader();
                r.onload = function(e) {
                    $('#chequePreviewArea').removeClass('d-none');
                    $('#imgChequePreview').attr('src', e.target.result);
                    window._chequeImageBase64 = e.target.result;
                };
                r.readAsDataURL(input.files[0]);
            }
        }

        function clearChequePreview() {
            $('#chequePreviewArea').addClass('d-none');
            $('#imgChequePreview').attr('src', '');
            $('#fileChequeImagen').val('');
            window._chequeImageBase64 = "";
        }

        function addPaymentMethod(type) {
            let paidSum = addedPayments.reduce((s, x) => s + x.monto, 0);
            let remaining = paymentTotal - paidSum;
            
            if (remaining <= 0.005) {
                toastr.warning('El saldo a pagar ya est\u00E1 completamente cubierto.');
                return;
            }

            let monto = 0;
            let details = "";
            let paymentObj = {
                metodo: type,
                monto: 0,
                referencia: "",
                idBanco: null,
                adquirente: "",
                interes: 0,
                diasCredito: null,
                imagenCheque: ""
            };

            if (type === 'CONTADO') {
                let cashVal = parseFloat($('#txtContadoMonto').val()) || 0;
                if (cashVal <= 0) { toastr.error('Ingrese un monto v\u00E1lido.'); return; }
                
                // Cap cash payment at remaining balance
                monto = Math.min(cashVal, remaining);
                paymentObj.monto = parseFloat(monto.toFixed(2));
                details = "Efectivo Recibido: " + MONEDA_SIMBOLO + cashVal.toFixed(2);
                if (cashVal > remaining) {
                    details += " (Vuelto: " + MONEDA_SIMBOLO + (cashVal - remaining).toFixed(2) + ")";
                }
            }
            else if (type === 'TARJETA DE CREDITO') {
                monto = parseFloat($('#txtTarjetaMonto').val()) || 0;
                let ref = $('#txtTarjetaRef').val().trim();
                let bancoId = parseInt($('#ddlTarjetaBanco').val());
                let bancoNom = $('#ddlTarjetaBanco option:selected').text();
                let adquirente = $('#txtTarjetaAdquirente').val().trim();
                let interes = parseFloat($('#txtTarjetaInteres').val()) || 0;

                if (monto <= 0) { toastr.error('Ingrese un monto v\u00E1lido.'); return; }
                if (monto > remaining + 0.005) {
                    toastr.error('El monto no puede superar el saldo pendiente de ' + MONEDA_SIMBOLO + remaining.toFixed(2));
                    return;
                }
                if (!ref) { toastr.error('N\u00FAmero de referencia es obligatorio.'); return; }
                if (!bancoId) { toastr.error('Debe seleccionar un banco.'); return; }
                if (!adquirente) { toastr.error('El adquirente es obligatorio.'); return; }

                paymentObj.monto = parseFloat(monto.toFixed(2));
                paymentObj.referencia = ref;
                paymentObj.idBanco = bancoId;
                paymentObj.adquirente = adquirente;
                paymentObj.interes = interes;
                details = `Ref: ${ref} | Banco: ${bancoNom} | Adq: ${adquirente} | Int: ${interes.toFixed(2)}`;
            }
            else if (type === 'CHEQUE') {
                monto = parseFloat($('#txtChequeMonto').val()) || 0;
                let num = $('#txtChequeNum').val().trim();
                let bancoId = parseInt($('#ddlChequeBanco').val());
                let bancoNom = $('#ddlChequeBanco option:selected').text();
                let fecha = $('#txtChequeFecha').val();

                if (monto <= 0) { toastr.error('Ingrese un monto v\u00E1lido.'); return; }
                if (monto > remaining + 0.005) {
                    toastr.error('El monto no puede superar el saldo pendiente de ' + MONEDA_SIMBOLO + remaining.toFixed(2));
                    return;
                }
                if (!num) { toastr.error('El n\u00FAmero de cheque es obligatorio.'); return; }
                if (!bancoId) { toastr.error('Debe seleccionar un banco.'); return; }
                if (!fecha) { toastr.error('La fecha de cobro es obligatoria.'); return; }

                paymentObj.monto = parseFloat(monto.toFixed(2));
                paymentObj.referencia = `${num} (Fecha: ${fecha})`;
                paymentObj.idBanco = bancoId;
                paymentObj.imagenCheque = window._chequeImageBase64;
                details = `Nro: ${num} | Banco: ${bancoNom} | Cobro: ${fecha}`;
            }
            else if (type === 'CREDITO') {
                monto = parseFloat($('#txtCreditoMonto').val()) || 0;
                let days = parseInt($('#txtCreditoDias').val()) || 30;

                if (monto <= 0) { toastr.error('Ingrese un monto v\u00E1lido.'); return; }
                if (monto > remaining + 0.005) {
                    toastr.error('El monto no puede superar el saldo pendiente de ' + MONEDA_SIMBOLO + remaining.toFixed(2));
                    return;
                }

                paymentObj.monto = parseFloat(monto.toFixed(2));
                paymentObj.diasCredito = days;
                details = `Plazo: ${days} d\u00EDas (Vence: ${$('#lblCreditoFechaPago').text()})`;
            }
            else if (type === 'TRANSFERENCIA') {
                monto = parseFloat($('#txtTransferenciaMonto').val()) || 0;
                let ref = $('#txtTransferenciaRef').val().trim();
                let bancoId = parseInt($('#ddlTransferenciaBanco').val());
                let bancoNom = $('#ddlTransferenciaBanco option:selected').text();

                if (monto <= 0) { toastr.error('Ingrese un monto v\u00E1lido.'); return; }
                if (monto > remaining + 0.005) {
                    toastr.error('El monto no puede superar el saldo pendiente de ' + MONEDA_SIMBOLO + remaining.toFixed(2));
                    return;
                }
                if (!ref) { toastr.error('N\u00FAmero de referencia es obligatorio.'); return; }
                if (!bancoId) { toastr.error('Debe seleccionar un banco.'); return; }

                paymentObj.monto = parseFloat(monto.toFixed(2));
                paymentObj.referencia = ref;
                paymentObj.idBanco = bancoId;
                details = `Ref: ${ref} | Banco: ${bancoNom}`;
            }

            addedPayments.push(paymentObj);
            toastr.success(`Forma de pago ${type} agregada correctamente.`);
            
            // Clean dynamic fields
            $('#txtTarjetaRef').val('');
            $('#txtTarjetaAdquirente').val('');
            $('#txtTarjetaInteres').val('0.00');
            $('#txtChequeNum').val('');
            clearChequePreview();
            $('#txtTransferenciaRef').val('');

            renderPaymentGrid();
            
            // Set next default amount
            let newPaidSum = addedPayments.reduce((s, x) => s + x.monto, 0);
            let newRemaining = Math.max(0, paymentTotal - newPaidSum);
            
            $('#txtContadoMonto').val(newRemaining.toFixed(2));
            $('#txtTarjetaMonto').val(newRemaining.toFixed(2));
            $('#txtChequeMonto').val(newRemaining.toFixed(2));
            $('#txtCreditoMonto').val(newRemaining.toFixed(2));
            $('#txtTransferenciaMonto').val(newRemaining.toFixed(2));
            
            calculateContadoChange();
        }

        function removePaymentMethod(index) {
            addedPayments.splice(index, 1);
            toastr.info('Forma de pago eliminada de la lista.');
            renderPaymentGrid();

            let newPaidSum = addedPayments.reduce((s, x) => s + x.monto, 0);
            let newRemaining = Math.max(0, paymentTotal - newPaidSum);
            
            $('#txtContadoMonto').val(newRemaining.toFixed(2));
            $('#txtTarjetaMonto').val(newRemaining.toFixed(2));
            $('#txtChequeMonto').val(newRemaining.toFixed(2));
            $('#txtCreditoMonto').val(newRemaining.toFixed(2));
            $('#txtTransferenciaMonto').val(newRemaining.toFixed(2));
            
            calculateContadoChange();
        }

        function clearSelectedPayments() {
            addedPayments = [];
            toastr.info('Listado de pagos limpiado.');
            renderPaymentGrid();

            $('#txtContadoMonto').val(paymentTotal.toFixed(2));
            $('#txtTarjetaMonto').val(paymentTotal.toFixed(2));
            $('#txtChequeMonto').val(paymentTotal.toFixed(2));
            $('#txtCreditoMonto').val(paymentTotal.toFixed(2));
            $('#txtTransferenciaMonto').val(paymentTotal.toFixed(2));
            
            calculateContadoChange();
        }

        function renderPaymentGrid() {
            let tbody = $('#tblPaymentGrid tbody');
            tbody.empty();
            
            if (!addedPayments.length) {
                tbody.html('<tr><td colspan="4" class="text-center py-4 text-muted"><i class="bi bi-info-circle me-1"></i>No ha agregado ninguna forma de pago todav\u00EDa.</td></tr>');
                $('#lblPayGridCount').text('Total Items: 0');
                updatePaymentCalculations();
                return;
            }

            $('#lblPayGridCount').text(`Total Items: ${addedPayments.length}`);

            addedPayments.forEach((p, idx) => {
                let detailText = "";
                if (p.metodo === 'CONTADO') {
                    detailText = `Efectivo`;
                } else if (p.metodo === 'TARJETA DE CREDITO') {
                    let bankNom = $(`#ddlTarjetaBanco option[value="${p.idBanco}"]`).text() || `Banco #${p.idBanco}`;
                    detailText = `Ref: ${p.referencia} | Banco: ${bankNom}`;
                } else if (p.metodo === 'CHEQUE') {
                    let bankNom = $(`#ddlChequeBanco option[value="${p.idBanco}"]`).text() || `Banco #${p.idBanco}`;
                    detailText = `Nro: ${p.referencia} | Banco: ${bankNom}`;
                } else if (p.metodo === 'CREDITO') {
                    detailText = `Cr\u00E9dito: ${p.diasCredito} d\u00EDas`;
                } else if (p.metodo === 'TRANSFERENCIA') {
                    let bankNom = $(`#ddlTransferenciaBanco option[value="${p.idBanco}"]`).text() || `Banco #${p.idBanco}`;
                    detailText = `Ref: ${p.referencia} | Banco: ${bankNom}`;
                }

                tbody.append(`
                    <tr>
                        <td class="ps-3 py-2 fw-semibold text-primary"><i class="bi bi-check2-circle me-1"></i>${p.metodo}</td>
                        <td class="py-2 fw-bold text-dark">${MONEDA_SIMBOLO}${p.monto.toFixed(2)}</td>
                        <td class="py-2 text-muted small">${detailText}</td>
                        <td class="text-center py-2">
                            <button type="button" class="btn btn-outline-danger btn-sm p-0 rounded-circle" style="width:24px; height:24px; line-height:22px;" onclick="removePaymentMethod(${idx})">
                                <i class="bi bi-x"></i>
                            </button>
                        </td>
                    </tr>
                `);
            });

            updatePaymentCalculations();
        }

        function updatePaymentCalculations() {
            let paidSum = addedPayments.reduce((s, x) => s + x.monto, 0);
            let remaining = paymentTotal - paidSum;
            
            $('#lblPayTotalPagado').text(`${MONEDA_SIMBOLO}${paidSum.toFixed(2)}`);
            
            let statusDiv = document.getElementById('payStatusAlert');
            let confirmBtn = document.getElementById('btnPayConfirm');

            if (remaining <= 0.005) {
                statusDiv.className = "alert alert-success border-0 text-center fw-bold rounded-3 m-0 py-2 animate__animated animate__pulse";
                statusDiv.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> Pago Completado (${MONEDA_SIMBOLO}${paidSum.toFixed(2)})`;
                confirmBtn.removeAttribute('disabled');
            } else {
                statusDiv.className = "alert alert-warning border-0 text-center fw-bold rounded-3 m-0 py-2";
                statusDiv.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-1"></i> Falta por pagar: ${MONEDA_SIMBOLO}${remaining.toFixed(2)}`;
                confirmBtn.setAttribute('disabled', 'true');
            }
        }

        function confirmarGuardarVenta() {
            let paidSum = addedPayments.reduce((s, x) => s + x.monto, 0);
            if (paidSum < paymentTotal - 0.005) {
                toastr.error('El monto total cobrado es insuficiente.');
                return;
            }

            // Close bootstrap modal first
            let modalEl = document.getElementById('modalPagarVenta');
            if (modalEl) {
                let modalInstance = bootstrap.Modal.getInstance(modalEl);
                if (modalInstance) modalInstance.hide();
            }

            // Parse payments in compatible structure for old fallback fields or new ones
            // Find main payment method for fallback
            let mainMetodo = "01";
            let mainReferencia = "";
            let mainMontoCredito = 0;
            let mainDiasCredito = 30;

            addedPayments.forEach(p => {
                if (p.metodo === 'TARJETA DE CREDITO') { mainMetodo = "19"; mainReferencia = p.referencia; }
                else if (p.metodo === 'TRANSFERENCIA') { mainMetodo = "20"; mainReferencia = p.referencia; }
                else if (p.metodo === 'CREDITO') { mainMontoCredito = p.monto; mainDiasCredito = p.diasCredito; }
            });

            let oldPagoStructure = {
                metodo: mainMetodo,
                recibido: paidSum,
                cambio: 0,
                referencia: mainReferencia,
                montoCredito: mainMontoCredito,
                diasCredito: mainDiasCredito
            };

            // Call finalize with new parameters
            finalizarVenta(window._paymentClienteId, window._paymentClienteExtra, oldPagoStructure, addedPayments);
        }

        function setupPaymentInputEnterHandlers() {
            const modalInputs = [
                '#txtContadoMonto',
                '#txtTarjetaRef', '#txtTarjetaAdquirente', '#txtTarjetaInteres', '#txtTarjetaMonto',
                '#txtChequeNum', '#txtChequeMonto',
                '#txtCreditoDias', '#txtCreditoMonto',
                '#txtTransferenciaRef', '#txtTransferenciaMonto'
            ];

            modalInputs.forEach(selector => {
                $(document).on('keydown', selector, function(e) {
                    if (e.which === 13 || e.keyCode === 13) {
                        e.preventDefault();
                        let currentType = $('#ddlPayTipoPago').val();
                        
                        // Agregar forma de pago
                        addPaymentMethod(currentType);
                        
                        // Si se complet\u00F3 el cobro, guardar autom\u00E1ticamente la venta
                        let paidSum = addedPayments.reduce((s, x) => s + x.monto, 0);
                        let remaining = paymentTotal - paidSum;
                        if (remaining <= 0.005) {
                            confirmarGuardarVenta();
                        }
                    }
                });
            });
        }

        function finalizarVenta(clienteId, clienteExtra, pago, pagosList) {
            let data = {
                idCliente: clienteId,
                clienteExtra: clienteExtra,
                pago: pago,
                pagos: pagosList || [],
                detalles: cart.map(x => ({
                    idProducto:     x.idProducto,
                    nombreProducto: x.nombreProducto,
                    cantidad:       x.cantidad,
                    precio:         x.precioUnit,
                    subtotal:       parseFloat((x.precioUnit * x.cantidad / (1 + x.ivaRate)).toFixed(2)),
                    iva:            parseFloat((x.precioUnit * x.cantidad * x.ivaRate / (1 + x.ivaRate)).toFixed(2)),
                    total:          parseFloat((x.precioUnit * x.cantidad).toFixed(2)),
                    esCaja:         x.esCaja,
                    idBodega:       x.idBodega
                }))
            };

            Swal.fire({ title: 'Procesando Venta...', didOpen: () => Swal.showLoading(), allowOutsideClick: false });

            $.ajax({
                url: '@Url.Action("FinalizarVenta", "Facturacion")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(res) {
                    if (res.success) {
                        if (ACTIVAR_SRI) {
                            Swal.fire({
                                title: '\u00A1Venta Guardada!',
                                html: `<p>Venta #<strong>${res.idVenta}</strong> procesada correctamente.</p><h5>\u00BFDesea enviar esta factura al SRI ahora mismo?</h5>`,
                                icon: 'success',
                                showCancelButton: true,
                                confirmButtonText: '<i class="bi bi-send-check me-1"></i> S\u00ED, Enviar al SRI',
                                cancelButtonText: 'No, Guardar y enviar luego',
                                confirmButtonColor: '#10b981',
                                cancelButtonColor: '#6c757d',
                                allowOutsideClick: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    // Procesar env\u00EDo al SRI
                                    Swal.fire({
                                        title: 'Enviando al SRI...',
                                        html: 'Generando XML, firmando y transmitiendo de forma segura...',
                                        allowOutsideClick: false,
                                        didOpen: () => Swal.showLoading()
                                    });

                                    $.get('@Url.Action("TransmitirSRI", "Facturacion")?id=' + res.idVenta, function(sriRes) {
                                        Swal.close();
                                        if (sriRes.success) {
                                            Swal.fire({
                                                title: '\u00A1Factura Procesada!',
                                                text: sriRes.message,
                                                icon: 'success',
                                                confirmButtonText: 'Aceptar'
                                            }).then(() => {
                                                window.open('@Url.Action("Ticket", "Facturacion")/' + res.idVenta, '_blank');
                                                location.reload();
                                            });
                                        } else {
                                            Swal.fire({
                                                title: 'Advertencia del SRI',
                                                html: `<p class="text-danger fw-bold">La venta se guard\u00F3, pero hubo un error al transmitir al SRI:</p><p class="text-muted small">${sriRes.message}</p>`,
                                                icon: 'warning',
                                                confirmButtonText: 'Entendido'
                                            }).then(() => {
                                                window.open('@Url.Action("Ticket", "Facturacion")/' + res.idVenta, '_blank');
                                                location.reload();
                                            });
                                        }
                                    }).fail(function() {
                                        Swal.close();
                                        Swal.fire({
                                            title: 'Error de Conexi\u00F3n',
                                            text: 'La venta se guard\u00F3, pero no se pudo contactar al servicio del SRI. Puede retransmitir desde el historial.',
                                            icon: 'error',
                                            confirmButtonText: 'Entendido'
                                        }).then(() => {
                                            window.open('@Url.Action("Ticket", "Facturacion")/' + res.idVenta, '_blank');
                                            location.reload();
                                        });
                                    });
                                } else {
                                    // Usuario eligi\u00F3 "No"
                                    window.open('@Url.Action("Ticket", "Facturacion")/' + res.idVenta, '_blank');
                                    location.reload();
                                }
                            });
                        } else {
                            // Envi\u00F3 SRI desactivado en par\u00E1metros
                            Swal.fire({
                                title: '\u00A1Venta Exitosa!',
                                html: `<p>Venta #<strong>${res.idVenta}</strong> procesada correctamente.</p>`,
                                icon: 'success',
                                confirmButtonText: 'Imprimir Ticket y Continuar'
                            }).then(() => {
                                window.open('@Url.Action("Ticket", "Facturacion")/' + res.idVenta, '_blank');
                                location.reload();
                            });
                        }
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                },
                error: function() {
                    Swal.fire('Error de Conexi\u00F3n', 'No se pudo conectar con el servidor.', 'error');
                }
            });
        }

        function showBootstrapModal(id) {
            let modalEl = document.getElementById(id);
            if (!modalEl) return;
            
            // 1. Intentar con Vanilla JS Bootstrap 5 (est\u00E1ndar moderno)
            if (window.bootstrap && window.bootstrap.Modal) {
                let modalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modalInstance.show();
            } 
            // 2. Intentar con jQuery Bootstrap 3/4
            else if ($(modalEl).modal) {
                $(modalEl).modal('show');
            } 
            // 3. Fallback directo en DOM y CSS si todo lo dem\u00E1s falla
            else {
                $(modalEl).addClass('show').css('display', 'block');
                $('body').addClass('modal-open').append('<div class="modal-backdrop fade show"></div>');
            }
        }

        function hideBootstrapModal(id) {
            let modalEl = document.getElementById(id);
            if (!modalEl) return;
            if (window.bootstrap && window.bootstrap.Modal) {
                let modalInstance = bootstrap.Modal.getInstance(modalEl);
                if (modalInstance) {
                    modalInstance.hide();
                } else {
                    let m = bootstrap.Modal.getOrCreateInstance(modalEl);
                    m.hide();
                }
            } else if ($(modalEl).modal) {
                $(modalEl).modal('hide');
            } else {
                $(modalEl).removeClass('show').css('display', 'none');
                $('.modal-backdrop').remove();
                $('body').removeClass('modal-open');
            }
        }
        window.hideBootstrapModal = hideBootstrapModal;

        // openSearchModal: usada por atajo F1 y cualquier llamada program\u00E1tica
        window.openSearchModal = function() {
            var modalEl = document.getElementById('modalBuscarProductos');
            if (!modalEl) return;
            var m = bootstrap.Modal.getOrCreateInstance(modalEl);
            m.show();
        };

        window.posSearchInput = function(value) {
            var query = (value || '').toLowerCase().trim();
            if (query) {
                // Verificar si existe una coincidencia exacta por c\u00F3digo de barra para agregar directo
                var p = productosList.find(function(x) {
                    return (x.codigoBarra || '').trim().toLowerCase() === query;
                });
                if (p) {
                    var inp = document.getElementById('txtModalSearch');
                    if (inp) inp.value = '';
                    selectProductFromModal(p.id, defaultBodegaId, 'U');
                    return;
                }
            }
            if (!query) { renderModalResults([]); return; }
            var words = query.split(/\s+/);
            var matches = productosList.filter(function(p) {
                var name = (p.nombre || '').toLowerCase();
                var code = (p.codigoBarra || '').toLowerCase();
                return words.every(function(w) { return name.includes(w) || code.includes(w); });
            });
            renderModalResults(matches.slice(0, 50));
        };

        window.posSearchKeydown = function(e) {
            if (e.key === 'Enter' || e.which === 13) {
                e.preventDefault();
                var inp = document.getElementById('txtModalSearch');
                var val = (inp ? inp.value : '').trim().toLowerCase();
                if (!val) return;
                var p = productosList.find(function(x) {
                    return (x.codigoBarra || '').trim().toLowerCase() === val;
                });
                if (p) {
                    var selBod = document.getElementById('selBodega_' + p.id);
                    var selUnit = document.getElementById('selUnitType_' + p.id);
                    selectProductFromModal(p.id,
                        selBod ? selBod.value : defaultBodegaId,
                        selUnit ? selUnit.value : 'U');
                    return;
                }
                var firstBtn = document.querySelector('#tblModalResults tbody tr:first-child button');
                if (firstBtn) firstBtn.click();
            }
        };

        function renderModalResults(matches) {
            let tbody = $("#tblModalResults tbody");
            if (matches.length === 0) {
                tbody.html(`<tr><td colspan="7" class="text-center py-4 text-muted">Empiece a escribir para buscar productos...</td></tr>`);
                return;
            }
            
            let h = "";
            matches.forEach((p, idx) => {
                let bodegaOptions = "";
                bodegasList.forEach(b => {
                    bodegaOptions += `<option value="${b.id}" ${b.esPrincipal ? 'selected' : ''}>${b.nombre}</option>`;
                });
                
                let unitSelector = "";
                if (p.contiene > 1) {
                    unitSelector = `
                        <div class="mt-1" style="max-width: 120px;">
                            <select class="form-select form-select-sm border-indigo" id="selUnitType_${p.id}" style="font-size: 0.72rem; padding: 2px 4px; height: auto;">
                                <option value="U">Unidad</option>
                                <option value="C">Caja (${p.contiene})</option>
                            </select>
                        </div>
                    `;
                } else {
                    unitSelector = `<span class="badge bg-indigo-soft text-indigo" style="font-size: 0.72rem;">UNID</span>`;
                }

                let stockDisplay = "";
                if (p.contiene > 1) {
                    let cajas = Math.floor(p.disponible / p.contiene);
                    let fracs = p.disponible % p.contiene;
                    stockDisplay = `<span class="badge-stock ${p.disponible > 10 ? 'bg-success text-white' : 'bg-danger text-white'}" title="F\u00EDsico: ${p.disponible} unidades">${cajas}F${fracs}</span>`;
                } else {
                    stockDisplay = `<span class="badge-stock ${p.disponible > 10 ? 'bg-success text-white' : 'bg-danger text-white'}">${p.disponible}</span>`;
                }

                let pvfr = p.contiene > 1 ? (p.pvp / p.contiene) : p.pvp;

                let vencBadge = '';
                if (p.vencimientoIso) {
                    let parts = p.vencimientoIso.split('-');
                    let vencDate = new Date(parts[0], parts[1] - 1, parts[2]);
                    let today = new Date();
                    today.setHours(0,0,0,0);
                    let diffTime = vencDate - today;
                    let daysLeft = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                    if (daysLeft < 0) {
                        vencBadge = `<span class="badge bg-danger ms-1 text-white" style="font-size: 0.65rem;" title="Vencido el ${p.vencimiento}">Vencido</span>`;
                    } else if (daysLeft >= 0 && daysLeft <= DIAS_ALERTA_VENCIMIENTO) {
                        vencBadge = `<span class="badge bg-warning text-dark ms-1" style="font-size: 0.65rem;" title="Vence el ${p.vencimiento}">Vence en ${daysLeft}d</span>`;
                    }
                }

                h += `<tr style="cursor: pointer;" ondblclick="viewWarehouseStock(${p.id}, '${p.nombre.replace(/'/g, "\\'")}')" title="Doble clic para ver stock por bodega">
                    <td class="fw-semibold text-muted" style="font-size: 0.85rem;">${p.codigoBarra || 'N/A'}</td>
                    <td>
                        <div class="fw-bold text-dark d-flex align-items-center" style="font-size: 0.85rem !important;">
                            <span>${p.nombre}</span>${vencBadge}
                            <button type="button" class="btn btn-link text-indigo p-0 ms-2 btn-info-trigger" onclick="event.stopPropagation(); showProductDetails(${p.id})" title="Ver detalles del producto" style="line-height: 1;">
                                <i class="bi bi-info-circle-fill text-indigo" style="font-size: 0.95rem;"></i>
                            </button>
                        </div>
                        ${unitSelector}
                    </td>
                    <td class="text-center">
                        ${stockDisplay}
                    </td>
                    <td class="text-end fw-semibold text-dark" style="font-size: 0.85rem;">${MONEDA_SIMBOLO}${p.pvp.toFixed(2)}</td>
                    <td class="text-end fw-semibold text-primary" style="font-size: 0.85rem;">${MONEDA_SIMBOLO}${pvfr.toFixed(2)}</td>
                    <td>
                        <select class="form-select form-select-sm border-0 bg-light" id="selBodega_${p.id}" style="font-size: 0.78rem; padding: 2px 4px; height: auto;">
                            ${bodegaOptions}
                        </select>
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-primary btn-sm rounded-circle p-0" onclick="selectProductFromModal(${p.id}, $('#selBodega_${p.id}').val(), $('#selUnitType_${p.id}').val() || 'U')" style="width: 28px; height: 28px; background-color: #4f46e5; border-color: #4f46e5; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="bi bi-plus-lg fs-6 text-white"></i>
                        </button>
                    </td>
                </tr>`;
            });
            tbody.html(h);
        }

        function promptFractionalProduct(p, preferredBodegaId) {
            let contiene = p.contiene || 1;
            let chosenBodId = parseInt(preferredBodegaId) || defaultBodegaId;
