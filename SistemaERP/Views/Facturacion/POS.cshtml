@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <div id="_posScriptError" style="display:none;position:fixed;top:0;left:0;right:0;z-index:99999;background:#dc2626;color:#fff;padding:10px 16px;font-size:13px;font-family:monospace;"></div>
    <script>
    try {
        const ACTIVAR_SRI   = @(activarSRI ? "true" : "false");
        const MONTO_MIN_CF  = @montoMinCF.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
        const CAJA_ABIERTA  = @(cajaAbierta ? "true" : "false");
        const CAJA_CERRADA  = @(cajaCerrada ? "true" : "false");
        const IS_ADMIN      = @(ViewBag.IsAdmin == true ? "true" : "false");
        const CIERRE_ID     = @(ViewBag.CierreId != null ? ViewBag.CierreId.ToString() : "null");
        if (typeof MONEDA_SIMBOLO === 'undefined') {
            window.MONEDA_SIMBOLO = "@Html.Raw(ViewBag.MonedaSimbolo ?? "$")";
        }
        const BANCOS_LIST = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            (ViewBag.Bancos as List<SistemaERP.Models.Entities.Banco> ?? new())
            .Select(b => new {
                id = b.Id,
                nombre = b.Nombre ?? ""
            })
        ));

        const LINEAS_DESCUENTO = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            (ViewBag.LineasActivas as List<SistemaERP.Models.Entities.DescuentoLineaProducto> ?? new())
            .Select(l => new {
                id          = l.Id,
                descripcion = l.Descripcion ?? "",
                porcentaje  = l.Porcentaje,
                vence_Desde = l.Vence_Desde.ToString("yyyy-MM-dd"),
                vence_Hasta = l.Vence_Hasta.ToString("yyyy-MM-dd"),
                estado      = l.Estado
            })
        ));
        const LINEAS_DETALLES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            (ViewBag.LineasDetallesActivos as List<SistemaERP.Models.Entities.DescuentoLineaProductoDet> ?? new())
            .Select(d => new {
                id                  = d.Id,
                id_Descuento_Linea  = d.Id_Descuento_Linea,
                id_Producto         = d.Id_Producto
            })
        ));
        const COMBOS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            (ViewBag.CombosActivos as List<SistemaERP.Models.Entities.DescuentoCombo> ?? new())
            .Select(c => new {
                id          = c.Id,
                descripcion = c.Descripcion ?? "",
                precioCombo = c.Precio_Combo,
                cantMin     = c.Cant_Min,
                cantMax     = c.Cant_Max,
                vence_Desde = c.Vence_Desde.ToString("yyyy-MM-dd"),
                vence_Hasta = c.Vence_Hasta.ToString("yyyy-MM-dd"),
                estado      = c.Estado
            })
        ));
        const COMBOS_DETALLES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            (ViewBag.CombosDetallesActivos as List<SistemaERP.Models.Entities.DescuentoComboProducto> ?? new())
            .Select(d => new {
                id                  = d.Id,
                id_Descuento_Combo  = d.Id_Descuento_Combo,
                id_Producto         = d.Id_Producto
            })
        ));
        const DESCUENTOS_PROVEEDOR = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            (ViewBag.DescuentosProveedorActivos as List<SistemaERP.Models.Entities.DescuentoProveedor> ?? new())
            .Select(dp => new {
                id           = dp.Id,
                id_Proveedor = dp.Id_Proveedor,
                porcentaje   = dp.Porcentaje,
                vence_Desde  = dp.Vence_Desde.ToString("yyyy-MM-dd"),
                vence_Hasta  = dp.Vence_Hasta.ToString("yyyy-MM-dd"),
                estado       = dp.Estado
            })
        ));

        let cart = [];

        // Serializaciones de datos de backend para b\u00FAsqueda local instant\u00E1nea
        let productosList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            (productos ?? new()).Select(p => new {
                id = p.Id,
                nombre = p.Nombre ?? "",
                codigoBarra = p.CodigoBarra ?? "",
                pvf = p.PVF ?? 0,
                pvp = p.PVP ?? 0,
                iva = p.IVA ?? 0,
                contiene = p.Contiene ?? 1,
                disponible = p.Disponible ?? 0,
                descuento = p.Descuento ?? 0,
                descuentoDesde = p.Descuento_Desde?.ToString("yyyy-MM-dd") ?? "",
                descuentoHasta = p.Descuento_Hasta?.ToString("yyyy-MM-dd") ?? "",
                idProveedor = p.Id_Proveedor ?? 0,
                idPresentacion = p.Id_Presentacion ?? 0,
                foto = p.Foto ?? "",
                vencimiento = p.Vencimiento?.ToString("dd/MM/yyyy") ?? "-",
                vencimientoIso = p.Vencimiento?.ToString("yyyy-MM-dd") ?? "",
                stocks = ((List<SistemaERP.Models.Entities.StockBodega>)(ViewBag.StockBodegas ?? new List<SistemaERP.Models.Entities.StockBodega>()))
                    .Where(s => s.Id_Producto == p.Id.ToString())
                    .Select(s => new { bodegaId = s.Id_Bodega, stock = s.Stock })
                    .ToList()
            })
        ));

        let bodegasList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            (bodegas ?? new()).Select(b => new {
                id = b.Id,
                nombre = b.Nombre ?? "",
                esPrincipal = b.EsPrincipal
            })
        ));

        const presentacionesMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            (ViewBag.Presentaciones as List<SistemaERP.Models.Entities.Presentacion> ?? new())
            .ToDictionary(p => p.Id, p => p.Nombre ?? "Sin Categor\u00EDa")
        ));

        const proveedoresMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            ViewBag.Proveedores as Dictionary<long, string> 
            ?? new Dictionary<long, string>()
        ));

        const POS_LAYOUT_FULL = "@(ViewBag.PosLayout ?? "imagenes")";
        const POS_LAYOUT = (POS_LAYOUT_FULL.split('_')[0] === "pos" ? "tablas" : POS_LAYOUT_FULL.split('_')[0]) || "imagenes";
        const STOCK_MINIMO_CARGAR = @(ViewBag.StockMinimoCargar ?? 1);
        const DIAS_ALERTA_VENCIMIENTO = @(ViewBag.DiasAlertaVencimiento ?? 30);

        let clientesList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            (ViewBag.Clientes as List<SistemaERP.Models.Entities.Cliente> ?? new())
            .Select(c => new {
                id = c.Id,
                nombre = (c.Nombres_Apellidos ?? "").ToUpper(),
                cedula = c.Cedula ?? ""
            })
        ));

        // Determinar bodega principal por defecto
        const defaultBodega = bodegasList.find(b => b.esPrincipal) || bodegasList[0];
        const defaultBodegaId = defaultBodega ? defaultBodega.id : 0;
        const defaultBodegaNombre = defaultBodega ? defaultBodega.nombre : "Principal";

        window.reiniciarCierreDesdePOS = function(cierreId) {
            Swal.fire({
                title: '\u00BFEst\u00E1 seguro de reiniciar el cierre?',
                text: "Esto eliminar\u00E1 el registro de cierre de caja actual y permitir\u00E1 volver a facturar.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'S\u00ED, reiniciar',
                cancelButtonText: 'Cancelar'
            }).then(function(result) {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Procesando...', didOpen: () => Swal.showLoading(), allowOutsideClick: false });
                    var token = $('input[name="__RequestVerificationToken"]').val();
                    $.ajax({
                        url: '@Url.Action("ReiniciarCierreCaja", "Facturacion")',
                        type: 'POST',
                        data: { id: cierreId },
                        headers: { 'RequestVerificationToken': token },
                        success: function(response) {
                            Swal.close();
                            if (response.success) {
                                Swal.fire('Reiniciado', response.message || 'El cierre de caja ha sido reiniciado.', 'success')
                                    .then(function() { location.reload(); });
                            } else {
                                Swal.fire('Error', response.message || 'No se pudo reiniciar el cierre.', 'error')
                                    .then(function() { window.location.href = '@Url.Action("Index", "Home")'; });
                            }
                        },
                        error: function() {
                            Swal.close();
                            Swal.fire('Error', 'Ocurri\u00F3 un error en el servidor al intentar reiniciar el cierre.', 'error')
                                .then(function() { window.location.href = '@Url.Action("Index", "Home")'; });
                        }
                    });
                } else {
                    window.location.href = '@Url.Action("Index", "Home")';
                }
            });
        };

        // \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD Inicializaci\u00F3n \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD
        $(document).ready(function() {
            // Sidebar is hidden by CSS (display:none on #sidebar-wrapper in POS styles)
            // The toggleSystemMenu button shows it as overlay when clicked

            // Inicializar atajos de Enter para cobros
            setupPaymentInputEnterHandlers();

            // Configuraci\u00F3n global de Toastr (Notificaciones al lado derecho con est\u00E9tica premium)
            toastr.options = {
                "positionClass": "toast-top-right",
                "closeButton": true,
                "progressBar": true,
                "preventDuplicates": false,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "2500",
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            };

            // 0. Validar si la caja ya est\u00E1 cerrada
            if (CAJA_CERRADA) {
                if (IS_ADMIN && CIERRE_ID) {
                    Swal.fire({
                        title: '<i class="bi bi-lock-fill text-danger me-2"></i> Caja Cerrada',
                        text: 'Su caja ya fue cerrada para el d\u00EDa de hoy. Como Administrador, puede reiniciar el cierre para volver a facturar.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: '<i class="bi bi-arrow-counterclockwise"></i> Reiniciar Cierre de Caja',
                        cancelButtonText: 'Volver al Inicio',
                        confirmButtonColor: '#dc3545',
                        cancelButtonColor: '#6c757d',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.reiniciarCierreDesdePOS(CIERRE_ID);
                        } else {
                            window.location.href = '@Url.Action("Index", "Home")';
                        }
                    });
                } else {
                    Swal.fire({
                        title: '<i class="bi bi-lock-fill text-danger me-2"></i> Caja Cerrada',
                        text: 'Su caja ya fue cerrada para el d\u00EDa de hoy. No puede realizar m\u00E1s facturas ni ventas.',
                        icon: 'error',
                        confirmButtonText: 'Volver al Inicio',
                        confirmButtonColor: '#4f46e5',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    }).then(() => {
                        window.location.href = '@Url.Action("Index", "Home")';
                    });
                }
                return;
            }

            // 1. Validar si hay caja abierta al entrar
            if (!CAJA_ABIERTA) {
                Swal.fire({
                    title: '<i class="bi bi-cash-stack text-warning me-2"></i> Apertura de Caja',
                    html: `
                        <p class="text-muted mb-3">No tiene una caja abierta para hoy. Ingrese el monto inicial para continuar.</p>
                        <div class="input-group mb-2">
                            <span class="input-group-text fw-bold">${MONEDA_SIMBOLO}</span>
                            <input id="swalMontoCaja" type="number" class="form-control form-control-lg text-center fw-bold"
                                   value="0.00" min="0" step="0.01" placeholder="0.00">
                        </div>
                        <small class="text-muted">Ingrese 0 si la caja arranca vac\u00EDa</small>
                    `,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: '<i class="bi bi-unlock-fill me-1"></i> Abrir Caja',
                    cancelButtonText: 'Salir del POS',
                    confirmButtonColor: '#4f46e5',
                    cancelButtonColor: '#6c757d',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    preConfirm: async () => {
                        const monto = parseFloat(document.getElementById('swalMontoCaja').value) || 0;
                        try {
                            const resp = await $.ajax({
                                url: '@Url.Action("AbrirCaja", "Facturacion")?monto=' + monto,
                                type: 'POST'
                            });
                            if (typeof resp === 'string') {
                                console.error('AbrirCaja: respuesta HTML inesperada (posible redirecci\u00F3n por permiso)', resp.substring(0, 200));
                                throw new Error('Error de autenticaci\u00F3n o permiso. Revise la consola (F12).');
                            }
                            if (!resp.success) {
                                throw new Error(resp.message || 'Error desconocido al abrir caja');
                            }
                            return resp;
                        } catch(e) {
                            const msg = e.responseJSON?.message || e.message || 'Error de conexi\u00F3n al servidor';
                            console.error('AbrirCaja error:', e);
                            Swal.showValidationMessage(msg);
                            return false;
                        }
                    }
                }).then((result) => {
                    if (result.isDismissed) {
                        window.location.href = '@Url.Action("Index", "Home")';
                    } else if (result.isConfirmed && result.value?.success) {
                        toastr.success('Caja abierta correctamente');
                        location.reload();
                    }
                });
            }

            // 2. Teclas de Funci\u00F3n alineadas con el nuevo dise\u00F1o
            $(document).off('keydown.pos').on('keydown.pos', function(e) {
                const key = e.which;
                if (key >= 112 && key <= 121) { // F1 a F10
                    e.preventDefault();
                    e.stopPropagation();
                    switch(key) {
                        case 112: // F1
                            $('#txtSearchHeader').focus().select();
                            break;
                        case 113: // F2
                            $('#btnPay').trigger('click');
                            break;
                        case 115: // F4
                            clearCart();
                            toastr.info('Carrito vaciado');
                            break;
                        case 118: // F7
                            $('#txtClienteSearch').focus().select();
                            break;
                        case 119: // F8
                            $('#btnPay').trigger('click');
                            break;
                        case 120: // F9 - Cancelar
                            clearCart();
                            clearClientSelection();
                            $('#txtSearchHeader').val('').focus();
                            activeSearchTerm = "";
                            renderCatalogGrid();
                            toastr.info('Venta cancelada y limpiada.');
                            break;
                        case 121: // F10
                            showCajaInfo();
                            break;
                        default: 
                            break;
                    }
                    return false;
                }
            });

            var modalBuscarProductosEl = document.getElementById('modalBuscarProductos');
            if (modalBuscarProductosEl) {
                modalBuscarProductosEl.addEventListener('shown.bs.modal', function() {
                    var inp = document.getElementById('txtModalSearch');
                    if (inp) { inp.value = ''; inp.focus(); }
                    renderModalResults([]);
                    var counter = document.getElementById('posProductCount');
                    if (counter) counter.textContent = 'Total: ' + productosList.length + ' productos disponibles para buscar';
                });
            }

            // 5. Bot\u00F3n Finalizar Venta
            $('#btnPay').off('click').on('click', function() {
                if (!cart.length) {
                    Swal.fire('Carrito Vac\u00EDo', 'Agregue productos para continuar', 'warning');
                    return;
                }
                
                // VALIDATE STOCK ISSUES BEFORE OPENING COBRO MODAL
                let hasStockIssues = false;
                let stockErrorMsg = "";
                
                cart.forEach(x => {
                    let prodRef = productosList.find(p => p.id === x.idProducto);
                    let stockDisponible = 0;
                    if (prodRef && prodRef.stocks) {
                        let stockRecord = prodRef.stocks.find(s => s.bodegaId === x.idBodega);
                        if (stockRecord) stockDisponible = stockRecord.stock;
                    }
                    let qtyRequired = x.esCaja && x.contiene > 0 ? x.cantidad * x.contiene : x.cantidad;
                    if (qtyRequired > stockDisponible) {
                        hasStockIssues = true;
                        stockErrorMsg += `<li><strong>${x.nombreProducto}</strong>: Solicita ${formatCantidad(qtyRequired, x.contiene, false)} pero solo hay ${formatCantidad(stockDisponible, x.contiene, false)} disponible.</li>`;
                    }
                });
                
                if (hasStockIssues) {
                    Swal.fire({
                        title: 'Stock Insuficiente',
                        html: `<div class="text-start">No se puede facturar porque hay art\u00EDculos con stock insuficiente en las bodegas seleccionadas:<br/><br/><ul class="ps-3">${stockErrorMsg}</ul>Por favor, ajuste las cantidades, cambie la bodega o remueva los art\u00EDculos.</div>`,
                        icon: 'error'
                    });
                    return;
                }

                procesarFinalizacion();
            });

            // 6. Inicializar funcionalidades de la nueva interfaz
            startHeaderClock();
            renderCatalogGrid();
            renderCustomerDisplay();
            
            // Foco inicial en b\u00FAsqueda para escaneo r\u00E1pido
            setTimeout(function() {
                $('#txtSearchHeader').focus();
            }, 300);
        });

        // \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD Ver Stock por Bodega (Doble Click) \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD
        async function viewWarehouseStock(id, name) {
            Swal.fire({
                title: 'Stock por Bodega: ' + name,
                html: '<div id="stockDetailContainer" class="p-3 text-center"><div class="spinner-border text-primary"></div></div>',
                width: 500,
                showConfirmButton: true,
                confirmButtonText: 'Cerrar'
            });
            try {
                const res = await $.get('@Url.Action("GetStockByProduct", "Facturacion")?id=' + id);
                let h = '<table class="table table-sm table-bordered mt-2"><thead><tr class="bg-light"><th>Bodega</th><th>Stock F\u00EDsico</th></tr></thead><tbody>';
                if (res.length === 0) {
                    h += '<tr><td colspan="2">No hay stock registrado en ninguna bodega</td></tr>';
                } else {
                    res.forEach(s => { h += `<tr><td>${s.bodega}</td><td class="fw-bold text-primary">${s.stock}</td></tr>`; });
                }
                h += '</tbody></table>';
                $('#stockDetailContainer').html(h);
            } catch (e) {
                $('#stockDetailContainer').html('<div class="alert alert-danger">Error al cargar datos</div>');
            }
        }

        // \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD Agregar \u00EDtem desde bot\u00F3n del cat\u00E1logo \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD
        function addItemFromButton(btn, id, name, pvp, pvf, contiene, ivaRate, descClasico, desdeClasico, hastaClasico, idProveedor) {
            let row = $(btn).closest('tr');
            let bodId  = row.find('.bodega-select').val() || defaultBodegaId;
            let bodNom = row.find('.bodega-select option:selected').data('nombre') || row.find('.bodega-select option:selected').text() || defaultBodegaNombre;

            // Agregar directamente con cantidad 1, presentaci\u00F3n base (unidades)
            addToCart(id, name, pvp, pvf, contiene, ivaRate, 1, false, bodId, bodNom, descClasico, desdeClasico, hastaClasico, idProveedor);
        }

        // \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD Agregar al carrito \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD
        function addToCart(id, name, pvp, pvf, contiene, ivaRate, qty, esCaja, bodId, bodNom, descClasico, desdeClasico, hastaClasico, idProveedor, bypassVencimiento = false) {
            // Validar vencimiento
            let productRecord = productosList.find(x => x.id === id);
            if (productRecord && productRecord.vencimientoIso && !bypassVencimiento) {
                let parts = productRecord.vencimientoIso.split('-');
                let vencDate = new Date(parts[0], parts[1] - 1, parts[2]);
                let today = new Date();
                today.setHours(0,0,0,0);
                let diffTime = vencDate - today;
                let daysLeft = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                let isExpired = daysLeft < 0;
                let isCloseToExpiration = daysLeft >= 0 && daysLeft <= DIAS_ALERTA_VENCIMIENTO;

                if (isExpired || isCloseToExpiration) {
                    let msg = isExpired 
                        ? `El producto <strong>${name}</strong> está <strong>VENCIDO</strong> (Venció el ${productRecord.vencimiento}).` 
                        : `El producto <strong>${name}</strong> está <strong>PRÓXIMO A VENCER</strong> (Faltan ${daysLeft} días, vence el ${productRecord.vencimiento}).`;
                    
                    Swal.fire({
                        title: 'Aprobación del Administrador Requerida',
                        html: `${msg}<br><br>Ingrese la contraseña de aprobación:`,
                        input: 'password',
                        inputAttributes: {
                            autocapitalize: 'off',
                            autofocus: 'true'
                        },
                        showCancelButton: true,
                        confirmButtonText: 'Autorizar',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: '#4f46e5',
                        showLoaderOnConfirm: true,
                        preConfirm: (clave) => {
                            if (!clave) {
                                Swal.showValidationMessage('Debe ingresar una contraseña');
                                return false;
                            }
                            return $.ajax({
                                url: '@Url.Action("ValidarPasswordVencido", "Facturacion")',
                                type: 'POST',
                                contentType: 'application/json',
                                data: JSON.stringify({ clave: clave })
                            }).then(response => {
                                if (!response.success) {
                                    throw new Error(response.message || 'Clave incorrecta');
                                }
                                return true;
                            }).catch(error => {
                                Swal.showValidationMessage(error.message || 'Error de conexión');
                            });
                        },
                        allowOutsideClick: () => !Swal.isLoading()
                    }).then((result) => {
                        if (result.isConfirmed) {
                            toastr.success('Venta de producto vencido/próximo autorizada');
                            addToCart(id, name, pvp, pvf, contiene, ivaRate, qty, esCaja, bodId, bodNom, descClasico, desdeClasico, hastaClasico, idProveedor, true);
                        }
                    });
                    return;
                }
            }

            // Precio unitario según presentación
            let unitPrice = esCaja ? pvp : (contiene > 1 ? pvp / contiene : pvp);
            
            // Si bodId no viene provisto, usar la principal por defecto
            let chosenBodId = parseInt(bodId) || defaultBodegaId;
            let chosenBod = bodegasList.find(b => b.id === chosenBodId) || defaultBodega;
            let chosenBodNom = chosenBod ? chosenBod.nombre : 'Principal';
            
            // Validar existencia de stock
            let p = productosList.find(x => x.id === id);
            let stockDisponible = 0;
            if (p && p.stocks) {
                let stockRecord = p.stocks.find(s => s.bodegaId === chosenBodId);
                if (stockRecord) stockDisponible = stockRecord.stock;
            }
            
            let unitsInCart = cart
                .filter(x => x.idProducto === id && x.idBodega == chosenBodId)
                .reduce((sum, item) => sum + (item.esCaja ? item.cantidad * contiene : item.cantidad), 0);
            
            let requestedUnits = esCaja ? qty * contiene : qty;
            let totalNeededUnits = unitsInCart + requestedUnits;
            
            if (totalNeededUnits > stockDisponible) {
                Swal.fire({
                    title: 'Stock Insuficiente',
                    html: `No hay suficiente existencia del producto <strong>${name}</strong> en la bodega <strong>${chosenBodNom}</strong>.<br><br>` +
                          `Stock disponible: <strong>${contiene > 1 ? formatCantidad(stockDisponible, contiene, false) : stockDisponible}</strong><br>` +
                          `Solicitado (Carrito + Nuevo): <strong>${contiene > 1 ? formatCantidad(totalNeededUnits, contiene, false) : totalNeededUnits}</strong>`,
                    icon: 'warning',
                    confirmButtonText: 'Entendido',
                    confirmButtonColor: '#4f46e5'
                });
                return;
            }
            
            let item = {
                idProducto:     id,
                nombreProducto: name,
                pvpBase:        pvp,     // PVP original (caja)
                pvfBase:        pvf,     // Costo (PVF)
                precioUnit:     unitPrice, // Precio por unidad actual
                contiene:       contiene,
                ivaRate:        ivaRate / 100,
                cantidad:       qty,
                esCaja:         esCaja,
                idBodega:       chosenBodId,
                nombreBodega:   chosenBodNom,
                vencimiento:    '-',
                promocion:      '',
                descuentoClasico: descClasico || 0,
                desdeClasico:   desdeClasico || null,
                hastaClasico:   hastaClasico || null,
                idProveedor:    idProveedor || 0,
                precioEditadoManual: false
            };

            let existing = cart.find(x => x.idProducto === id && x.idBodega == chosenBodId && x.esCaja === esCaja);
            if (existing) {
                existing.cantidad += qty;
                toastr.success(`Cantidad de <strong>${name}</strong> incrementada a <strong>${existing.cantidad}</strong>`);
            } else {
                cart.push(item);
                toastr.success(`<strong>${name}</strong> a\u00F1adido al carrito`);
            }

            renderCart();
        }

        // \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD Formatear cantidad fraccionaria \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD
        function formatCantidad(qty, contiene, esCaja) {
            if (contiene > 1) {
                if (esCaja) {
                    return `${qty}F0`;
                } else {
                    let cajas = Math.floor(qty / contiene);
                    let fracs = qty % contiene;
                    return `${cajas}F${fracs}`;
                }
            }
            return String(qty);
        }

        // \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD Evaluar y aplicar descuentos en el POS \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD
        function applyDiscounts() {
            cart.forEach(x => {
                if (!x.precioEditadoManual) {
                    x.precioUnit = x.esCaja ? x.pvpBase : (x.contiene > 1 ? x.pvpBase / x.contiene : x.pvpBase);
                }
                x.promocion = "";
            });

            // 1. APLICAR DESCUENTOS POR PRODUCTO O POR L\u00CDNEA O POR PROVEEDOR (PORCENTAJES)
            cart.forEach(x => {
                if (x.precioEditadoManual) return;

                let pctDesc = 0;
                let promoDesc = "";

                // A. Evaluar Descuento Cl\u00E1sico
                if (x.descuentoClasico > 0) {
                    let hoy = new Date().toISOString().split('T')[0];
                    if (x.desdeClasico && x.hastaClasico && hoy >= x.desdeClasico.substring(0, 10) && hoy <= x.hastaClasico.substring(0, 10)) {
                        pctDesc = x.descuentoClasico;
                        promoDesc = `Desc. Prod ${pctDesc}%`;
                    }
                }

                // B. Evaluar Descuento de L\u00EDnea
                if (LINEAS_DETALLES && LINEAS_DESCUENTO) {
                    let det = LINEAS_DETALLES.find(d => d.id_Producto === x.idProducto);
                    if (det) {
                        let lin = LINEAS_DESCUENTO.find(l => l.id === det.id_Descuento_Linea);
                        if (lin && lin.porcentaje > pctDesc) {
                            pctDesc = lin.porcentaje;
                            promoDesc = `Desc. L\u00EDnea "${lin.descripcion}" ${pctDesc}%`;
                        }
                    }
                }

                // C. Evaluar Descuento por Proveedor
                if (DESCUENTOS_PROVEEDOR && x.idProveedor > 0) {
                    let provDescRule = DESCUENTOS_PROVEEDOR.find(dp => dp.id_Proveedor === x.idProveedor);
                    if (provDescRule && provDescRule.porcentaje > pctDesc) {
                        pctDesc = provDescRule.porcentaje;
                        promoDesc = `Desc. Prov "${provDescRule.descripcion}" ${pctDesc}%`;
                    }
                }

                if (pctDesc > 0) {
                    x.precioUnit = x.precioUnit * (1 - (pctDesc / 100));
                    x.promocion = promoDesc;
                }
            });

            // 2. APLICAR COMBOS
            if (COMBOS && COMBOS_DETALLES) {
                COMBOS.forEach(combo => {
                    let comboProdIds = COMBOS_DETALLES.filter(d => d.id_Descuento_Combo === combo.id).map(d => d.id_Producto);
                    if (comboProdIds.length === 0) return;

                    let todosPresentes = comboProdIds.every(pId => cart.some(item => item.idProducto === pId));
                    if (!todosPresentes) return;

                    let itemsDelCombo = cart.filter(item => comboProdIds.includes(item.idProducto) && !item.precioEditadoManual);
                    if (itemsDelCombo.length === comboProdIds.length) {
                        // Validar cantidad m\u00EDnima y m\u00E1xima del combo
                        let qtyFormed = Math.min(...itemsDelCombo.map(item => item.cantidad));
                        let cantMin = combo.cant_Min !== undefined ? combo.cant_Min : (combo.cantMin !== undefined ? combo.cantMin : (combo.Cant_Min !== undefined ? combo.Cant_Min : 0));
                        let cantMax = combo.cant_Max !== undefined ? combo.cant_Max : (combo.cantMax !== undefined ? combo.cantMax : (combo.Cant_Max !== undefined ? combo.Cant_Max : 0));

                        if (qtyFormed < cantMin || (cantMax > 0 && qtyFormed > cantMax)) {
                            return; // No cumple con la regla de cantidad
                        }

                        let sumaPreciosOriginales = 0;
                        itemsDelCombo.forEach(item => {
                            let originalPrice = item.esCaja ? item.pvpBase : (item.contiene > 1 ? item.pvpBase / item.contiene : item.pvpBase);
                            sumaPreciosOriginales += originalPrice;
                        });

                        if (sumaPreciosOriginales > 0) {
                            itemsDelCombo.forEach(item => {
                                let originalPrice = item.esCaja ? item.pvpBase : (item.contiene > 1 ? item.pvpBase / item.contiene : item.pvpBase);
                                let factor = originalPrice / sumaPreciosOriginales;
                                item.precioUnit = factor * combo.precio_Combo;
                                item.promocion = `Combo "${combo.descripcion}"`;
                            });
                        }
                    }
                });
            }
        }

        // \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD Renderizar carrito \uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD\uFFFD
        function renderCart() {
            applyDiscounts();
            let container = $('#cartItemsListStandard, #cartItemsListColumnar');
            container.empty();
            
            let hasStockIssues = false;

            if (!cart.length) {
                container.html('<div class="text-center py-5 text-muted"><i class="bi bi-cart-x fs-3 d-block mb-2"></i>El carrito est\u00E1 vac\u00EDo</div>');
            } else {
                let tableHtml = `
                    <div class="table-responsive bg-white" style="flex-grow: 1; height: 0; overflow-y: auto; width: 100%;">
                        <table class="table table-hover align-middle mb-0" style="font-size: 0.7rem; width:100%; border-collapse: collapse; min-width: 550px;">
                            <thead>
                                <tr class="table-light text-secondary fw-bold border-bottom" style="font-size: 0.62rem; text-transform: uppercase; position: sticky; top: 0; background: #f8fafc; z-index: 1;">
                                    <th class="py-1.5 px-1" style="width: 15%;">ID/C\u00D3DIGO BARRA</th>
                                    <th class="py-1.5 px-1" style="width: 32%;">PRODUCTO</th>
                                    <th class="py-1.5 px-1 text-center" style="width: 8%;">CANT</th>
                                    <th class="py-1.5 px-1 text-end" style="width: 10%;">PVFR</th>
                                    <th class="py-1.5 px-1 text-center" style="width: 12%;">PROMOCION</th>
                                    <th class="py-1.5 px-1 text-end" style="width: 13%;">TOTAL A PAGAR</th>
                                    <th class="py-1.5 px-1 text-center" style="width: 13%;">VENCIMIENTO</th>
                                    <th class="py-1.5 px-1 text-center" style="width: 5%;"></th>
                                </tr>
                            </thead>
                            <tbody>
                `;

                cart.forEach((x, i) => {
                    let unitPrice = x.precioUnit;
                    let total     = unitPrice * x.cantidad;
                    
                    // Validaci\u00F3n de Stock en Tiempo Real por Bodega
                    let prodRef = productosList.find(p => p.id === x.idProducto);
                    let stockDisponible = 0;
                    if (prodRef && prodRef.stocks) {
                        let stockRecord = prodRef.stocks.find(s => s.bodegaId === x.idBodega);
                        if (stockRecord) stockDisponible = stockRecord.stock;
                    }
                    
                    let qtyRequired = x.esCaja && x.contiene > 0 ? x.cantidad * x.contiene : x.cantidad;
                    let isStockInsuficiente = qtyRequired > stockDisponible;
                    
                    let rowBgStyle = isStockInsuficiente ? 'background-color: #fef2f2; border: 1.5px solid #ef4444;' : '';
                    let stockWarningText = isStockInsuficiente ? ` <span class="badge bg-danger text-white px-1 py-0.5" style="font-size:0.6rem;">\u00A1Sin Stock! Disp: ${formatCantidad(stockDisponible, x.contiene, false)}</span>` : '';
                    
                    let presentationText = x.esCaja ? ` (Caja)` : ` (Unid)`;
                    let displayName = x.nombreProducto + presentationText + stockWarningText;
                     let vencimientoText = prodRef?.vencimiento || '-';

                    if (isStockInsuficiente) {
                        hasStockIssues = true;
                    }

                    tableHtml += `
                        <tr class="cart-table-row border-bottom border-light" style="cursor: pointer; ${rowBgStyle}" ondblclick="editCartItemModal(${i})" title="Doble clic para editar detalles">
                             <td class="py-1 px-1 font-monospace fw-bold text-secondary text-truncate" style="max-width: 75px;" title="${prodRef?.codigoBarra || ''}">${prodRef?.codigoBarra || '-'}</td>
                            <td class="py-1 px-1">
                                <div class="fw-semibold text-dark text-truncate" style="max-width: 140px;" title="${x.nombreProducto}">${displayName}</div>
                                <div class="text-muted" style="font-size: 0.6rem;"><i class="bi bi-house-door"></i> ${x.nombreBodega}</div>
                            </td>
                            <td class="py-1 px-1 text-center fw-bold text-primary" style="font-size: 0.75rem;">${Number(x.cantidad).toFixed(2)}</td>
                            <td class="py-1 px-1 text-end">${MONEDA_SIMBOLO}${unitPrice.toFixed(2)}</td>
                             <td class="py-1 px-1 text-center text-danger text-truncate" style="font-size: 0.65rem; max-width: 60px;" title="${x.promocion || ''}">${x.promocion || '-'}</td>
                            <td class="py-1 px-1 text-end fw-bold text-dark">${MONEDA_SIMBOLO}${total.toFixed(2)}</td>
                            <td class="py-1 px-1 text-center text-muted text-truncate" style="font-size: 0.65rem; max-width: 65px;">${vencimientoText}</td>
                            <td class="py-1 px-1 text-center" onclick="event.stopPropagation();">
                                <button type="button" class="btn btn-xs text-danger p-0 border-0" onclick="removeItem(${i})" title="Eliminar \u00EDtem">
                                    <i class="bi bi-trash-fill" style="font-size: 0.8rem;"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                });

                tableHtml += `
                            </tbody>
                        </table>
