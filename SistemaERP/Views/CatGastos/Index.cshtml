@model IEnumerable<SistemaERP.Models.Entities.CatGasto>

@{
    ViewData["Title"] = "Catálogo de Gastos";
}

<div class="row mb-4 animate__animated animate__fadeIn">
    <div class="col">
        <h2 class="fw-bold mb-1">Catálogo de Gastos</h2>
        <p class="text-muted">Gestión de tipos de gastos operativos y financieros.</p>
    </div>
    <div class="col-auto">
        <a asp-action="Create" class="btn btn-premium shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Nuevo Tipo de Gasto
        </a>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger border-0 shadow-sm mb-4 animate__animated animate__shakeX" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
    </div>
}

<div class="premium-card animate__animated animate__fadeInUp">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="border-0 text-xs text-uppercase py-3" style="width: 80px;">ID</th>
                    <th class="border-0 text-xs text-uppercase py-3">Descripción</th>
                    <th class="border-0 text-xs text-uppercase py-3">Estado</th>
                    <th class="border-0 text-xs text-uppercase py-3">Creado Por</th>
                    <th class="border-0 text-xs text-uppercase py-3 text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr id="row-@item.Id">
                            <td class="text-muted fw-medium">#@item.Id</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-purple-soft rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px;">
                                        <i class="bi bi-tag"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@item.Descripcion</span>
                                </div>
                            </td>
                            <td>
                                @if (item.Estado)
                                {
                                    <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill">Inactivo</span>
                                }
                            </td>
                            <td>
                                <div class="text-xs fw-medium text-muted">@item.CreateUser</div>
                                <div class="text-xs text-muted opacity-75">@item.CreateDate?.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border-0 text-primary me-1" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-light border-0 text-danger" title="Eliminar" onclick="confirmDelete(@item.Id, '@item.Descripcion')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                            No se encontraron registros de gastos.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted fw-medium">
        <i class="bi bi-arrow-left me-1"></i> Volver al Dashboard
    </a>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            Swal.fire({
                title: '¿Estás seguro?',
                text: "Eliminarás el tipo de gasto '" + name + "'. Esta acción no se puede deshacer.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3b82f6',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "CatGastos")',
                        type: 'POST',
                        data: { id: id },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: '¡Eliminado!',
                                    text: response.message,
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                                $("#row-" + id).fadeOut(500);
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'No se pudo procesar la solicitud.', 'error');
                        }
                    });
                }
            })
        }
    </script>
}
