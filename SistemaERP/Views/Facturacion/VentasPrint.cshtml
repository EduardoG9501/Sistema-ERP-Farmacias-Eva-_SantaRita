@model IEnumerable<SistemaERP.Models.Entities.VentaOperacion>

@{
    Layout = null;
    var clientes = ViewBag.Clientes as Dictionary<long, string>;
    var totales = ViewBag.Totales as Dictionary<long, decimal>;
    var p = ViewBag.Parametros as SistemaERP.Models.Entities.ParametrosSistema;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Reporte de Historial de Ventas</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
    
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
            background-color: #fff;
            padding: 20px;
            font-size: 0.85rem;
        }
        .report-header {
            border-bottom: 2px solid #3b82f6;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }
        .report-title {
            color: #1e3a8a;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 1.6rem;
            margin: 0;
        }
        .no-print-btn {
            background-color: #3b82f6;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(59, 130, 246, 0.2);
            transition: all 0.2s;
        }
        .no-print-btn:hover {
            background-color: #2563eb;
            transform: translateY(-1px);
        }
        @@media print {
            .no-print {
                display: none !important;
            }
            body {
                padding: 0;
                margin: 0;
            }
        }
    </style>
</head>
<body onload="window.print()">

    <div class="no-print d-flex justify-content-between align-items-center mb-4 p-3 bg-light border rounded">
        <div>
            <span class="fw-semibold text-secondary"><i class="bi bi-info-circle me-1"></i> Vista de impresión de ventas.</span>
        </div>
        <button class="no-print-btn" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Imprimir / Guardar como PDF
        </button>
    </div>

    <!-- Encabezado de Reporte -->
    <div class="report-header row align-items-center">
        <div class="col-8 d-flex align-items-center gap-3">
            @if (p?.ReporteMostrarLogo == true && !string.IsNullOrEmpty(p?.LogoPath))
            {
                <img src="@(p.LogoPath.Split('?')[0])" alt="Logo" style="max-height: 60px; max-width: 150px; object-fit: contain;" />
            }
            <div>
                <h1 class="report-title">Historial de Ventas</h1>
                <p class="report-subtitle">@(p?.ReporteEncabezado ?? "Reporte Oficial de Ventas y Comprobantes")</p>
            </div>
        </div>
        <div class="col-4 text-end text-secondary small">
            <div><strong>Empresa:</strong> @(p?.NombreEmpresa ?? "SCM")</div>
            <div><strong>Fecha Emisión:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
    </div>

    <table class="table table-bordered table-striped text-center align-middle">
        <thead>
            <tr>
                <th style="width: 20%; text-align: center;">Fecha</th>
                <th style="width: 20%; text-align: center;">Ticket #</th>
                <th style="width: 30%; text-align: left;">Cliente</th>
                <th style="width: 15%; text-align: center;">Estado SRI</th>
                <th style="width: 15%; text-align: right;">Total</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    decimal total = 0;
                    if (totales != null && totales.ContainsKey(item.Id)) {
                        total = totales[item.Id];
                    }
                    <tr>
                        <td class="text-center">@item.FechaHora_Registro?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center fw-bold text-primary">@item.NumDoc</td>
                        <td class="text-start">
                            @(item.Id_Cliente.HasValue && clientes != null && clientes.ContainsKey(item.Id_Cliente.Value) ? clientes[item.Id_Cliente.Value] : "Consumidor Final")
                        </td>
                        <td class="text-center">@item.SRI_Estado</td>
                        <td class="text-end fw-bold">@((ViewBag.MonedaSimbolo as string) ?? "$")@total.ToString("N2")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted">No hay ventas registradas.</td>
                </tr>
            }
        </tbody>
    </table>

</body>
</html>
