        function openNewEspecialModal() {
            $('#especialModalTitle').text('Asignar Precio Especial');
            $('#especialId').val('');
            $('#especialSelectContainer').removeClass('d-none');
            $('#especialStaticContainer').addClass('d-none');
            $('#especialProducto').val(null).trigger('change');
            $('#especialPrecio').val('');
            $('#especialCantidad').val(1);
            $('#especialEstado').val('A');

            var modal = new bootstrap.Modal(document.getElementById('especialModal'));
            modal.show();
        }

        function editEspecial(id, pId, precio, cant, estado) {
            $('#especialModalTitle').text('Editar Precio Especial');
            $('#especialId').val(id);
            $('#especialSelectContainer').addClass('d-none');
            $('#especialStaticContainer').removeClass('d-none');
            
            var prodNombre = @Json.Serialize(productosDict);
            $('#especialProductoNombre').val(prodNombre[pId] || "Producto #" + pId);
            $('#especialPrecio').val(precio);
            $('#especialCantidad').val(cant);
            $('#especialEstado').val(estado === 'A' || estado === 'Activo' || estado === 'APROBADO' ? 'A' : estado);

            var modal = new bootstrap.Modal(document.getElementById('especialModal'));
            modal.show();
        }

        function saveEspecial() {
            var id = $('#especialId').val();
            var pId = id ? 0 : $('#especialProducto').val(); // Si es edición, el backend ya tiene el producto mapeado de antes o lo ignoramos porque no cambia
            var precio = $('#especialPrecio').val();
            var cant = $('#especialCantidad').val();
            var estado = $('#especialEstado').val();

            // Si es nuevo y no tiene pId
            if (!id && !pId) {
                Swal.fire('Error', 'Debe seleccionar un producto.', 'error');
                return;
            }
            if (!precio || precio <= 0) {
                Swal.fire('Error', 'Debe definir un precio especial válido.', 'error');
                return;
            }
            if (!cant || cant <= 0) {
                Swal.fire('Error', 'La cantidad mínima debe ser 1 o más.', 'error');
                return;
            }

            // Obtener el ID del producto correcto
            var finalPid = id ? 0 : parseInt(pId);
            if (id) {
                // Para edición, necesitamos el ID del producto que estaba previamente, lo buscaremos
                // Pero wait, en la tabla ya tenemos el registro. Podemos pasar el producto original.
                // Buscaremos el ID de la fila.
                // En el editEspecial pasamos pId, así que lo guardamos en un data attribute o variable.
            }

            Swal.fire({
                title: 'Guardando...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            // Si es edición, buscaremos el producto ID que cargamos
            var editPid = 0;
            if (id) {
                // Buscar producto mapeado para este ID de precio especial
                var especialesMapeados = @Json.Serialize(especiales);
                var esp = especialesMapeados.find(e => e.id == parseInt(id));
                if (esp) {
                    editPid = esp.id_Producto;
                }
            }

            $.ajax({
                url: '/Descuentos/SaveSpecialPrice',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    Id: id ? parseInt(id) : 0,
                    ProductoId: id ? editPid : parseInt(pId),
                    PrecioEspecial: parseFloat(precio),
                    Cantidad: parseFloat(cant),
                    Estado: estado
                }),
                success: function(res) {
                    if (res.success) {
                        Swal.fire('¡Éxito!', res.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                }
            });
        }

        function deleteEspecial(id) {
            Swal.fire({
