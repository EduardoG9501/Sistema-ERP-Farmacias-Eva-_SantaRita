        function saveProveedor() {
            var id = $('#proveedorDescId').val();
            var provId = $('#proveedorSelect').val();
            var desc = $('#proveedorDescripcion').val();
            var porc = $('#proveedorPorcentaje').val();
            var desde = $('#proveedorVenceDesde').val();
            var hasta = $('#proveedorVenceHasta').val();
            var estado = $('#proveedorEstado').is(':checked');

            if (!provId) {
                Swal.fire('Error', 'Debe seleccionar un proveedor.', 'error');
                return;
            }
            if (!desc) {
                Swal.fire('Error', 'La descripción es obligatoria.', 'error');
                return;
            }
            if (!porc || porc <= 0 || porc > 100) {
                Swal.fire('Error', 'Porcentaje de descuento debe estar entre 1 y 100.', 'error');
                return;
            }
            if (!desde || !hasta) {
                Swal.fire('Error', 'Debe definir el rango de vigencia.', 'error');
                return;
            }

            Swal.fire({
                title: 'Guardando...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '/Descuentos/SaveSupplierDiscount',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    Id: id ? parseInt(id) : 0,
                    ProveedorId: parseInt(provId),
                    Descripcion: desc,
                    Porcentaje: parseFloat(porc),
                    VenceDesde: desde,
                    VenceHasta: hasta,
                    Estado: estado
                }),
                success: function(res) {
                    if (res.success) {
                        Swal.fire('¡Éxito!', res.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', res.message, 'error');
