@model SistemaERP.Models.Entities.CatGasto

@{
    ViewData["Title"] = (Model?.Id > 0) ? "Editar Gasto" : "Nuevo Gasto";
}

<div class="row mb-4 animate__animated animate__fadeIn">
    <div class="col">
        <h2 class="fw-bold mb-1">@(Model?.Id > 0 ? "Editar Tipo de Gasto" : "Registrar Tipo de Gasto")</h2>
        <p class="text-muted">Describa la categoría para la clasificación de egresos.</p>
    </div>
</div>

<div class="row animate__animated animate__fadeInUp">
    <div class="col-md-8 col-lg-6">
        <div class="premium-card">
            <form asp-action="@(Model?.Id > 0 ? "Edit" : "Create")">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                @if (Model?.Id > 0)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <div class="mb-4">
                    <label asp-for="Descripcion" class="form-label fw-semibold">Descripción del Gasto</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-tag"></i></span>
                        <input asp-for="Descripcion" class="form-control border-start-0 ps-0" placeholder="Ej. Gastos de Limpieza, Arriendo, Luz, etc." required />
                    </div>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                @if (Model?.Id > 0)
                {
                    <div class="mb-4">
                        <label asp-for="Estado" class="form-label fw-semibold d-block">Estado</label>
                        <div class="form-check form-switch custom-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Estado">
                            <label class="form-check-label text-muted" for="Estado">@(Model.Estado ? "Activo" : "Inactivo")</label>
                        </div>
                    </div>
                }

                <div class="d-flex gap-2 pt-2">
                    <button type="submit" class="btn btn-premium flex-grow-1 shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Guardar Cambios
                    </button>
                    <a asp-action="Index" class="btn btn-light border flex-grow-1">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
