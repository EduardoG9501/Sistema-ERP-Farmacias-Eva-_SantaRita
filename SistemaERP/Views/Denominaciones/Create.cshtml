@model SistemaERP.Models.Entities.Denominacion

@{
    ViewData["Title"] = "Crear Denominación";
}

<div class="row mb-4 animate__animated animate__fadeIn">
    <div class="col">
        <h2 class="fw-bold mb-1">Nueva Denominación</h2>
        <p class="text-muted">Añadir una nueva moneda o billete al sistema.</p>
    </div>
</div>

<div class="row animate__animated animate__fadeInUp">
    <div class="col-md-6">
        <div class="premium-card p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold text-muted small text-uppercase">Nombre</label>
                    <input asp-for="Nombre" class="form-control bg-light border-0" placeholder="Ej. Billete de 20" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Valor" class="form-label fw-bold text-muted small text-uppercase">Valor (@ViewBag.MonedaSimbolo)</label>
                    <input asp-for="Valor" type="number" step="0.01" class="form-control bg-light border-0" placeholder="0.00" />
                    <span asp-validation-for="Valor" class="text-danger small"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="Tipo" class="form-label fw-bold text-muted small text-uppercase">Tipo</label>
                    <select asp-for="Tipo" class="form-select bg-light border-0">
                        <option value="Billete">Billete</option>
                        <option value="Moneda">Moneda</option>
                    </select>
                    <span asp-validation-for="Tipo" class="text-danger small"></span>
                </div>
                
                <div class="mb-4 form-check form-switch mt-4">
                    <input class="form-check-input" type="checkbox" asp-for="Activo" checked />
                    <label class="form-check-label fw-medium" asp-for="Activo">Estado Activo</label>
                </div>
                
                <div class="d-flex gap-2 pt-3">
                    <button type="submit" class="btn btn-premium px-4">Guardar</button>
                    <a asp-action="Index" class="btn btn-light px-4">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
