@model dynamic
@{
    ViewData["Title"] = "Inicio";
    var nombreEmpresa = ViewBag.NombreEmpresa as string ?? "Sistema ERP";
    var logoPath = ViewBag.LogoPath as string;
    var bgUrl = ViewBag.BackgroundUrl as string;
    
    var mainBgValue = string.IsNullOrEmpty(bgUrl) 
        ? "var(--welcome-bg-fallback)" 
        : "radial-gradient(circle at center, rgba(15, 23, 42, 0.35) 0%, rgba(15, 23, 42, 0.9) 100%), url('" + bgUrl + "')";
}

<style>
    :root {
        --welcome-primary: #6366f1;
        --welcome-primary-hover: #4f46e5;
        --welcome-bg-fallback: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #2e1065 100%);
        --welcome-glass-bg: rgba(15, 23, 42, 0.65);
        --welcome-glass-border: rgba(255, 255, 255, 0.08);
        --welcome-text-main: #f8fafc;
        --welcome-text-muted: #94a3b8;
    }

    /* Target the main container specifically on this view */
    main {
        background: @Html.Raw(mainBgValue) !important;
        background-size: cover !important;
        background-position: center !important;
        background-repeat: no-repeat !important;
        min-height: calc(100vh - 70px) !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 40px !important;
        margin: -1.5rem -1.5rem -1.5rem -1.5rem !important; /* Negate main padding */
    }

    /* Glass Card */
    .welcome-card {
        background: var(--welcome-glass-bg);
        border: 1px solid var(--welcome-glass-border);
        border-radius: 24px;
        padding: 45px;
        width: 100%;
        max-width: 580px;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
        text-align: center;
        color: var(--welcome-text-main);
    }

    .company-logo {
        max-height: 80px;
        max-width: 260px;
        object-fit: contain;
        margin-bottom: 25px;
        filter: drop-shadow(0 4px 8px rgba(0,0,0,0.25));
    }

    .company-icon {
        font-size: 3.5rem;
        color: var(--welcome-primary);
        margin-bottom: 20px;
        display: inline-block;
        animation: pulseWelcome 2.5s infinite;
    }

    .welcome-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 8px;
        letter-spacing: -0.02em;
        color: #ffffff;
    }

    .welcome-subtitle {
        font-size: 0.95rem;
        color: var(--welcome-text-muted);
        margin-bottom: 30px;
    }

    /* Digital Clock */
    .clock-container {
        margin: 25px 0;
        padding: 20px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .clock-time {
        font-family: 'JetBrains Mono', monospace;
        font-size: 4rem;
        font-weight: 700;
        letter-spacing: -0.05em;
        color: #ffffff;
        line-height: 1;
        text-shadow: 0 0 25px rgba(99, 102, 241, 0.35);
    }

    .clock-date {
        font-size: 1.05rem;
        font-weight: 500;
        color: #818cf8;
        margin-top: 12px;
        text-transform: capitalize;
    }

    @@keyframes pulseWelcome {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); opacity: 0.9; }
        100% { transform: scale(1); }
    }
</style>

<div class="welcome-card animate__animated animate__fadeInUp">
    @if (!string.IsNullOrEmpty(logoPath))
    {
        <img src="@(logoPath.Split('?')[0])" alt="Logo @nombreEmpresa" class="company-logo" />
    }
    else
    {
        <i class="bi bi-hospital company-icon"></i>
    }
    
    <h1 class="welcome-title">¡Hola, @(User.Identity?.Name ?? "Usuario")!</h1>
    <p class="welcome-subtitle">Te damos la bienvenida al sistema de @nombreEmpresa</p>
    
    <!-- Real-time clock and date -->
    <div class="clock-container">
        <div class="clock-time" id="digital-clock">00:00:00</div>
        <div class="clock-date" id="digital-date">Cargando fecha...</div>
    </div>
</div>

<script>
    function updateClock() {
        const now = new Date();
        
        // Format time: HH:MM:SS
        let hours = String(now.getHours()).padStart(2, '0');
        let minutes = String(now.getMinutes()).padStart(2, '0');
        let seconds = String(now.getSeconds()).padStart(2, '0');
        document.getElementById('digital-clock').textContent = `${hours}:${minutes}:${seconds}`;
        
        // Format date: e.g. "miércoles, 10 de junio de 2026"
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        let dateStr = now.toLocaleDateString('es-ES', options);
        document.getElementById('digital-date').textContent = dateStr;
    }

    // Initialize clock and set interval
    updateClock();
    setInterval(updateClock, 1000);
</script>
