@section Scripts {
    <script>
        $(document).ready(function() {
            // Inicializar Select2 en los inputs AJAX de productos
            $('.select2-ajax').select2({
                theme: 'bootstrap-5',
                placeholder: 'Escribe el nombre o código de barra...',
                minimumInputLength: 2,
                allowClear: true,
                dropdownParent: $('.modal:visible').length ? $('.modal:visible') : null, // Ajuste para modales
                ajax: {
                    url: '/Descuentos/BuscarProductos',
                    dataType: 'json',
                    delay: 250,
                    data: function(params) {
                        return { term: params.term };
                    },
                    processResults: function(data) {
                        return {
                            results: data.map(function(item) {
                                return {
                                    id: item.id,
                                    text: item.nombre + " (" + (item.codigoBarra || "Sin código") + ") - PVP: $" + item.pvp.toFixed(2),
                                    item: item
                                };
                            })
                        };
                    },
                    cache: true
                }
            });

            // Arreglar problema de dropdownParent al abrir modales
            $('#clasicoModal, #lineaModal, #comboModal, #especialModal').on('shown.bs.modal', function() {
                var modalId = $(this).attr('id');
                $(this).find('.select2-ajax').select2({
                    theme: 'bootstrap-5',
                    placeholder: 'Escribe el nombre o código de barra...',
                    minimumInputLength: 2,
                    allowClear: true,
                    dropdownParent: $('#' + modalId),
                    ajax: {
                        url: '/Descuentos/BuscarProductos',
                        dataType: 'json',
                        delay: 250,
                        data: function(params) {
                            return { term: params.term };
                        },
                        processResults: function(data) {
                            return {
                                results: data.map(function(item) {
                                    return {
                                        id: item.id,
                                        text: item.nombre + " (" + (item.codigoBarra || "Sin código") + ") - PVP: $" + item.pvp.toFixed(2),
                                        item: item
                                    };
                                })
                            };
                        },
                        cache: true
                    }
                });
            });
        });

        // Helper para establecer fechas por defecto
        function getTodayString() {
            return new Date().toISOString().split('T')[0];
        }

        function getNextYearString() {
            var d = new Date();
            d.setFullYear(d.getFullYear() + 1);
            return d.toISOString().split('T')[0];
        }

        // ==================== ACCIONES TAB 1: CLÁSICO ====================
        function openNewClasicoModal() {
            $('#clasicoModalTitle').text('Asignar Descuento Clásico');
            $('#clasicoProdId').val('');
            $('#clasicoSelectContainer').removeClass('d-none');
            $('#clasicoStaticContainer').addClass('d-none');
            $('#clasicoProducto').val(null).trigger('change');
            $('#clasicoPorcentaje').val('');
            $('#clasicoDesde').val(getTodayString());
            $('#clasicoHasta').val(getNextYearString());
            
            var modal = new bootstrap.Modal(document.getElementById('clasicoModal'));
            modal.show();
        }

        function editClasico(id, porcentaje, desde, hasta) {
            $('#clasicoModalTitle').text('Editar Descuento de Producto');
            $('#clasicoProdId').val(id);
            $('#clasicoSelectContainer').addClass('d-none');
            $('#clasicoStaticContainer').removeClass('d-none');
            
            // Obtener el nombre del producto de la fila o del lookup
            var prodNombre = @Json.Serialize(productosDict);
            $('#clasicoProductoNombre').val(prodNombre[id] || "Producto #" + id);
            
            $('#clasicoPorcentaje').val(porcentaje);
            $('#clasicoDesde').val(desde ? desde.substring(0,10) : getTodayString());
            $('#clasicoHasta').val(hasta ? hasta.substring(0,10) : getNextYearString());

            var modal = new bootstrap.Modal(document.getElementById('clasicoModal'));
            modal.show();
        }

        function saveClasico() {
            var id = $('#clasicoProdId').val();
            var pId = id ? parseInt(id) : $('#clasicoProducto').val();
            var porc = $('#clasicoPorcentaje').val();
            var desde = $('#clasicoDesde').val();
            var hasta = $('#clasicoHasta').val();

            if (!pId) {
                Swal.fire('Error', 'Debe seleccionar un producto.', 'error');
                return;
            }
            if (!porc || porc <= 0 || porc > 100) {
                Swal.fire('Error', 'Porcentaje de descuento debe estar entre 1 y 100.', 'error');
                return;
            }
            if (!desde || !hasta) {
                Swal.fire('Error', 'Debe definir el rango de vigencia.', 'error');
                return;
            }

            Swal.fire({
                title: 'Guardando...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '/Descuentos/UpdateProductDiscount',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ProductoId: parseInt(pId),
                    Descuento: parseFloat(porc),
                    Desde: desde,
                    Hasta: hasta
                }),
                success: function(res) {
                    if (res.success) {
                        Swal.fire('¡Éxito!', res.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                },
                error: function(err) {
                    Swal.fire('Error', 'Ocurrió un error al procesar el servidor.', 'error');
                }
            });
        }

        function deleteClasico(pId) {
            Swal.fire({
                title: '¿Eliminar Descuento?',
                text: "El producto ya no tendrá este descuento en el POS.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Descuentos/UpdateProductDiscount',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            ProductoId: pId,
                            Descuento: null,
                            Desde: null,
                            Hasta: null
                        }),
                        success: function(res) {
                            if (res.success) {
                                Swal.fire('Eliminado', 'Descuento eliminado correctamente.', 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', res.message, 'error');
                            }
                        }
                    });
                }
            });
        }

        // ==================== ACCIONES TAB 2: LÍNEAS ====================
        function openNewLineaModal() {
            $('#lineaModalTitle').text('Crear Descuento por Categoría/Línea');
            $('#lineaId').val('');
            $('#lineaDescripcion').val('');
            $('#lineaPorcentaje').val('');
            $('#lineaVenceDesde').val(getTodayString());
            $('#lineaVenceHasta').val(getNextYearString());
            $('#lineaEstado').prop('checked', true);
            $('#lineaProductos').val(null).trigger('change');

            var modal = new bootstrap.Modal(document.getElementById('lineaModal'));
            modal.show();
        }

        function editLinea(id, descripcion, porcentaje, desde, hasta, estado, prodIds) {
            $('#lineaModalTitle').text('Editar Descuento de Línea');
            $('#lineaId').val(id);
            $('#lineaDescripcion').val(descripcion);
            $('#lineaPorcentaje').val(porcentaje);
            $('#lineaVenceDesde').val(desde.substring(0, 10));
            $('#lineaVenceHasta').val(hasta.substring(0, 10));
            $('#lineaEstado').prop('checked', estado);

            // Cargar productos en Select2 de forma asíncrona
            var select = $('#lineaProductos');
            select.val(null).trigger('change');

            var prodNombre = @Json.Serialize(productosDict);
            prodIds.forEach(function(pId) {
                var text = prodNombre[pId] || "Producto #" + pId;
                var option = new Option(text, pId, true, true);
                select.append(option).trigger('change');
            });

            var modal = new bootstrap.Modal(document.getElementById('lineaModal'));
            modal.show();
        }

        function saveLinea() {
            var id = $('#lineaId').val();
            var desc = $('#lineaDescripcion').val();
            var porc = $('#lineaPorcentaje').val();
            var desde = $('#lineaVenceDesde').val();
            var hasta = $('#lineaVenceHasta').val();
            var estado = $('#lineaEstado').is(':checked');
            var prodIds = $('#lineaProductos').val();

            if (!desc) {
                Swal.fire('Error', 'La descripción es obligatoria.', 'error');
                return;
            }
            if (!porc || porc <= 0 || porc > 100) {
                Swal.fire('Error', 'Porcentaje de descuento debe estar entre 1 y 100.', 'error');
                return;
            }
            if (!desde || !hasta) {
                Swal.fire('Error', 'Debe definir el rango de vigencia.', 'error');
                return;
            }

            Swal.fire({
                title: 'Guardando...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '/Descuentos/SaveLineDiscount',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    Id: id ? parseInt(id) : 0,
                    Descripcion: desc,
                    Porcentaje: parseFloat(porc),
                    VenceDesde: desde,
                    VenceHasta: hasta,
                    Estado: estado,
                    ProductIds: prodIds ? prodIds.map(Number) : []
                }),
                success: function(res) {
                    if (res.success) {
                        Swal.fire('¡Éxito!', res.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                }
            });
        }

        function deleteLinea(id) {
            Swal.fire({
                title: '¿Eliminar Promoción?',
                text: "Esta acción borrará la línea de descuento y sus asignaciones.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Descuentos/DeleteLineDiscount?id=' + id,
                        type: 'POST',
                        success: function(res) {
                            if (res.success) {
                                Swal.fire('Eliminado', res.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', res.message, 'error');
                            }
                        }
                    });
                }
            });
        }

        function verProductosDeLinea(titulo, nombres) {
            var html = '<ul class="list-group text-start shadow-sm rounded-3 overflow-hidden">';
            if (!nombres || nombres.length === 0) {
                html += '<li class="list-group-item text-center text-muted py-3">No hay productos vinculados.</li>';
            } else {
                nombres.forEach(function(nom) {
                    html += '<li class="list-group-item py-2.5 px-3 border-light-subtle"><i class="bi bi-dot text-primary fs-4 me-1"></i> ' + nom + '</li>';
                });
            }
            html += '</ul>';

            Swal.fire({
                title: titulo,
                html: html,
                confirmButtonText: 'Cerrar',
                customClass: {
                    popup: 'rounded-4'
                }
            });
        }

        // ==================== ACCIONES TAB 3: COMBOS ====================
        function openNewComboModal() {
            $('#comboModalTitle').text('Crear Combo Promocional');
            $('#comboId').val('');
            $('#comboDescripcion').val('');
            $('#comboPrecio').val('');
            $('#comboCantMin').val(1);
            $('#comboCantMax').val(999);
            $('#comboVenceDesde').val(getTodayString());
            $('#comboVenceHasta').val(getNextYearString());
            $('#comboEstado').prop('checked', true);
            $('#comboProductos').val(null).trigger('change');

            var modal = new bootstrap.Modal(document.getElementById('comboModal'));
            modal.show();
        }

        function editCombo(id, descripcion, precio, cantMin, cantMax, desde, hasta, estado, prodIds) {
            $('#comboModalTitle').text('Editar Combo Promocional');
            $('#comboId').val(id);
            $('#comboDescripcion').val(descripcion);
            $('#comboPrecio').val(precio);
            $('#comboCantMin').val(cantMin);
            $('#comboCantMax').val(cantMax);
            $('#comboVenceDesde').val(desde.substring(0, 10));
            $('#comboVenceHasta').val(hasta.substring(0, 10));
            $('#comboEstado').prop('checked', estado);

            var select = $('#comboProductos');
            select.val(null).trigger('change');

            var prodNombre = @Json.Serialize(productosDict);
            prodIds.forEach(function(pId) {
                var text = prodNombre[pId] || "Producto #" + pId;
                var option = new Option(text, pId, true, true);
                select.append(option).trigger('change');
            });

            var modal = new bootstrap.Modal(document.getElementById('comboModal'));
            modal.show();
        }

        function saveCombo() {
            var id = $('#comboId').val();
            var desc = $('#comboDescripcion').val();
            var precio = $('#comboPrecio').val();
            var min = $('#comboCantMin').val();
            var max = $('#comboCantMax').val();
            var desde = $('#comboVenceDesde').val();
            var hasta = $('#comboVenceHasta').val();
            var estado = $('#comboEstado').is(':checked');
            var prodIds = $('#comboProductos').val();

            if (!desc) {
                Swal.fire('Error', 'La descripción es obligatoria.', 'error');
                return;
            }
            if (!precio || precio <= 0) {
                Swal.fire('Error', 'Debe definir un precio de combo válido.', 'error');
                return;
            }
            if (!desde || !hasta) {
                Swal.fire('Error', 'Debe definir el rango de vigencia.', 'error');
                return;
            }
            if (!prodIds || prodIds.length === 0) {
                Swal.fire('Error', 'Un combo debe contener al menos un producto.', 'error');
                return;
            }

            Swal.fire({
                title: 'Guardando...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '/Descuentos/SaveCombo',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    Id: id ? parseInt(id) : 0,
                    Descripcion: desc,
                    PrecioCombo: parseFloat(precio),
                    CantMin: parseInt(min),
                    CantMax: parseInt(max),
                    VenceDesde: desde,
                    VenceHasta: hasta,
                    Estado: estado,
                    ProductIds: prodIds.map(Number)
                }),
                success: function(res) {
                    if (res.success) {
                        Swal.fire('¡Éxito!', res.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                }
            });
        }

        function deleteCombo(id) {
            Swal.fire({
                title: '¿Eliminar Combo?',
                text: "Esta acción borrará el combo y sus detalles de la base de datos.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
