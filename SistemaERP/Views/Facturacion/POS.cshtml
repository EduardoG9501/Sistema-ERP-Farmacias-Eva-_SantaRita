                denyButtonText: '<i class="bi bi-tag-fill me-1"></i> Unidad / Fracci\u00F3n',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#991b1b', // Burgundy for Box
                denyButtonColor: '#10b981',    // Green for Unit
                cancelButtonColor: '#6c757d',
                allowOutsideClick: false,
                focusCancel: false,
                didOpen: () => {
                    setTimeout(() => {
                        document.getElementById('swalAddQty').focus();
                        document.getElementById('swalAddQty').select();
                    }, 150);
                    
                    // Actualizaci\u00F3n din\u00E1mica del stock al cambiar bodega en el modal
                    $('#swalAddBodega').on('change', function() {
                        let selectedBodId = parseInt($(this).val());
                        let stockRecord = p.stocks.find(s => s.bodegaId === selectedBodId);
                        let newStock = stockRecord ? stockRecord.stock : 0;
                        let newStockText = contiene > 1 ? formatCantidad(newStock, contiene, false) : `${newStock} uds`;
                        document.getElementById('lblModalAddStockVal').innerText = newStockText;
                    });
                }
            }).then((result) => {
                if (result.isConfirmed || result.isDenied) {
                    let qty = parseInt(document.getElementById('swalAddQty').value) || 1;
                    let selectedBodegaId = parseInt(document.getElementById('swalAddBodega').value) || defaultBodegaId;
                    let selectedBodega = bodegasList.find(b => b.id === selectedBodegaId) || defaultBodega;
                    let selectedBodegaName = selectedBodega ? selectedBodega.nombre : 'Principal';
                    
                    let isCaja = result.isConfirmed; // Confirmed = Caja, Denied = Unidad
                    
                    addToCart(p.id, p.nombre, p.pvp, p.pvf, contiene, p.iva, qty, isCaja, selectedBodegaId, selectedBodegaName, p.descuento, p.descuentoDesde, p.descuentoHasta, p.idProveedor);
                }
                
                // Re-focus the appropriate search input
                setTimeout(() => {
                    if (isModalOpen) {
                        $("#txtModalSearch").focus().select();
                    } else {
                        $('#txtSearchHeader').focus().select();
                    }
                }, 100);
            });
        }

        function selectProductFromModal(id, selectedBodegaId, selectedUnitType) {
            let p = productosList.find(x => x.id === id);
            if (!p) return;
            
            // Mantener el buscador abierto para agilizar ventas masivas de corrido.
            setTimeout(() => {
                $("#txtModalSearch").focus().select();
            }, 80);
            
            // Resolver bodega: usar la seleccionada o la principal por defecto
            let chosenBodId = parseInt(selectedBodegaId) || defaultBodegaId;
            let contiene = p.contiene || 1;
            
            if (contiene > 1) {
                // Si el producto posee cantidades fraccionarias, abrir pantalla emergente de seleccion
                promptFractionalProduct(p, chosenBodId);
            } else {
                let chosenBod = bodegasList.find(b => b.id === chosenBodId) || defaultBodega;
                let chosenBodNom = chosenBod ? chosenBod.nombre : 'Principal';
                let isCaja = selectedUnitType === 'C';
                
                // Agregar al carrito instant\u00E1neamente con cantidad 1
                addToCart(p.id, p.nombre, p.pvp, p.pvf, contiene, p.iva, 1, isCaja, chosenBodId, chosenBodNom, p.descuento, p.descuentoDesde, p.descuentoHasta, p.idProveedor);
            }
        }

        function showProductDetails(id) {
            // Mostrar Swal cargando
            Swal.fire({
                title: 'Cargando especificaciones...',
                html: '<div class="spinner-border text-indigo m-3"></div>',
                showConfirmButton: false,
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '@Url.Action("GetProductDetails", "Facturacion")?id=' + id,
                type: 'GET',
                success: function(res) {
                    Swal.close();
                    if (res.success && res.data) {
                        let d = res.data;
                        
                        // Cargar info est\u00E1ndar
                        $('#lblDetailProductName').text(d.nombre);
                        $('#lblDetailProductBarcode').text(d.codigoBarra);
                        $('#lblDetailProductPresentation').text(d.presentacion + (d.contiene > 1 ? ` (${d.contiene} uds)` : ''));
                        $('#lblDetailProductProvider').text(d.proveedor);
                        $('#lblDetailProductPvp').text(MONEDA_SIMBOLO + parseFloat(d.pvp).toFixed(2));
                        $('#lblDetailProductSanitary').text(d.registroSanitario);
                        
                        // Cargar especificaciones din\u00E1micas
                        let specsContainer = $('#lblProductSpecs');
                        specsContainer.empty();
                        
                        if (d.especificaciones && d.especificaciones.length > 0) {
                            d.especificaciones.forEach(s => {
                                // Detectar si el valor parece un n\u00FAmero o c\u00F3digo especial para darle estilo de badge
                                let valHtml = "";
                                if (s.valor === "S\u00ED") {
                                    valHtml = `<span class="badge bg-success-soft text-success px-2 py-1" style="font-size:0.78rem">S\u00ED</span>`;
                                } else if (s.valor === "No") {
                                    valHtml = `<span class="badge bg-danger-soft text-danger px-2 py-1" style="font-size:0.78rem">No</span>`;
                                } else if (!isNaN(s.valor) && parseFloat(s.valor) > 0) {
                                    valHtml = `<span class="spec-value-badge">${s.valor}</span>`;
                                } else {
                                    valHtml = `<span class="spec-value">${s.valor}</span>`;
                                }
                                
                                specsContainer.append(`
                                    <div class="spec-item">
                                        <span class="spec-label">${s.etiqueta}:</span>
                                        ${valHtml}
                                    </div>
                                `);
                            });
                        } else {
                            specsContainer.append(`
                                <div class="text-center py-3 text-muted" style="font-size: 0.85rem;">
                                    <i class="bi bi-info-circle me-1"></i>No hay especificaciones t\u00E9cnicas adicionales registradas.
                                </div>
                            `);
                        }
                        
                        // Cargar productos similares
                        let similarContainer = $('#tab-similar');
                        similarContainer.empty();
                        
                        if (d.similares && d.similares.length > 0) {
                            let tableHtml = `
                                <div class="table-responsive mt-3" style="max-height: 250px; overflow-y: auto;">
                                    <table class="table table-hover align-middle mb-0" style="font-size: 0.8rem; width: 100%;">
                                        <thead>
                                            <tr class="table-light text-secondary fw-bold" style="font-size: 0.72rem;">
                                                <th class="py-2 px-3">C\u00F3digo</th>
                                                <th class="py-2 px-3">Producto</th>
                                                <th class="py-2 px-3 text-end">PVP</th>
                                                <th class="py-2 px-3 text-center">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                            `;
                            
                            d.similares.forEach(p => {
                                tableHtml += `
                                    <tr class="border-bottom border-light">
                                        <td class="py-2 px-3 font-monospace text-secondary">${p.codigoBarra || '-'}</td>
                                        <td class="py-2 px-3 fw-semibold text-dark">${p.nombre}</td>
                                        <td class="py-2 px-3 text-end fw-bold text-success">${MONEDA_SIMBOLO}${parseFloat(p.pvp).toFixed(2)}</td>
                                        <td class="py-2 px-3 text-center">
                                            <button type="button" class="btn btn-primary btn-sm py-1 px-2 me-1" onclick="addProductFromGridCard(${p.id}); hideBootstrapModal('modalDetalleProducto');" title="Agregar al carrito">
                                                <i class="bi bi-cart-plus"></i> Agregar
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-2" onclick="showProductDetails(${p.id})" title="Ver detalles">
                                                <i class="bi bi-info-circle"></i> Ver
                                            </button>
                                        </td>
                                    </tr>
                                `;
                            });
                            
                            tableHtml += `
                                        </tbody>
                                    </table>
                                </div>
                            `;
                            similarContainer.append(tableHtml);
                        } else {
                            similarContainer.append(`
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-tags text-light-indigo display-4 mb-3 d-block" style="opacity: 0.4;"></i>
                                    <h6 class="fw-bold text-dark">No hay productos similares</h6>
