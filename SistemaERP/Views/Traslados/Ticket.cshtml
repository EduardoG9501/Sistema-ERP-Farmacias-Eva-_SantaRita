@model SistemaERP.Models.Entities.Traslado

@{
    Layout = null;
    var bOrigen = ViewBag.BodegaOrigen as SistemaERP.Models.Entities.Bodega;
    var bDestino = ViewBag.BodegaDestino as SistemaERP.Models.Entities.Bodega;
    var userEnvio = ViewBag.UsuarioEnvio as string;
    var userRecepcion = ViewBag.UsuarioRecepcion as string;
    var detalles = ViewBag.Detalles as List<SistemaERP.Models.Entities.Traslado_Producto>;
    var p = ViewBag.Parametros as SistemaERP.Models.Entities.ParametrosSistema;
    string anchoMm = (p?.TicketAncho ?? 80) + "mm";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Ticket Traslado #@Model.Id</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Courier New', Courier, monospace;
            width: @anchoMm;
            margin: 0 auto;
            padding: 4mm 3mm;
            font-size: 11px;
            color: #111;
        }
        .center { text-align: center; }
        .right { text-align: right; }
        .left { text-align: left; }
        .bold { font-weight: bold; }
        .line-dash { border: none; border-top: 1px dashed #000; margin: 5px 0; }
        .line-solid { border: none; border-top: 1px solid #000; margin: 5px 0; }
        .logo-img { max-width: 100%; max-height: 30mm; object-fit: contain; }
        table { width: 100%; border-collapse: collapse; }
        table th, table td { vertical-align: top; padding: 1px 2px; }
        .empresa-nombre { font-size: 14px; font-weight: bold; letter-spacing: 0.5px; }
        .info-linea { font-size: 10px; color: #333; }
        .footer-text { font-size: 9px; color: #555; margin-top: 4px; }
        @@media print {
            .no-print { display: none !important; }
            body { width: @anchoMm; }
        }
    </style>
</head>
<body onload="window.print()">
    <!-- Toolbar (hidden on print) -->
    <div class="no-print" style="margin-bottom: 12px; padding: 6px; background: #f5f5f5; border-radius: 6px;">
        <button onclick="window.print()" style="margin-right: 8px; padding: 4px 12px; cursor: pointer;">🖨 Imprimir</button>
        <button onclick="window.close()" style="padding: 4px 12px; cursor: pointer;">✕ Cerrar</button>
    </div>

    <!-- ===== ENCABEZADO ===== -->
    <div class="center">
        @if (p?.TicketMostrarLogo == true && !string.IsNullOrEmpty(p?.LogoPath))
        {
            <img src="@(p.LogoPath.Split('?')[0])" alt="Logo" class="logo-img" style="margin-bottom: 4px;" />
            <br />
        }

        <div class="empresa-nombre">@(p?.NombreEmpresa ?? "EMPRESA")</div>
        <div class="info-linea">TICKET DE TRASLADO DE INVENTARIO</div>
    </div>

    <hr class="line-solid" />

    <!-- ===== DATOS TRANSACCIÓN ===== -->
    <div>
        <div><span class="bold">ORDEN TRASLADO: </span>#@Model.Id</div>
        <div><span class="bold">FECHA ENVIO: </span>@Model.Fecha_Envio.ToString("dd/MM/yyyy HH:mm")</div>
        <div><span class="bold">BODEGA ORIGEN: </span>@(bOrigen?.Nombre ?? "N/A")</div>
        <div><span class="bold">BODEGA DESTINO: </span>@(bDestino?.Nombre ?? "N/A")</div>
        <div><span class="bold">ENVIO POR: </span>@userEnvio</div>
        <div><span class="bold">ESTADO: </span>@Model.Estado</div>
        @if (Model.Fecha_Recepcion.HasValue)
        {
            <div><span class="bold">FECHA RECIBIDO: </span>@Model.Fecha_Recepcion.Value.ToString("dd/MM/yyyy HH:mm")</div>
            <div><span class="bold">RECIBIDO POR: </span>@userRecepcion</div>
        }
    </div>

    <hr class="line-dash" />

    <!-- ===== DETALLE PRODUCTOS ===== -->
    <table>
        <thead>
            <tr>
                <th class="left" style="width:15%">CANT</th>
                <th class="left" style="width:15%">UNID</th>
                <th class="left" style="width:70%">PRODUCTO</th>
            </tr>
        </thead>
        <tbody>
            @if (detalles != null)
            {
                @foreach (var item in detalles)
                {
                    <tr>
                        <td class="left">@item.Cantidad</td>
                        <td class="left">@(item.EsCaja ? "Caja" : "Unidad")</td>
                        <td class="left">@item.Producto</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    @if (!string.IsNullOrEmpty(Model.Observacion))
    {
        <hr class="line-dash" />
        <div>
            <span class="bold">OBSERVACIÓN:</span> @Model.Observacion
        </div>
    }

    <hr class="line-dash" />
    <div class="center footer-text" style="margin-top: 6px; margin-bottom: 10px;">
        Traslado de Mercadería
    </div>
</body>
</html>
